<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>com.saa</groupId>
  <artifactId>saa-backend</artifactId>
  <version>1.1.0</version>
  <packaging>war</packaging>

  <name>saa-backend</name>
  <url>http://saa.com</url>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Versiones -->
    <jakartaee.version>10.0.0</jakartaee.version>
    <resteasy.multipart.version>6.2.9.Final</resteasy.multipart.version>

    <!-- Jasper 7.x (tu jrxml dice Studio 7.0.3) -->
    <jasper.version>7.0.3</jasper.version>

    <!-- Plugins -->
    <maven.compiler.plugin.version>3.11.0</maven.compiler.plugin.version>
    <maven.war.plugin.version>3.3.2</maven.war.plugin.version>
    <maven.resources.plugin.version>3.3.0</maven.resources.plugin.version>
    <maven.enforcer.plugin.version>3.2.1</maven.enforcer.plugin.version>

    <wildfly.maven.plugin.version>2.1.0.Final</wildfly.maven.plugin.version>
  </properties>

  <!-- Repositorio local (carpeta del proyecto) para el shim w3c-dom-css-shim,
       ver comentario junto a esa dependencia más abajo. -->
  <repositories>
    <repository>
      <id>libs-repo</id>
      <url>file://${project.basedir}/libs-repo</url>
    </repository>
  </repositories>

  <dependencies>

    <!-- Jakarta EE (lo provee WildFly) -->
    <dependency>
      <groupId>jakarta.platform</groupId>
      <artifactId>jakarta.jakartaee-api</artifactId>
      <version>${jakartaee.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Multipart (si realmente lo usas). En WildFly suele ir provided -->
    <dependency>
      <groupId>org.jboss.resteasy</groupId>
      <artifactId>resteasy-multipart-provider</artifactId>
      <version>${resteasy.multipart.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- JasperReports Engine -->
    <dependency>
      <groupId>net.sf.jasperreports</groupId>
      <artifactId>jasperreports</artifactId>
      <version>${jasper.version}</version>
      <!-- OJO: NO excluyo Jackson aquí a ciegas.
           Primero dejemos que funcione; si el equipo exige JSON-B puro,
           luego hacemos exclusiones dirigidas. -->
    </dependency>

    <!-- JasperReports Extensions para exportar a diferentes formatos -->
    <dependency>
      <groupId>net.sf.jasperreports</groupId>
      <artifactId>jasperreports-pdf</artifactId>
      <version>${jasper.version}</version>
    </dependency>
    
    <dependency>
      <groupId>net.sf.jasperreports</groupId>
      <artifactId>jasperreports-fonts</artifactId>
      <version>${jasper.version}</version>
    </dependency>
    
    <!-- JasperReports Functions (necesario para compilación de expresiones) -->
    <dependency>
      <groupId>net.sf.jasperreports</groupId>
      <artifactId>jasperreports-functions</artifactId>
      <version>${jasper.version}</version>
    </dependency>

    <!-- JasperReports Barcode4J — registra el componente kind="barcode4j:Code128" en JR 7.x -->
    <dependency>
      <groupId>net.sf.jasperreports</groupId>
      <artifactId>jasperreports-barcode4j</artifactId>
      <version>${jasper.version}</version>
      <exclusions>
        <exclusion><groupId>xml-apis</groupId><artifactId>xml-apis</artifactId></exclusion>
      </exclusions>
    </dependency>

    <!-- Barcode4J — motor de renderizado de códigos de barra (Code128, PDF417, etc.) -->
    <dependency>
      <groupId>net.sf.barcode4j</groupId>
      <artifactId>barcode4j</artifactId>
      <version>2.1</version>
      <exclusions>
        <exclusion><groupId>xml-apis</groupId><artifactId>xml-apis</artifactId></exclusion>
      </exclusions>
    </dependency>

    <!-- Shim con org.w3c.dom.css + org.w3c.dom.stylesheets + org.w3c.dom.views —
         subconjunto extraído a mano de xml-apis:xml-apis:1.4.01 (ver POM del
         propio shim en libs-repo/ para el detalle completo del porqué).
         Batik 1.18 (ExtensibleDOMImplementation/SVGDOMImplementation, usados
         por jasperreports-pdf al exportar imágenes vía RendererUtil.isSvgData)
         necesita org.w3c.dom.css.DOMImplementationCSS para enlazar, pero esa
         clase no existe ni en el JDK (Java 9+ removió los paquetes de
         extensión DOM del módulo java.xml) ni en xml-apis-ext:1.3.04. Se
         intentó primero con xml-apis:xml-apis:1.4.01 completo, pero esa
         versión también redefine las clases DOM base (Document, Node,
         Element, DOMException) y eso rompió el classloading de WildFly en
         un punto totalmente ajeno (NoClassDefFoundError: XMLStreamWriter al
         indexar reflectivamente un EJB sin relación con reportes). Este
         shim NO incluye ninguna clase base de org.w3c.dom — solo los tres
         paquetes de extensión de estilo — así que no puede chocar con nada
         más en el classpath. -->
    <dependency>
      <groupId>com.saa.thirdparty</groupId>
      <artifactId>w3c-dom-css-shim</artifactId>
      <version>1.0</version>
    </dependency>

    <!-- Apache XML Graphics Commons — requerido por barcode4j para renderizar en PDF -->
    <dependency>
      <groupId>org.apache.xmlgraphics</groupId>
      <artifactId>xmlgraphics-commons</artifactId>
      <version>2.9</version>
    </dependency>
    
    <!-- Compilador Java para JasperReports (necesario para compilar .jrxml en runtime) -->
    <dependency>
      <groupId>org.eclipse.jdt</groupId>
      <artifactId>ecj</artifactId>
      <version>3.33.0</version>
    </dependency>

    <!-- Janino: compilador alternativo para JasperReports en entornos de servidor (WildFly).
         JRJdtCompiler falla dentro de WildFly por aislamiento de classloaders;
         JRJaninoCompiler funciona sin depender de javac ni del JDT externo. -->
    <dependency>
      <groupId>org.codehaus.janino</groupId>
      <artifactId>janino</artifactId>
      <version>3.1.12</version>
    </dependency>
    <dependency>
      <groupId>org.codehaus.janino</groupId>
      <artifactId>commons-compiler</artifactId>
      <version>3.1.12</version>
    </dependency>

    <!-- Apache POI para exportar a Excel (requerido por JasperReports) -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi</artifactId>
      <version>5.2.3</version>
    </dependency>
    
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>5.2.3</version>
    </dependency>

    <!-- BouncyCastle para firma electrónica XML -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>1.78.1</version>
    </dependency>
    
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <version>1.78.1</version>
    </dependency>
    
    <!-- Apache Santuario para firmas XML (XMLDSig) -->
    <dependency>
      <groupId>org.apache.santuario</groupId>
      <artifactId>xmlsec</artifactId>
      <version>3.0.4</version>
    </dependency>
    
    <!-- Jackson JSR310 para soportar java.time (LocalDate, LocalDateTime) -->
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
      <version>2.17.0</version>
      <scope>provided</scope>
    </dependency>

  </dependencies>

  <build>
    <finalName>SaaBE</finalName>

    <plugins>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <version>${maven.war.plugin.version}</version>
        <configuration>
          <!-- Evita problemas con web.xml si no usas -->
          <failOnMissingWebXml>false</failOnMissingWebXml>

          <!-- Opcional: excluye basura típica -->
          <packagingExcludes>
            **/*.bak,
            **/*.tmp,
            **/*.log,
            **/.DS_Store
          </packagingExcludes>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven.compiler.plugin.version}</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <encoding>${project.build.sourceEncoding}</encoding>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>${maven.resources.plugin.version}</version>
        <configuration>
          <encoding>${project.build.sourceEncoding}</encoding>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven.enforcer.plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-java</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Deploy a WildFly (si lo usas así) -->
      <plugin>
        <groupId>org.wildfly.plugins</groupId>
        <artifactId>wildfly-maven-plugin</artifactId>
        <version>${wildfly.maven.plugin.version}</version>
        <configuration>
          <hostname>saa-wildfly</hostname>
          <port>9990</port>
          <username>gaemi</username>
          <password>nexus</password>
          <filename>${project.build.finalName}.war</filename>
        </configuration>
      </plugin>

    </plugins>
  </build>

</project>
