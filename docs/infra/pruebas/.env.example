# Copiar como .env en la misma carpeta y llenar. El .env NO se sube al repositorio.

# La MISMA imagen que usa producción. Sacarla con:
#   docker inspect oracle-23ai --format '{{.Config.Image}}'
IMAGEN_ORACLE=container-registry.oracle.com/database/free:latest

# Clave nueva para SYS/SYSTEM de la base de pruebas. Solo letras y números.
PRUEBAS_PWD=CambiarEstaClave2026

# Clave de SYSTEM de producción (el ORACLE_PWD del contenedor oracle-23ai).
# Solo se usa en el PRIMER arranque, para copiar los datos. Después de ver
# "CLON DE PRODUCCION TERMINADO" se puede borrar de este archivo.
PROD_SYSTEM_PWD=

# De donde se copia produccion. En 192.168.2.4 se deja vacio (produccion esta en el mismo
# servidor, host.docker.internal). En 192.168.2.3 va la base de produccion del .4:
# PROD_HOST=192.168.2.4
PROD_HOST=
