	<summary height="190" splitType="Stretch">
		<!-- TOTALES DEL ROL -->
		<element kind="staticText" uuid="c1000000-0000-0000-0000-000000000501" mode="Opaque" x="295" y="2" width="130" height="16" backcolor="#F7FAFC" forecolor="#1A202C" fontName="Tahoma" fontSize="7.5" bold="true" vTextAlign="Middle">
			<text><![CDATA[TOTAL INGRESOS]]></text>
			<box leftPadding="4"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="textField" uuid="c1000000-0000-0000-0000-000000000502" x="425" y="2" width="120" height="16" pattern="$#,##0.00" fontName="Tahoma" fontSize="7.5" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA[$F{ROL_INGRESOS}]]></expression>
			<box rightPadding="4"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="staticText" uuid="c1000000-0000-0000-0000-000000000503" mode="Opaque" x="295" y="18" width="130" height="16" backcolor="#F7FAFC" forecolor="#1A202C" fontName="Tahoma" fontSize="7.5" bold="true" vTextAlign="Middle">
			<text><![CDATA[TOTAL DESCUENTOS]]></text>
			<box leftPadding="4"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="textField" uuid="c1000000-0000-0000-0000-000000000504" x="425" y="18" width="120" height="16" pattern="$#,##0.00" fontName="Tahoma" fontSize="7.5" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA[$F{ROL_DESCUENTOS}]]></expression>
			<box rightPadding="4"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="staticText" uuid="c1000000-0000-0000-0000-000000000505" mode="Opaque" x="295" y="34" width="130" height="18" backcolor="#EDF2F7" forecolor="#1A202C" fontName="Tahoma" fontSize="8.5" bold="true" vTextAlign="Middle">
			<text><![CDATA[NETO A RECIBIR]]></text>
			<box leftPadding="4"><pen lineWidth="0.5" lineColor="#4A5568"/></box>
		</element>
		<element kind="textField" uuid="c1000000-0000-0000-0000-000000000506" x="425" y="34" width="120" height="18" pattern="$#,##0.00" fontName="Tahoma" fontSize="8.5" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA[$F{ROL_NETO}]]></expression>
			<box rightPadding="4"><pen lineWidth="0.5" lineColor="#4A5568"/></box>
		</element>
		<!-- CONTROL DE CUADRE: si los renglones no suman los totales grabados, algo cambio tras emitir -->
		<element kind="textField" uuid="c1000000-0000-0000-0000-000000000510" x="0" y="56" width="545" height="12" forecolor="#C05621" fontName="Tahoma" fontSize="6.5" blankWhenNull="true" removeLineWhenBlank="true" vTextAlign="Middle">
			<expression><![CDATA[( Math.abs($V{V_SUMA_INGRESOS}.doubleValue() - $F{ROL_INGRESOS}.doubleValue()) > 0.01
   || Math.abs($V{V_SUMA_DESCUENTOS}.doubleValue() - $F{ROL_DESCUENTOS}.doubleValue()) > 0.01 )
  ? "Aviso: los renglones no suman los totales grabados en el rol. La nomina cambio despues de emitirlo; regenere el rol."
  : null]]></expression>
		</element>
		<!-- COSTO PATRONAL: informativo, no forma parte del neto -->
