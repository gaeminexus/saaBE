		</element>
		<element kind="textField" uuid="c1000000-0000-0000-0000-00000000011c" x="90" y="118" width="270" height="14" fontName="Tahoma" fontSize="7.5" blankWhenNull="true" vTextAlign="Middle">
			<expression><![CDATA[new java.text.SimpleDateFormat("d/M/yyyy").format($F{PERIODO_DESDE}) + "  al  " + new java.text.SimpleDateFormat("d/M/yyyy").format($F{PERIODO_HASTA})]]></expression>
			<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="staticText" uuid="c1000000-0000-0000-0000-00000000011d" mode="Opaque" x="360" y="118" width="80" height="14" backcolor="#F7FAFC" fontName="Tahoma" fontSize="7.5" bold="true" vTextAlign="Middle">
			<text><![CDATA[Emision]]></text>
			<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
