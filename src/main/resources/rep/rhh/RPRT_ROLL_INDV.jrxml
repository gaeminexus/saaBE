		<element kind="staticText" uuid="c1000000-0000-0000-0000-00000000011b" mode="Opaque" x="0" y="118" width="90" height="14" backcolor="#F7FAFC" fontName="Tahoma" fontSize="7.5" bold="true" vTextAlign="Middle">
			<text><![CDATA[Periodo]]></text>
