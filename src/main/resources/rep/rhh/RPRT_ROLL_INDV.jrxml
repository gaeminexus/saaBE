<!-- Rol de pago individual (RHH). Estilo corporativo cnt/crd + logo ASOPREP-FCPC. Ver docs/logica-negocio/reportes/REPORTE-ROL-PAGO-INDIVIDUAL.md -->
<jasperReport name="RPRT_ROLL_INDV" language="java" pageWidth="595" pageHeight="842" columnWidth="545" leftMargin="25" rightMargin="25" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection" uuid="c1000000-0000-0000-0000-000000000000">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Oracle"/>
	<property name="com.jaspersoft.studio.report.description" value="Rol de pago de un empleado en un periodo: ingresos y descuentos en dos columnas, ajustes de valores no pagados, neto de nomina y neto a pagar, con totales y espacio de firma."/>
	<parameter name="P_RLPG_CODIGO" class="java.lang.Long">
		<description><![CDATA[Codigo del rol de pago (RHH.RLPG.RLPGCDGO)]]></description>
	</parameter>
	<parameter name="P_IMAGEN" class="java.awt.Image">
		<description><![CDATA[Logo del fondo. Lo inyecta ReporteServiceImpl si el frontend no lo envia.]]></description>
	</parameter>
	<parameter name="P_USUARIO" class="java.lang.String">
		<description><![CDATA[Usuario que genera el reporte (opcional)]]></description>
	</parameter>
	<query language="SQL"><![CDATA[WITH CAB AS (
    SELECT
        r.RLPGNMRO                                                        AS NUMERO_ROL,
        r.RLPGFCHA                                                        AS FECHA_EMISION,
        NVL(r.RLPGTTIN, 0)                                                AS ROL_INGRESOS,
        NVL(r.RLPGTTDS, 0)                                                AS ROL_DESCUENTOS,
        NVL(r.RLPGNETO, 0)                                                AS ROL_NETO,
        NVL(r.RLPGRCBD, 'N')                                              AS ROL_RECIBIDO,
        e.MPLDIDNT                                                        AS IDENTIFICACION,
        NVL(e.MPLDAPLL, ' ') || ' ' || NVL(e.MPLDNMBR, ' ')               AS EMPLEADO,
        p.PRDNANOO                                                        AS PERIODO_ANIO,
        p.PRDNMSEE                                                        AS PERIODO_MES,
        p.PRDNFCHI                                                        AS PERIODO_DESDE,
        p.PRDNFCHF                                                        AS PERIODO_HASTA,
        NVL(n.NMNASLRB, 0)                                                AS SALARIO_BASE,
        NVL(n.NMNADITR, 0)                                                AS DIAS_TRABAJADOS,
        NVL(n.NMNABSIE, 0)                                                AS BASE_IESS,
        NVL(n.NMNAAPPR, 0)                                                AS APORTE_PERSONAL,
        NVL(n.NMNAAPPT, 0)                                                AS APORTE_PATRONAL,
        NVL(n.NMNAIESC, 0)                                                AS APORTE_IECE_SECAP,
        NVL(n.NMNATTPT, 0)                                                AS TOTAL_PATRONAL,
        n.NMNACDGO                                                        AS ID_NOMINA,
        -- Neto a pagar = neto de nomina + los renglones de valor no pagado (rol de motor
        -- 34 retenido / 35 recuperado), con el signo tal como los graba el motor
        -- (ProcesoNominaServiceImpl.agregaRenglonesValorNoPagado): 34 en RNGLVLRO negativo,
        -- 35 en positivo. Si no hay ningun renglon de esos roles el NVL deja 0 y el neto a
        -- pagar coincide con el de nomina.
        NVL(r.RLPGNETO, 0) + NVL((
            SELECT SUM(ra.RNGLVLRO)
            FROM   RHH.RNGL ra
                   JOIN RHH.CPNM ca ON ca.CPNMCDGO = ra.CPNMCDGO
            WHERE  ra.NMNACDGO = n.NMNACDGO
                   AND ca.CPNMROLM IN (34, 35)
        ), 0)                                                             AS NETO_A_PAGAR
    FROM   RHH.RLPG r
           JOIN RHH.NMNA n ON n.NMNACDGO = r.NMNACDGO
           JOIN RHH.MPLD e ON e.MPLDCDGO = n.MPLDCDGO
           JOIN RHH.PRDN p ON p.PRDNCDGO = n.PRDNCDGO
    WHERE  r.RLPGCDGO = $P{P_RLPG_CODIGO}
),
-- Ingresos y descuentos numerados por separado (ROW_NUMBER) para emparejarlos uno a uno
-- en PARES: es lo que permite mostrar dos columnas lado a lado con UN solo .jasper, sin
-- subreportes.
ING AS (
    SELECT rn.RNGLCDGO                                                    AS RNGLCDGO,
           rn.RNGLVLRO                                                    AS VALOR,
           NVL(cn.CPNMNMBR, NVL(rn.RNGLDSCR, 'Concepto'))                 AS CONCEPTO,
           ROW_NUMBER() OVER (ORDER BY NVL(rn.RNGLORDN, 0), rn.RNGLCDGO)  AS RN
    FROM   RHH.RNGL rn
           LEFT JOIN RHH.CPNM cn ON cn.CPNMCDGO = rn.CPNMCDGO
           JOIN CAB ON rn.NMNACDGO = CAB.ID_NOMINA
    WHERE  NVL(rn.RNGLTPCN, 0) = 1
),
DSC AS (
    SELECT rn.RNGLCDGO                                                    AS RNGLCDGO,
           rn.RNGLVLRO                                                    AS VALOR,
           NVL(cn.CPNMNMBR, NVL(rn.RNGLDSCR, 'Concepto'))                 AS CONCEPTO,
           ROW_NUMBER() OVER (ORDER BY NVL(rn.RNGLORDN, 0), rn.RNGLCDGO)  AS RN
    FROM   RHH.RNGL rn
           LEFT JOIN RHH.CPNM cn ON cn.CPNMCDGO = rn.CPNMCDGO
           JOIN CAB ON rn.NMNACDGO = CAB.ID_NOMINA
    WHERE  NVL(rn.RNGLTPCN, 0) = 2
),
PARES AS (
    SELECT COALESCE(ING.RN, DSC.RN)                                       AS ORDEN_DETALLE,
           ING.CONCEPTO                                                   AS ING_CONCEPTO,
           ING.VALOR                                                      AS ING_VALOR,
           DSC.CONCEPTO                                                   AS DSC_CONCEPTO,
           DSC.VALOR                                                      AS DSC_VALOR
    FROM   ING
           FULL OUTER JOIN DSC ON ING.RN = DSC.RN
)
-- Bloque 1: la grilla de ingresos/descuentos emparejados (SECCION = INGDES).
SELECT
    CAB.NUMERO_ROL          AS NUMERO_ROL,
    CAB.FECHA_EMISION       AS FECHA_EMISION,
    CAB.ROL_INGRESOS        AS ROL_INGRESOS,
    CAB.ROL_DESCUENTOS      AS ROL_DESCUENTOS,
    CAB.ROL_NETO            AS ROL_NETO,
    CAB.ROL_RECIBIDO        AS ROL_RECIBIDO,
    CAB.IDENTIFICACION      AS IDENTIFICACION,
    CAB.EMPLEADO            AS EMPLEADO,
    CAB.PERIODO_ANIO        AS PERIODO_ANIO,
    CAB.PERIODO_MES         AS PERIODO_MES,
    CAB.PERIODO_DESDE       AS PERIODO_DESDE,
    CAB.PERIODO_HASTA       AS PERIODO_HASTA,
    CAB.SALARIO_BASE        AS SALARIO_BASE,
    CAB.DIAS_TRABAJADOS     AS DIAS_TRABAJADOS,
    CAB.BASE_IESS           AS BASE_IESS,
    CAB.APORTE_PERSONAL     AS APORTE_PERSONAL,
    CAB.APORTE_PATRONAL     AS APORTE_PATRONAL,
    CAB.APORTE_IECE_SECAP   AS APORTE_IECE_SECAP,
    CAB.TOTAL_PATRONAL      AS TOTAL_PATRONAL,
    CAB.NETO_A_PAGAR        AS NETO_A_PAGAR,
    'INGDES'                AS SECCION,
    1                       AS ORDEN_SECCION,
    PARES.ORDEN_DETALLE     AS ORDEN_DETALLE,
    PARES.ING_CONCEPTO      AS ING_CONCEPTO,
    PARES.ING_VALOR         AS ING_VALOR,
    PARES.DSC_CONCEPTO      AS DSC_CONCEPTO,
    PARES.DSC_VALOR         AS DSC_VALOR,
    CAST(NULL AS VARCHAR2(200))                                           AS CONCEPTO,
    CAST(NULL AS NUMBER)                                                  AS VALOR,
    NVL(PARES.ING_VALOR, 0)                                               AS VALOR_INGRESO,
    NVL(PARES.DSC_VALOR, 0)                                               AS VALOR_DESCUENTO
FROM   CAB
       CROSS JOIN PARES

UNION ALL

-- Bloque 2: ajustes al pago (SECCION = AJUSTE) -- solo los renglones de rol de motor 34/35
-- (valor no pagado). Estos SI mueven el neto a pagar (ver NETO_A_PAGAR arriba).
SELECT
    CAB.NUMERO_ROL, CAB.FECHA_EMISION, CAB.ROL_INGRESOS, CAB.ROL_DESCUENTOS, CAB.ROL_NETO,
    CAB.ROL_RECIBIDO, CAB.IDENTIFICACION, CAB.EMPLEADO, CAB.PERIODO_ANIO, CAB.PERIODO_MES,
    CAB.PERIODO_DESDE, CAB.PERIODO_HASTA, CAB.SALARIO_BASE, CAB.DIAS_TRABAJADOS, CAB.BASE_IESS,
    CAB.APORTE_PERSONAL, CAB.APORTE_PATRONAL, CAB.APORTE_IECE_SECAP, CAB.TOTAL_PATRONAL,
    CAB.NETO_A_PAGAR,
    'AJUSTE'                                                              AS SECCION,
    2                                                                     AS ORDEN_SECCION,
    cn.CPNMROLM                                                          AS ORDEN_DETALLE,
    CAST(NULL AS VARCHAR2(200))                                           AS ING_CONCEPTO,
    CAST(NULL AS NUMBER)                                                  AS ING_VALOR,
    CAST(NULL AS VARCHAR2(200))                                           AS DSC_CONCEPTO,
    CAST(NULL AS NUMBER)                                                  AS DSC_VALOR,
    NVL(cn.CPNMNMBR, NVL(rn.RNGLDSCR, 'Ajuste'))                          AS CONCEPTO,
    rn.RNGLVLRO                                                          AS VALOR,
    0                                                                     AS VALOR_INGRESO,
    0                                                                     AS VALOR_DESCUENTO
FROM   RHH.RNGL rn
       JOIN RHH.CPNM cn ON cn.CPNMCDGO = rn.CPNMCDGO
       CROSS JOIN CAB
WHERE  rn.NMNACDGO = CAB.ID_NOMINA
       AND cn.CPNMROLM IN (34, 35)

UNION ALL

-- Bloque 3: informativos que NO ajustan el pago (SECCION = INFORMATIVO) -- tipo 5 con
-- cualquier otro rol (32/33 decimos acumulados pagados, o ninguno). Nunca entran al
-- NETO_A_PAGAR: solo se muestran para trazabilidad.
SELECT
    CAB.NUMERO_ROL, CAB.FECHA_EMISION, CAB.ROL_INGRESOS, CAB.ROL_DESCUENTOS, CAB.ROL_NETO,
    CAB.ROL_RECIBIDO, CAB.IDENTIFICACION, CAB.EMPLEADO, CAB.PERIODO_ANIO, CAB.PERIODO_MES,
    CAB.PERIODO_DESDE, CAB.PERIODO_HASTA, CAB.SALARIO_BASE, CAB.DIAS_TRABAJADOS, CAB.BASE_IESS,
    CAB.APORTE_PERSONAL, CAB.APORTE_PATRONAL, CAB.APORTE_IECE_SECAP, CAB.TOTAL_PATRONAL,
    CAB.NETO_A_PAGAR,
    'INFORMATIVO'                                                         AS SECCION,
    3                                                                     AS ORDEN_SECCION,
    NVL(rn.RNGLORDN, 0)                                                   AS ORDEN_DETALLE,
    CAST(NULL AS VARCHAR2(200))                                           AS ING_CONCEPTO,
    CAST(NULL AS NUMBER)                                                  AS ING_VALOR,
    CAST(NULL AS VARCHAR2(200))                                           AS DSC_CONCEPTO,
    CAST(NULL AS NUMBER)                                                  AS DSC_VALOR,
    NVL(cn.CPNMNMBR, NVL(rn.RNGLDSCR, 'Informativo'))                     AS CONCEPTO,
    rn.RNGLVLRO                                                          AS VALOR,
    0                                                                     AS VALOR_INGRESO,
    0                                                                     AS VALOR_DESCUENTO
FROM   RHH.RNGL rn
       LEFT JOIN RHH.CPNM cn ON cn.CPNMCDGO = rn.CPNMCDGO
       CROSS JOIN CAB
WHERE  rn.NMNACDGO = CAB.ID_NOMINA
       AND NVL(rn.RNGLTPCN, 0) = 5
       AND (cn.CPNMROLM IS NULL OR cn.CPNMROLM NOT IN (34, 35))

ORDER BY ORDEN_SECCION, ORDEN_DETALLE]]></query>
	<field name="NUMERO_ROL" class="java.lang.String"/>
	<field name="FECHA_EMISION" class="java.sql.Timestamp"/>
	<field name="ROL_INGRESOS" class="java.math.BigDecimal"/>
	<field name="ROL_DESCUENTOS" class="java.math.BigDecimal"/>
	<field name="ROL_NETO" class="java.math.BigDecimal"/>
	<field name="ROL_RECIBIDO" class="java.lang.String"/>
	<field name="IDENTIFICACION" class="java.lang.String"/>
	<field name="EMPLEADO" class="java.lang.String"/>
	<field name="PERIODO_ANIO" class="java.math.BigDecimal"/>
	<field name="PERIODO_MES" class="java.math.BigDecimal"/>
	<field name="PERIODO_DESDE" class="java.sql.Timestamp"/>
	<field name="PERIODO_HASTA" class="java.sql.Timestamp"/>
	<field name="SALARIO_BASE" class="java.math.BigDecimal"/>
