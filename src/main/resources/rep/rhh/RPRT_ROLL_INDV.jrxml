		<element kind="staticText" uuid="c1000000-0000-0000-0000-000000000110" mode="Opaque" x="0" y="76" width="545" height="14" backcolor="#EDF2F7" forecolor="#4A5568" fontName="Tahoma" fontSize="8.0" bold="true" vTextAlign="Middle">
