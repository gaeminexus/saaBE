	</group>
	<background splitType="Stretch"/>
	<title height="150" splitType="Stretch">
		<element kind="image" uuid="c1000000-0000-0000-0000-000000000101" x="0" y="4" width="110" height="52" scaleImage="RetainShape" onErrorType="Blank" hImageAlign="Center" vImageAlign="Middle">
			<expression><![CDATA[$P{P_IMAGEN}]]></expression>
		</element>
		<element kind="rectangle" uuid="c1000000-0000-0000-0000-000000000102" x="118" y="4" width="427" height="52">
			<pen lineWidth="0.75" lineColor="#CBD5E0"/>
		</element>
		<element kind="staticText" uuid="c1000000-0000-0000-0000-000000000103" x="128" y="10" width="407" height="24" forecolor="#1A202C" fontName="Tahoma" fontSize="15.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
			<text><![CDATA[ROL DE PAGO]]></text>
		</element>
		<element kind="textField" uuid="c1000000-0000-0000-0000-000000000104" x="128" y="34" width="407" height="16" forecolor="#718096" fontName="Tahoma" fontSize="9.0" hTextAlign="Center" vTextAlign="Middle">
			<expression><![CDATA["Periodo " + ($F{PERIODO_MES} != null ? $F{PERIODO_MES}.toBigInteger().toString() : "?") + "/" + ($F{PERIODO_ANIO} != null ? $F{PERIODO_ANIO}.toBigInteger().toString() : "?") + "   ·   Rol " + ($F{NUMERO_ROL} != null ? $F{NUMERO_ROL} : "")]]></expression>
		</element>
