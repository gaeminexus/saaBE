	<field name="TOTAL_PATRONAL" class="java.math.BigDecimal"/>
	<field name="NETO_A_PAGAR" class="java.math.BigDecimal"/>
	<field name="SECCION" class="java.lang.String"/>
	<field name="ORDEN_SECCION" class="java.math.BigDecimal"/>
	<field name="ORDEN_DETALLE" class="java.math.BigDecimal"/>
	<field name="ING_CONCEPTO" class="java.lang.String"/>
	<field name="ING_VALOR" class="java.math.BigDecimal"/>
	<field name="DSC_CONCEPTO" class="java.lang.String"/>
	<field name="DSC_VALOR" class="java.math.BigDecimal"/>
	<field name="CONCEPTO" class="java.lang.String"/>
	<field name="VALOR" class="java.math.BigDecimal"/>
	<field name="VALOR_INGRESO" class="java.math.BigDecimal"/>
	<field name="VALOR_DESCUENTO" class="java.math.BigDecimal"/>
	<variable name="V_SUMA_INGRESOS" class="java.math.BigDecimal" calculation="Sum" resetType="Report">
		<expression><![CDATA[$F{VALOR_INGRESO}]]></expression>
	</variable>
	<variable name="V_SUMA_DESCUENTOS" class="java.math.BigDecimal" calculation="Sum" resetType="Report">
		<expression><![CDATA[$F{VALOR_DESCUENTO}]]></expression>
	</variable>
	<group name="G_SECCION">
		<expression><![CDATA[$F{SECCION}]]></expression>
		<groupHeader>
			<band height="18" splitType="Prevent">
				<element kind="staticText" uuid="c1000000-0000-0000-0000-000000000801" mode="Opaque" x="0" y="2" width="265" height="14" backcolor="#EDF2F7" forecolor="#4A5568" fontName="Tahoma" fontSize="7.0" bold="true" vTextAlign="Middle">
					<printWhenExpression><![CDATA[$F{SECCION}.equals("INGDES")]]></printWhenExpression>
					<text><![CDATA[INGRESOS]]></text>
					<box leftPadding="4"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
