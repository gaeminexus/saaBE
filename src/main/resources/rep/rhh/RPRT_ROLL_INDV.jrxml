			<expression><![CDATA["Periodo " + ($F{PERIODO_MES} != null ? $F{PERIODO_MES}.toBigInteger().toString() : "?") + "/" + ($F{PERIODO_ANIO} != null ? $F{PERIODO_ANIO}.toBigInteger().toString() : "?") + "   ·   Rol " + ($F{NUMERO_ROL} != null ? $F{NUMERO_ROL} : "")]]></expression>
