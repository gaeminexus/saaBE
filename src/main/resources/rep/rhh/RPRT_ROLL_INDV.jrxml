				<element kind="staticText" uuid="c1000000-0000-0000-0000-000000000802" mode="Opaque" x="278" y="2" width="267" height="14" backcolor="#EDF2F7" forecolor="#4A5568" fontName="Tahoma" fontSize="7.0" bold="true" vTextAlign="Middle">
					<printWhenExpression><![CDATA[$F{SECCION}.equals("INGDES")]]></printWhenExpression>
					<text><![CDATA[DESCUENTOS]]></text>
					<box leftPadding="4"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
