<!-- Rol de pagos consolidado del periodo (RHH). Estilo corporativo cnt/crd + logo ASOPREP-FCPC. Ver docs/logica-negocio/reportes/REPORTE-ROL-PAGO-CONSOLIDADO.md -->
<jasperReport name="RPRT_ROLL_CNSL" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="792" leftMargin="25" rightMargin="25" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection" uuid="c2000000-0000-0000-0000-000000000000">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Oracle"/>
	<property name="com.jaspersoft.studio.report.description" value="Rol consolidado de un periodo: una fila por empleado con ingresos, descuentos, neto y costo patronal."/>
	<parameter name="P_PRDN_CODIGO" class="java.lang.Long">
		<description><![CDATA[Codigo del periodo de nomina (RHH.PRDN.PRDNCDGO)]]></description>
	</parameter>
	<parameter name="P_IMAGEN" class="java.awt.Image">
		<description><![CDATA[Logo del fondo. Lo inyecta ReporteServiceImpl si el frontend no lo envia.]]></description>
	</parameter>
	<parameter name="P_USUARIO" class="java.lang.String">
		<description><![CDATA[Usuario que genera el reporte (opcional)]]></description>
	</parameter>
	<query language="SQL"><![CDATA[SELECT
    p.PRDNANOO                                                        AS PERIODO_ANIO,
    p.PRDNMSEE                                                        AS PERIODO_MES,
    p.PRDNFCHI                                                        AS PERIODO_DESDE,
    p.PRDNFCHF                                                        AS PERIODO_HASTA,
    NVL(p.PRDNNMEM, 0)                                                AS PERIODO_EMPLEADOS,
    e.MPLDIDNT                                                        AS IDENTIFICACION,
    NVL(e.MPLDAPLL, ' ') || ' ' || NVL(e.MPLDNMBR, ' ')               AS EMPLEADO,
    NVL(n.NMNASLRB, 0)                                                AS SALARIO_BASE,
    NVL(n.NMNADITR, 0)                                                AS DIAS_TRABAJADOS,
    NVL(n.NMNABSIE, 0)                                                AS BASE_IESS,
    NVL(n.NMNAFNRS, 0)                                                AS FONDOS_RESERVA,
    NVL(n.NMNAAPPR, 0)                                                AS APORTE_PERSONAL,
    NVL(n.NMNARTIR, 0)                                                AS RETENCION_IR,
    NVL(n.NMNATING, 0)                                                AS TOTAL_INGRESOS,
    NVL(n.NMNATDSC, 0)                                                AS TOTAL_DESCUENTOS,
    NVL(n.NMNANETO, 0)                                                AS NETO,
    NVL(n.NMNAAPPT, 0)                                                AS APORTE_PATRONAL,
    NVL(n.NMNAIESC, 0)                                                AS APORTE_IECE_SECAP,
    NVL(n.NMNATTPT, 0)                                                AS TOTAL_PATRONAL,
    -- Costo total del empleador por este empleado: lo que recibe mas lo que aporta la empresa
    NVL(n.NMNATING, 0) + NVL(n.NMNATTPT, 0)                           AS COSTO_EMPLEADOR,
    NVL(r.RLPGNMRO, '(sin rol emitido)')                              AS NUMERO_ROL
FROM RHH.PRDN p
     JOIN RHH.NMNA n ON n.PRDNCDGO = p.PRDNCDGO
     JOIN RHH.MPLD e ON e.MPLDCDGO = n.MPLDCDGO
     LEFT JOIN RHH.RLPG r ON r.NMNACDGO = n.NMNACDGO
WHERE p.PRDNCDGO = $P{P_PRDN_CODIGO}
ORDER BY e.MPLDAPLL, e.MPLDNMBR, n.NMNACDGO]]></query>
	<field name="PERIODO_ANIO" class="java.math.BigDecimal"/>
	<field name="PERIODO_MES" class="java.math.BigDecimal"/>
	<field name="PERIODO_DESDE" class="java.sql.Timestamp"/>
	<field name="PERIODO_HASTA" class="java.sql.Timestamp"/>
	<field name="PERIODO_EMPLEADOS" class="java.math.BigDecimal"/>
	<field name="IDENTIFICACION" class="java.lang.String"/>
	<field name="EMPLEADO" class="java.lang.String"/>
	<field name="SALARIO_BASE" class="java.math.BigDecimal"/>
	<field name="DIAS_TRABAJADOS" class="java.math.BigDecimal"/>
	<field name="BASE_IESS" class="java.math.BigDecimal"/>
	<field name="FONDOS_RESERVA" class="java.math.BigDecimal"/>
	<field name="APORTE_PERSONAL" class="java.math.BigDecimal"/>
	<field name="RETENCION_IR" class="java.math.BigDecimal"/>
	<field name="TOTAL_INGRESOS" class="java.math.BigDecimal"/>
	<field name="TOTAL_DESCUENTOS" class="java.math.BigDecimal"/>
	<field name="NETO" class="java.math.BigDecimal"/>
	<field name="APORTE_PATRONAL" class="java.math.BigDecimal"/>
	<field name="APORTE_IECE_SECAP" class="java.math.BigDecimal"/>
	<field name="TOTAL_PATRONAL" class="java.math.BigDecimal"/>
	<field name="COSTO_EMPLEADOR" class="java.math.BigDecimal"/>
	<field name="NUMERO_ROL" class="java.lang.String"/>
	<variable name="V_EMPLEADOS" class="java.lang.Integer" calculation="Count" resetType="Report">
		<expression><![CDATA[$F{EMPLEADO}]]></expression>
	</variable>
	<variable name="V_INGRESOS" class="java.math.BigDecimal" calculation="Sum" resetType="Report">
		<expression><![CDATA[$F{TOTAL_INGRESOS}]]></expression>
	</variable>
	<variable name="V_DESCUENTOS" class="java.math.BigDecimal" calculation="Sum" resetType="Report">
		<expression><![CDATA[$F{TOTAL_DESCUENTOS}]]></expression>
	</variable>
	<variable name="V_NETO" class="java.math.BigDecimal" calculation="Sum" resetType="Report">
		<expression><![CDATA[$F{NETO}]]></expression>
	</variable>
	<variable name="V_PATRONAL" class="java.math.BigDecimal" calculation="Sum" resetType="Report">
		<expression><![CDATA[$F{TOTAL_PATRONAL}]]></expression>
	</variable>
	<variable name="V_COSTO" class="java.math.BigDecimal" calculation="Sum" resetType="Report">
		<expression><![CDATA[$F{COSTO_EMPLEADOR}]]></expression>
	</variable>
