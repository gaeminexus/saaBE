		<expression><![CDATA[$F{V8}]]></expression>
	</variable>
	<variable name="T9" class="java.math.BigDecimal" calculation="Sum" resetType="Group" resetGroup="G_SECCION">
		<expression><![CDATA[$F{V9}]]></expression>
