	<variable name="V_N" class="java.lang.Integer" calculation="Count" resetType="Group" resetGroup="G_SECCION">
		<expression><![CDATA[$F{EMPLEADO}]]></expression>
	</variable>
	<variable name="T1" class="java.math.BigDecimal" calculation="Sum" resetType="Group" resetGroup="G_SECCION">
		<expression><![CDATA[$F{V1}]]></expression>
	</variable>
	<variable name="T2" class="java.math.BigDecimal" calculation="Sum" resetType="Group" resetGroup="G_SECCION">
