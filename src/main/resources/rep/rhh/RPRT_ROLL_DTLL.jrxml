	</variable>
	<variable name="T4" class="java.math.BigDecimal" calculation="Sum" resetType="Group" resetGroup="G_SECCION">
		<expression><![CDATA[$F{V4}]]></expression>
	</variable>
	<variable name="T5" class="java.math.BigDecimal" calculation="Sum" resetType="Group" resetGroup="G_SECCION">
		<expression><![CDATA[$F{V5}]]></expression>
	</variable>
	<variable name="T6" class="java.math.BigDecimal" calculation="Sum" resetType="Group" resetGroup="G_SECCION">
		<expression><![CDATA[$F{V6}]]></expression>
	</variable>
	<variable name="T7" class="java.math.BigDecimal" calculation="Sum" resetType="Group" resetGroup="G_SECCION">
		<expression><![CDATA[$F{V7}]]></expression>
	</variable>
