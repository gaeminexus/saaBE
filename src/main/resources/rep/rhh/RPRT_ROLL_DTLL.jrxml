<!-- Rol de pagos DETALLADO del periodo (RHH): tres bloques (INGRESOS, EGRESOS, PROVISIONES Y APORTES PATRONALES),
     una fila por colaborador y una columna por concepto del periodo (12 casillas; la 12 = OTROS si hay mas).
     Mismos estilos que RPRT_ROLL_CNSL. El diseno (reglas de casillas, fondo de reserva IESS, bloque 3, cuadres) esta en
     docs/logica-negocio/reportes/REPORTE-ROL-PAGO-DETALLADO.md. Tiene <query>: se llena por la conexion JDBC de generarReporte.
     Sin fontName="Tahoma" (el exportador PDF pierde la negrita). Sin SELECT *. -->
<jasperReport name="RPRT_ROLL_DTLL" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="792" leftMargin="25" rightMargin="25" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection" uuid="20b39d7c-e5bd-4387-bddd-e5b6c8434f10">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Oracle"/>
	<property name="com.jaspersoft.studio.report.description" value="Rol de pagos detallado de un periodo: ingresos, egresos y provisiones concepto por concepto."/>
	<parameter name="P_PRDN_CODIGO" class="java.lang.Long">
		<description><![CDATA[Codigo del periodo de nomina (RHH.PRDN.PRDNCDGO)]]></description>
	</parameter>
	<parameter name="P_IMAGEN" class="java.awt.Image">
		<description><![CDATA[Logo del fondo. Lo inyecta ReporteServiceImpl si el frontend no lo envia.]]></description>
	</parameter>
	<parameter name="P_USUARIO" class="java.lang.String">
		<description><![CDATA[Usuario que genera el reporte (opcional)]]></description>
	</parameter>
	<query language="SQL"><![CDATA[WITH
-- Periodo y asiento de la nomina. PRDNASNT guarda el PK del asiento (ContabilizacionNominaServiceImpl:279,
-- setAsientoRol(asiento.getCodigo())), asi que se une por ASNTCDGO. LEFT JOIN: periodo sin contabilizar = nulo.
PER AS (
    SELECT p.PRDNANOO AS ANIO, p.PRDNMSEE AS MES, p.PRDNFCHI AS DESDE, p.PRDNFCHF AS HASTA, a.ASNTNMRO AS NUMERO_ASIENTO
    FROM   RHH.PRDN p
           LEFT JOIN CNT.ASNT a ON a.ASNTCDGO = p.PRDNASNT
    WHERE  p.PRDNCDGO = $P{P_PRDN_CODIGO}
),
-- Una fila por nomina del periodo (mismas filas y mismo orden que RPRT_ROLL_CNSL; no se filtra por estado).
NOM AS (
    SELECT n.NMNACDGO                                                    AS NMNACDGO,
           n.MPLDCDGO                                                    AS MPLDCDGO,
           n.PRDNCDGO                                                    AS PRDNCDGO,
           e.MPLDIDNT                                                    AS IDENTIFICACION,
           NVL(e.MPLDAPLL, ' ') || ' ' || NVL(e.MPLDNMBR, ' ')           AS EMPLEADO,
           e.MPLDAPLL                                                    AS APELLIDOS_ORDEN,
           e.MPLDNMBR                                                    AS NOMBRES_ORDEN,
           NVL(n.NMNADITR, 0)                                            AS DIAS,
           NVL(n.NMNAAPPT, 0)                                            AS APORTE_PATRONAL,
           NVL(n.NMNAIESC, 0)                                            AS APORTE_IECE_SECAP,
           -- Neto a pagar = NMNANETO + renglones de valor no pagado (rol de motor 34 / 35), con su signo
           -- (mismo calculo que NETO_A_PAGAR de RPRT_ROLL_INDV, con NMNANETO en vez de RLPGNETO).
           NVL(n.NMNANETO, 0) + NVL((
               SELECT SUM(ra.RNGLVLRO)
               FROM   RHH.RNGL ra
                      JOIN RHH.CPNM ca ON ca.CPNMCDGO = ra.CPNMCDGO
               WHERE  ra.NMNACDGO = n.NMNACDGO
                      AND ca.CPNMROLM IN (34, 35)
           ), 0)                                                         AS NETO_PAGAR,
           -- e3-06: fondo de reserva ACUMULADO_EN_EL_IESS (CNTEFRMD=2), no es renglon, va a RHH.PVNM tipo 4.
           -- Subconsulta FR_IESS_VALOR copiada tal cual de RPRT_ROLL_CNSL.
           NVL((
               SELECT pv.PVNMVLOR
               FROM   RHH.PVNM pv
               WHERE  pv.MPLDCDGO = e.MPLDCDGO AND pv.PRDNCDGO = p.PRDNCDGO
                      AND pv.PVNMTPPR = 4 AND pv.PVNMESTD = 1 AND ct.CNTEFRMD = 2
           ), 0)                                                         AS FR_IESS_VALOR
    FROM   RHH.PRDN p
           JOIN RHH.NMNA n ON n.PRDNCDGO = p.PRDNCDGO
           JOIN RHH.MPLD e ON e.MPLDCDGO = n.MPLDCDGO
           JOIN RHH.CNTE ct ON ct.CNTECDGO = n.CNTECDGO
    WHERE  p.PRDNCDGO = $P{P_PRDN_CODIGO}
),
-- Renglones de ingreso (1) y egreso (2). Clave del concepto: CPNMCDGO; sin concepto, la descripcion.
REN AS (
    SELECT rn.NMNACDGO                                                   AS NMNACDGO,
           rn.RNGLTPCN                                                   AS SECC,
           CASE WHEN rn.CPNMCDGO IS NOT NULL
                THEN 'C' || LPAD(TO_CHAR(rn.CPNMCDGO), 18, '0')
                ELSE 'D' || rn.RNGLDSCR END                              AS CLAVE,
           UPPER(NVL(NVL(c.CPNMABRV, c.CPNMNMBR), rn.RNGLDSCR))          AS HDR,
           c.CPNMORDN                                                    AS ORDN,
           NVL(rn.RNGLVLRO, 0)                                           AS VLR
    FROM   RHH.RNGL rn
           JOIN NOM ON NOM.NMNACDGO = rn.NMNACDGO
           LEFT JOIN RHH.CPNM c ON c.CPNMCDGO = rn.CPNMCDGO
    WHERE  rn.RNGLTPCN IN (1, 2)
),
-- Solo conceptos con algun valor distinto de 0 en el periodo.
CONC0 AS (
    SELECT SECC, CLAVE, MAX(HDR) AS HDR, MIN(ORDN) AS ORDN, 1 AS GRP
    FROM   REN
    GROUP  BY SECC, CLAVE
    HAVING SUM(ABS(VLR)) > 0
),
-- Fondo de reserva acumulado en el IESS: un concepto mas, al final de ambos bloques, solo si alguien lo tiene.
CONC1 AS (
    SELECT SECC, CLAVE, HDR, ORDN, GRP FROM CONC0
    UNION ALL
    SELECT s.SECC, 'ZFR',
           CASE s.SECC WHEN 1 THEN 'FONDOS RESERVA IESS' ELSE 'FONDOS RESERVA DEPOSITADOS IESS' END,
           CAST(NULL AS NUMBER), 2
    FROM   (SELECT 1 AS SECC FROM DUAL UNION ALL SELECT 2 FROM DUAL) s
    WHERE  EXISTS (SELECT 1 FROM NOM WHERE NOM.FR_IESS_VALOR <> 0)
),
CONC AS (
    SELECT SECC, CLAVE, HDR,
           ROW_NUMBER() OVER (PARTITION BY SECC ORDER BY GRP, NVL(ORDN, 999999999), CLAVE) AS RN,
           COUNT(*)     OVER (PARTITION BY SECC)                                           AS TOTC
    FROM   CONC1
),
-- Casilla de cada concepto: 1..12; con mas de 12 conceptos, la 12 = OTROS (suma del resto).
CS AS (
    SELECT SECC, CLAVE, HDR, TOTC,
           CASE WHEN TOTC <= 12 THEN RN WHEN RN <= 11 THEN RN ELSE 12 END AS CASILLA
    FROM   CONC
),
HD AS (
    SELECT SECC, CASILLA,
           CASE WHEN CASILLA = 12 AND TOTC > 12 THEN 'OTROS' ELSE MAX(HDR) END AS HDR
    FROM   CS
    GROUP  BY SECC, CASILLA, TOTC
    UNION ALL
    SELECT 3, 1, 'TOTAL INGRESOS' FROM DUAL UNION ALL
    SELECT 3, 2, 'DÉCIMO TERCERO' FROM DUAL UNION ALL
    SELECT 3, 3, 'DÉCIMO CUARTO' FROM DUAL UNION ALL
    SELECT 3, 4, 'VACACIONES' FROM DUAL UNION ALL
    SELECT 3, 5, 'FONDOS DE RESERVA' FROM DUAL UNION ALL
    SELECT 3, 6, 'APORTE PATRONAL IESS' FROM DUAL UNION ALL
    SELECT 3, 7, 'IECE / SECAP' FROM DUAL UNION ALL
    SELECT 3, 8, 'JUBILACIÓN PATRONAL' FROM DUAL UNION ALL
    SELECT 3, 9, 'DESAHUCIO' FROM DUAL
),
HDP AS (
    SELECT SECC,
           MAX(CASE WHEN CASILLA = 1 THEN HDR END) AS H1,
           MAX(CASE WHEN CASILLA = 2 THEN HDR END) AS H2,
           MAX(CASE WHEN CASILLA = 3 THEN HDR END) AS H3,
           MAX(CASE WHEN CASILLA = 4 THEN HDR END) AS H4,
           MAX(CASE WHEN CASILLA = 5 THEN HDR END) AS H5,
           MAX(CASE WHEN CASILLA = 6 THEN HDR END) AS H6,
           MAX(CASE WHEN CASILLA = 7 THEN HDR END) AS H7,
           MAX(CASE WHEN CASILLA = 8 THEN HDR END) AS H8,
           MAX(CASE WHEN CASILLA = 9 THEN HDR END) AS H9,
           MAX(CASE WHEN CASILLA = 10 THEN HDR END) AS H10,
           MAX(CASE WHEN CASILLA = 11 THEN HDR END) AS H11,
           MAX(CASE WHEN CASILLA = 12 THEN HDR END) AS H12
    FROM   HD
    GROUP  BY SECC
),
-- Valores de los bloques 1 y 2 por (nomina, seccion, casilla).
VAL12 AS (
    SELECT r.NMNACDGO, r.SECC, cs.CASILLA, r.VLR
    FROM   REN r
           JOIN CS cs ON cs.SECC = r.SECC AND cs.CLAVE = r.CLAVE
    UNION ALL
    SELECT NOM.NMNACDGO, cs.SECC, cs.CASILLA, NOM.FR_IESS_VALOR
    FROM   NOM
           JOIN CS cs ON cs.CLAVE = 'ZFR'
    WHERE  NOM.FR_IESS_VALOR <> 0
),
-- Bloque 3: casillas fijas. PVNM siempre con PVNMESTD = 1 (el tipo 5 NO se usa: el aporte sale de NMNAAPPT).
VAL AS (
    SELECT NMNACDGO, SECC, CASILLA, VLR FROM VAL12
    UNION ALL
    SELECT NMNACDGO, 3, 1, SUM(VLR) FROM VAL12 WHERE SECC = 1 GROUP BY NMNACDGO
    UNION ALL
    SELECT n.NMNACDGO, 3,
           DECODE(pv.PVNMTPPR, 1, 2, 2, 3, 3, 4, 4, 5, 6, 8, 7, 9),
           NVL(pv.PVNMVLOR, 0)
    FROM   NOM n
           JOIN RHH.PVNM pv ON pv.MPLDCDGO = n.MPLDCDGO AND pv.PRDNCDGO = n.PRDNCDGO
    WHERE  pv.PVNMESTD = 1 AND pv.PVNMTPPR IN (1, 2, 3, 4, 6, 7)
    UNION ALL
    SELECT NMNACDGO, 3, 6, APORTE_PATRONAL FROM NOM
    UNION ALL
    SELECT NMNACDGO, 3, 7, APORTE_IECE_SECAP FROM NOM
),
VP AS (
    SELECT NMNACDGO, SECC,
           SUM(CASE WHEN CASILLA = 1 THEN VLR END) AS S1,
           SUM(CASE WHEN CASILLA = 2 THEN VLR END) AS S2,
           SUM(CASE WHEN CASILLA = 3 THEN VLR END) AS S3,
           SUM(CASE WHEN CASILLA = 4 THEN VLR END) AS S4,
           SUM(CASE WHEN CASILLA = 5 THEN VLR END) AS S5,
           SUM(CASE WHEN CASILLA = 6 THEN VLR END) AS S6,
           SUM(CASE WHEN CASILLA = 7 THEN VLR END) AS S7,
           SUM(CASE WHEN CASILLA = 8 THEN VLR END) AS S8,
           SUM(CASE WHEN CASILLA = 9 THEN VLR END) AS S9,
           SUM(CASE WHEN CASILLA = 10 THEN VLR END) AS S10,
           SUM(CASE WHEN CASILLA = 11 THEN VLR END) AS S11,
           SUM(CASE WHEN CASILLA = 12 THEN VLR END) AS S12
    FROM   VAL
    GROUP  BY NMNACDGO, SECC
),
-- Una fila por (seccion, nomina): 0 donde la casilla tiene concepto y el colaborador no; NULL donde no hay concepto.
X AS (
    SELECT g.SECC AS SECCION, g.IDENTIFICACION, g.EMPLEADO, g.APELLIDOS_ORDEN, g.NOMBRES_ORDEN, g.NMNACDGO, g.DIAS,
           g.NETO_PAGAR,
           h.H1 AS H1,
           h.H2 AS H2,
           h.H3 AS H3,
           h.H4 AS H4,
           h.H5 AS H5,
           h.H6 AS H6,
           h.H7 AS H7,
           h.H8 AS H8,
           h.H9 AS H9,
           h.H10 AS H10,
           h.H11 AS H11,
           h.H12 AS H12,
           CASE WHEN h.H1 IS NULL THEN NULL ELSE NVL(v.S1, 0) END AS V1,
           CASE WHEN h.H2 IS NULL THEN NULL ELSE NVL(v.S2, 0) END AS V2,
           CASE WHEN h.H3 IS NULL THEN NULL ELSE NVL(v.S3, 0) END AS V3,
           CASE WHEN h.H4 IS NULL THEN NULL ELSE NVL(v.S4, 0) END AS V4,
           CASE WHEN h.H5 IS NULL THEN NULL ELSE NVL(v.S5, 0) END AS V5,
           CASE WHEN h.H6 IS NULL THEN NULL ELSE NVL(v.S6, 0) END AS V6,
           CASE WHEN h.H7 IS NULL THEN NULL ELSE NVL(v.S7, 0) END AS V7,
           CASE WHEN h.H8 IS NULL THEN NULL ELSE NVL(v.S8, 0) END AS V8,
           CASE WHEN h.H9 IS NULL THEN NULL ELSE NVL(v.S9, 0) END AS V9,
           CASE WHEN h.H10 IS NULL THEN NULL ELSE NVL(v.S10, 0) END AS V10,
           CASE WHEN h.H11 IS NULL THEN NULL ELSE NVL(v.S11, 0) END AS V11,
           CASE WHEN h.H12 IS NULL THEN NULL ELSE NVL(v.S12, 0) END AS V12
    FROM   (SELECT s.SECC, NOM.* FROM NOM CROSS JOIN (SELECT 1 AS SECC FROM DUAL UNION ALL SELECT 2 FROM DUAL UNION ALL SELECT 3 FROM DUAL) s) g
           LEFT JOIN VP  v ON v.NMNACDGO = g.NMNACDGO AND v.SECC = g.SECC
           LEFT JOIN HDP h ON h.SECC = g.SECC
)
SELECT X.SECCION                                                          AS SECCION,
       X.IDENTIFICACION                                                   AS IDENTIFICACION,
       X.EMPLEADO                                                         AS EMPLEADO,
       X.DIAS                                                             AS DIAS,
       X.H1 AS H1,
       X.H2 AS H2,
       X.H3 AS H3,
       X.H4 AS H4,
       X.H5 AS H5,
       X.H6 AS H6,
       X.H7 AS H7,
       X.H8 AS H8,
       X.H9 AS H9,
       X.H10 AS H10,
       X.H11 AS H11,
       X.H12 AS H12,
       X.V1 AS V1,
       X.V2 AS V2,
       X.V3 AS V3,
       X.V4 AS V4,
       X.V5 AS V5,
       X.V6 AS V6,
       X.V7 AS V7,
       X.V8 AS V8,
       X.V9 AS V9,
       X.V10 AS V10,
       X.V11 AS V11,
       X.V12 AS V12,
       CASE WHEN X.SECCION = 3
            THEN NVL(X.V2,0)+NVL(X.V3,0)+NVL(X.V4,0)+NVL(X.V5,0)+NVL(X.V6,0)+NVL(X.V7,0)+NVL(X.V8,0)+NVL(X.V9,0)
            ELSE NVL(X.V1,0)+NVL(X.V2,0)+NVL(X.V3,0)+NVL(X.V4,0)+NVL(X.V5,0)+NVL(X.V6,0)+NVL(X.V7,0)+NVL(X.V8,0)+NVL(X.V9,0)+NVL(X.V10,0)+NVL(X.V11,0)+NVL(X.V12,0) END                                               AS TOT,
       CASE WHEN X.SECCION = 2 THEN X.NETO_PAGAR END                      AS NETO,
       PER.ANIO                                                           AS PERIODO_ANIO,
       PER.MES                                                            AS PERIODO_MES,
       PER.DESDE                                                          AS PERIODO_DESDE,
       PER.HASTA                                                          AS PERIODO_HASTA,
       PER.NUMERO_ASIENTO                                                 AS NUMERO_ASIENTO
FROM   X
       CROSS JOIN PER
ORDER  BY X.SECCION, X.APELLIDOS_ORDEN, X.NOMBRES_ORDEN, X.NMNACDGO]]></query>
	<field name="SECCION" class="java.math.BigDecimal"/>
	<field name="IDENTIFICACION" class="java.lang.String"/>
	<field name="EMPLEADO" class="java.lang.String"/>
