	<variable name="T11" class="java.math.BigDecimal" calculation="Sum" resetType="Group" resetGroup="G_SECCION">
		<expression><![CDATA[$F{V11}]]></expression>
	</variable>
	<variable name="T12" class="java.math.BigDecimal" calculation="Sum" resetType="Group" resetGroup="G_SECCION">
		<expression><![CDATA[$F{V12}]]></expression>
	</variable>
	<variable name="T_TOT" class="java.math.BigDecimal" calculation="Sum" resetType="Group" resetGroup="G_SECCION">
		<expression><![CDATA[$F{TOT}]]></expression>
	</variable>
