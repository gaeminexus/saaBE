		<expression><![CDATA[$F{NETO}]]></expression>
	</variable>
	<group name="G_SECCION" reprintHeaderOnEachPage="true" minHeightToStartNewPage="70">
		<expression><![CDATA[$F{SECCION}]]></expression>
		<groupHeader>
			<band height="44" splitType="Prevent">
				<element kind="textField" uuid="c296177d-db93-4fd6-ad57-d90d838e0fd2" mode="Opaque" x="0" y="0" width="792" height="14" backcolor="#CBD5E0" forecolor="#1A202C" fontSize="8.0" bold="true" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle">
					<expression><![CDATA[$F{SECCION}.intValue() == 1 ? "INGRESOS" : ($F{SECCION}.intValue() == 2 ? "EGRESOS" : "PROVISIONES Y APORTES PATRONALES")]]></expression>
