	<background splitType="Stretch"/>
	<title height="72" splitType="Stretch">
		<element kind="image" uuid="a7f5d35a-2e4d-4959-9a65-070f08e50a76" x="0" y="4" width="110" height="52" scaleImage="RetainShape" onErrorType="Blank" hImageAlign="Center" vImageAlign="Middle">
			<expression><![CDATA[$P{P_IMAGEN}]]></expression>
		</element>
		<element kind="rectangle" uuid="cdd7f0a4-d6e2-4bf8-b32f-485bd1d757b6" x="118" y="4" width="674" height="52">
			<pen lineWidth="0.75" lineColor="#CBD5E0"/>
		</element>
		<element kind="textField" uuid="1abd2ef7-b9e9-4ca4-85cf-5333b68ad7d9" x="128" y="8" width="654" height="22" forecolor="#1A202C" fontSize="15.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
			<expression><![CDATA["ROL DE PAGOS DETALLADO — " + ($F{PERIODO_MES} != null && $F{PERIODO_MES}.intValue() >= 1 && $F{PERIODO_MES}.intValue() <= 12 ? new String[]{"ENERO","FEBRERO","MARZO","ABRIL","MAYO","JUNIO","JULIO","AGOSTO","SEPTIEMBRE","OCTUBRE","NOVIEMBRE","DICIEMBRE"}[$F{PERIODO_MES}.intValue() - 1] : "?") + " " + ($F{PERIODO_ANIO} != null ? $F{PERIODO_ANIO}.toBigInteger().toString() : "?")]]></expression>
		</element>
		<element kind="textField" uuid="6dcaaf38-c7e2-4ad0-bd31-23692925ebb7" x="128" y="30" width="654" height="12" forecolor="#718096" fontSize="9.0" hTextAlign="Center" vTextAlign="Middle">
			<expression><![CDATA["Periodo " + ($F{PERIODO_MES} != null ? $F{PERIODO_MES}.toBigInteger().toString() : "?") + "/" + ($F{PERIODO_ANIO} != null ? $F{PERIODO_ANIO}.toBigInteger().toString() : "?")
+ "   ·   " + ($F{PERIODO_DESDE} != null ? new java.text.SimpleDateFormat("d/M/yyyy").format($F{PERIODO_DESDE}) : "?") + " al " + ($F{PERIODO_HASTA} != null ? new java.text.SimpleDateFormat("d/M/yyyy").format($F{PERIODO_HASTA}) : "?")]]></expression>
		</element>
		<element kind="textField" uuid="6d6e7742-df60-45b5-9bb6-195f641d6bb3" x="128" y="42" width="654" height="12" forecolor="#4A5568" fontSize="8.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
			<expression><![CDATA["N° asiento: " + ($F{NUMERO_ASIENTO} != null ? $F{NUMERO_ASIENTO}.toBigInteger().toString() : "sin contabilizar")]]></expression>
		</element>
		<element kind="textField" uuid="2ae5651b-5f1d-450a-8a03-13651c6d2e04" x="592" y="58" width="200" height="11" forecolor="#718096" fontSize="6.5" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA["Generado: " + new java.text.SimpleDateFormat("d/M/yyyy h:mm a").format(new java.util.Date()) + ($P{P_USUARIO} != null ? ("  ·  Por: " + $P{P_USUARIO}) : "")]]></expression>
		</element>
	</title>
