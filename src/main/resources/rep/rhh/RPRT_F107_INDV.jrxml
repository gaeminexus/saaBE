			<text><![CDATA[Comprobante de retenciones en relacion de dependencia]]></text>
		</element>
		<element kind="textField" uuid="c6000000-0000-0000-0000-000000000105" x="128" y="42" width="407" height="12" forecolor="#718096" fontName="Tahoma" fontSize="8.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
			<expression><![CDATA["Ejercicio " + $P{P_ANIO}]]></expression>
		</element>
		<element kind="textField" uuid="c6000000-0000-0000-0000-000000000106" x="395" y="60" width="150" height="11" forecolor="#718096" fontSize="6.5" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA["Generado: " + new java.text.SimpleDateFormat("d/M/yyyy h:mm a").format(new java.util.Date()) + ($P{P_USUARIO} != null ? ("  ·  Por: " + $P{P_USUARIO}) : "")]]></expression>
		</element>
		<element kind="staticText" uuid="c6000000-0000-0000-0000-000000000110" mode="Opaque" x="0" y="78" width="100" height="14" backcolor="#F7FAFC" fontName="Tahoma" fontSize="7.5" bold="true" vTextAlign="Middle">
