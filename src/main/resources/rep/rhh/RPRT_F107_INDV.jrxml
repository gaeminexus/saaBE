			<element kind="textField" uuid="c6000000-0000-0000-0000-000000000301" x="0" y="0" width="70" height="14" fontName="Tahoma" fontSize="7.0" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle">
				<expression><![CDATA[$F{CASILLERO}]]></expression>
				<box><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
			</element>
			<element kind="textField" uuid="c6000000-0000-0000-0000-000000000302" x="70" y="0" width="345" height="14" fontName="Tahoma" fontSize="7.0" blankWhenNull="true" vTextAlign="Middle">
