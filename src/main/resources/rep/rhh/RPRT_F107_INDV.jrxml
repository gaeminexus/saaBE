<!-- Formulario 107 individual (RHH). Estilo corporativo cnt/crd + logo ASOPREP-FCPC. Ver docs/logica-negocio/reportes/REPORTE-FORMULARIO-107.md -->
<jasperReport name="RPRT_F107_INDV" language="java" pageWidth="595" pageHeight="842" columnWidth="545" leftMargin="25" rightMargin="25" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection" uuid="c6000000-0000-0000-0000-000000000000">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Oracle"/>
	<property name="com.jaspersoft.studio.report.description" value="Comprobante de retenciones en relacion de dependencia (formulario 107) de un empleado, con los casilleros de CPNMF107."/>
	<parameter name="P_MPLD_CODIGO" class="java.lang.Long">
		<description><![CDATA[Codigo del empleado (RHH.MPLD.MPLDCDGO)]]></description>
	</parameter>
	<parameter name="P_ANIO" class="java.lang.Integer">
		<description><![CDATA[Ejercicio fiscal]]></description>
	</parameter>
	<parameter name="P_IMAGEN" class="java.awt.Image">
		<description><![CDATA[Logo del fondo. Lo inyecta ReporteServiceImpl si el frontend no lo envia.]]></description>
	</parameter>
	<parameter name="P_USUARIO" class="java.lang.String">
		<description><![CDATA[Usuario que genera el reporte (opcional)]]></description>
	</parameter>
	<query language="SQL"><![CDATA[SELECT
    e.MPLDIDNT                                                        AS IDENTIFICACION,
    NVL(e.MPLDAPLL, ' ') || ' ' || NVL(e.MPLDNMBR, ' ')               AS EMPLEADO,
    $P{P_ANIO}                                                        AS EJERCICIO,
    c.CPNMF107                                                        AS CASILLERO,
    c.CPNMNMBR                                                        AS CONCEPTO,
    NVL(c.CPNMTPCN, 1)                                                AS TIPO_CONCEPTO,
    SUM(NVL(r.RNGLVLRO, 0))                                           AS VALOR
FROM RHH.MPLD e
     JOIN RHH.NMNA n ON n.MPLDCDGO = e.MPLDCDGO
     JOIN RHH.PRDN p ON p.PRDNCDGO = n.PRDNCDGO
     JOIN RHH.RNGL r ON r.NMNACDGO = n.NMNACDGO
     JOIN RHH.CPNM c ON c.CPNMCDGO = r.CPNMCDGO
WHERE e.MPLDCDGO = $P{P_MPLD_CODIGO}
  AND p.PRDNANOO = $P{P_ANIO}
  AND c.CPNMF107 IS NOT NULL
GROUP BY e.MPLDIDNT, e.MPLDAPLL, e.MPLDNMBR, c.CPNMF107, c.CPNMNMBR, c.CPNMTPCN
ORDER BY c.CPNMF107]]></query>
	<field name="IDENTIFICACION" class="java.lang.String"/>
	<field name="EMPLEADO" class="java.lang.String"/>
	<field name="EJERCICIO" class="java.math.BigDecimal"/>
	<field name="CASILLERO" class="java.lang.String"/>
	<field name="CONCEPTO" class="java.lang.String"/>
	<field name="TIPO_CONCEPTO" class="java.math.BigDecimal"/>
	<field name="VALOR" class="java.math.BigDecimal"/>
	<variable name="V_INGRESOS" class="java.math.BigDecimal" calculation="Sum" resetType="Report">
		<expression><![CDATA[$F{TIPO_CONCEPTO}.intValue() == 1 ? $F{VALOR} : java.math.BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="V_DESCUENTOS" class="java.math.BigDecimal" calculation="Sum" resetType="Report">
		<expression><![CDATA[$F{TIPO_CONCEPTO}.intValue() == 2 ? $F{VALOR} : java.math.BigDecimal.ZERO]]></expression>
	</variable>
