	<title height="120" splitType="Stretch">
		<element kind="image" uuid="c6000000-0000-0000-0000-000000000101" x="0" y="4" width="110" height="52" scaleImage="RetainShape" onErrorType="Blank" hImageAlign="Center" vImageAlign="Middle">
			<expression><![CDATA[$P{P_IMAGEN}]]></expression>
