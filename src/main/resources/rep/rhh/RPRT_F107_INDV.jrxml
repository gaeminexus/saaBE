			<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="textField" uuid="c6000000-0000-0000-0000-000000000111" x="100" y="78" width="300" height="14" fontName="Tahoma" fontSize="7.5" blankWhenNull="true" vTextAlign="Middle">
			<expression><![CDATA[$F{EMPLEADO}]]></expression>
			<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="staticText" uuid="c6000000-0000-0000-0000-000000000112" mode="Opaque" x="400" y="78" width="55" height="14" backcolor="#F7FAFC" fontName="Tahoma" fontSize="7.5" bold="true" vTextAlign="Middle">
			<text><![CDATA[Cedula]]></text>
			<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="textField" uuid="c6000000-0000-0000-0000-000000000113" x="455" y="78" width="90" height="14" fontName="Tahoma" fontSize="7.5" blankWhenNull="true" vTextAlign="Middle">
			<expression><![CDATA[$F{IDENTIFICACION}]]></expression>
			<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="staticText" uuid="c6000000-0000-0000-0000-000000000114" x="0" y="98" width="545" height="18" forecolor="#4A5568" fontName="Tahoma" fontSize="7.0" vTextAlign="Middle">
			<text><![CDATA[Los valores se agrupan por el casillero del formulario declarado en cada concepto de nomina (CPNMF107). Un concepto sin casillero no aparece: no forma parte de la declaracion.]]></text>
		</element>
	</title>
