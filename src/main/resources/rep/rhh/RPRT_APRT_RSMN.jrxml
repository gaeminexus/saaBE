			<text><![CDATA[RESUMEN DE APORTES AL IESS]]></text>
		</element>
		<element kind="textField" uuid="c4000000-0000-0000-0000-000000000104" x="128" y="34" width="654" height="16" forecolor="#718096" fontName="Tahoma" fontSize="9.0" hTextAlign="Center" vTextAlign="Middle">
			<expression><![CDATA["Periodo " + ($F{PERIODO_MES} != null ? $F{PERIODO_MES}.toBigInteger().toString() : "?") + "/" + ($F{PERIODO_ANIO} != null ? $F{PERIODO_ANIO}.toBigInteger().toString() : "?")
+ "   ·   " + new java.text.SimpleDateFormat("d/M/yyyy").format($F{PERIODO_DESDE}) + " al " + new java.text.SimpleDateFormat("d/M/yyyy").format($F{PERIODO_HASTA})]]></expression>
		</element>
		<element kind="textField" uuid="c4000000-0000-0000-0000-000000000105" x="592" y="58" width="200" height="11" forecolor="#718096" fontSize="6.5" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA["Generado: " + new java.text.SimpleDateFormat("d/M/yyyy h:mm a").format(new java.util.Date()) + ($P{P_USUARIO} != null ? ("  ·  Por: " + $P{P_USUARIO}) : "")]]></expression>
		</element>
	</title>
