<!-- Resumen de aportes del periodo (RHH). Es el reporte con el que se cuadra contra la planilla del IESS. Ver docs/logica-negocio/reportes/REPORTE-RESUMEN-APORTES.md -->
<jasperReport name="RPRT_APRT_RSMN" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="792" leftMargin="25" rightMargin="25" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection" uuid="c4000000-0000-0000-0000-000000000000">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Oracle"/>
	<property name="com.jaspersoft.studio.report.description" value="Aporte personal, patronal, IECE y SECAP por empleado de un periodo, para cuadrar contra la planilla emitida por el IESS."/>
	<parameter name="P_PRDN_CODIGO" class="java.lang.Long">
		<description><![CDATA[Codigo del periodo de nomina (RHH.PRDN.PRDNCDGO)]]></description>
	</parameter>
	<parameter name="P_IMAGEN" class="java.awt.Image">
		<description><![CDATA[Logo del fondo. Lo inyecta ReporteServiceImpl si el frontend no lo envia.]]></description>
	</parameter>
	<parameter name="P_USUARIO" class="java.lang.String">
		<description><![CDATA[Usuario que genera el reporte (opcional)]]></description>
	</parameter>
	<query language="SQL"><![CDATA[SELECT
    p.PRDNANOO                                                        AS PERIODO_ANIO,
    p.PRDNMSEE                                                        AS PERIODO_MES,
    p.PRDNFCHI                                                        AS PERIODO_DESDE,
    p.PRDNFCHF                                                        AS PERIODO_HASTA,
    e.MPLDIDNT                                                        AS IDENTIFICACION,
    NVL(e.MPLDCDAF, ' ')                                              AS CODIGO_AFILIACION,
    NVL(e.MPLDAPLL, ' ') || ' ' || NVL(e.MPLDNMBR, ' ')               AS EMPLEADO,
    NVL(c.CNTEAPRT, 'N')                                              AS APORTA_IESS,
    NVL(n.NMNABSIE, 0)                                                AS BASE_IESS,
    NVL(n.NMNAFNRS, 0)                                                AS FONDOS_RESERVA,
    NVL(n.NMNAAPPR, 0)                                                AS APORTE_PERSONAL,
    NVL(n.NMNAAPPT, 0)                                                AS APORTE_PATRONAL,
    NVL(n.NMNAIESC, 0)                                                AS APORTE_IECE_SECAP,
    NVL(n.NMNAAPPR, 0) + NVL(n.NMNAAPPT, 0) + NVL(n.NMNAIESC, 0)      AS TOTAL_APORTES,
    NVL(n.NMNATTPT, 0)                                                AS TOTAL_PATRONAL,
    -- Control: NMNATTPT debe ser el patronal mas el IECE y el SECAP. Si difiere, la
    -- cabecera de esa nomina se escribio con un motor anterior al reparto por rol.
    NVL(n.NMNATTPT, 0) - (NVL(n.NMNAAPPT, 0) + NVL(n.NMNAIESC, 0))    AS DIFERENCIA_PATRONAL
FROM RHH.PRDN p
     JOIN RHH.NMNA n ON n.PRDNCDGO = p.PRDNCDGO
     JOIN RHH.MPLD e ON e.MPLDCDGO = n.MPLDCDGO
     LEFT JOIN RHH.CNTE c ON c.CNTECDGO = n.CNTECDGO
WHERE p.PRDNCDGO = $P{P_PRDN_CODIGO}
ORDER BY e.MPLDAPLL, e.MPLDNMBR, n.NMNACDGO]]></query>
	<field name="PERIODO_ANIO" class="java.math.BigDecimal"/>
	<field name="PERIODO_MES" class="java.math.BigDecimal"/>
	<field name="PERIODO_DESDE" class="java.sql.Timestamp"/>
	<field name="PERIODO_HASTA" class="java.sql.Timestamp"/>
	<field name="IDENTIFICACION" class="java.lang.String"/>
	<field name="CODIGO_AFILIACION" class="java.lang.String"/>
	<field name="EMPLEADO" class="java.lang.String"/>
	<field name="APORTA_IESS" class="java.lang.String"/>
	<field name="BASE_IESS" class="java.math.BigDecimal"/>
	<field name="FONDOS_RESERVA" class="java.math.BigDecimal"/>
	<field name="APORTE_PERSONAL" class="java.math.BigDecimal"/>
	<field name="APORTE_PATRONAL" class="java.math.BigDecimal"/>
	<field name="APORTE_IECE_SECAP" class="java.math.BigDecimal"/>
	<field name="TOTAL_APORTES" class="java.math.BigDecimal"/>
	<field name="TOTAL_PATRONAL" class="java.math.BigDecimal"/>
	<field name="DIFERENCIA_PATRONAL" class="java.math.BigDecimal"/>
	<variable name="V_EMPLEADOS" class="java.lang.Integer" calculation="Count" resetType="Report">
		<expression><![CDATA[$F{EMPLEADO}]]></expression>
	</variable>
	<variable name="V_BASE" class="java.math.BigDecimal" calculation="Sum" resetType="Report">
		<expression><![CDATA[$F{BASE_IESS}]]></expression>
	</variable>
	<variable name="V_FONDOS" class="java.math.BigDecimal" calculation="Sum" resetType="Report">
		<expression><![CDATA[$F{FONDOS_RESERVA}]]></expression>
	</variable>
	<variable name="V_PERSONAL" class="java.math.BigDecimal" calculation="Sum" resetType="Report">
		<expression><![CDATA[$F{APORTE_PERSONAL}]]></expression>
	</variable>
	<variable name="V_PATRONAL" class="java.math.BigDecimal" calculation="Sum" resetType="Report">
		<expression><![CDATA[$F{APORTE_PATRONAL}]]></expression>
	</variable>
	<variable name="V_IECE_SECAP" class="java.math.BigDecimal" calculation="Sum" resetType="Report">
		<expression><![CDATA[$F{APORTE_IECE_SECAP}]]></expression>
	</variable>
	<variable name="V_TOTAL" class="java.math.BigDecimal" calculation="Sum" resetType="Report">
		<expression><![CDATA[$F{TOTAL_APORTES}]]></expression>
	</variable>
	<variable name="V_DESCUADRES" class="java.lang.Integer" calculation="Sum" resetType="Report">
		<expression><![CDATA[Integer.valueOf(Math.abs($F{DIFERENCIA_PATRONAL}.doubleValue()) > 0.01 ? 1 : 0)]]></expression>
	</variable>
