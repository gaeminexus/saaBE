		<element kind="textField" uuid="c5000000-0000-0000-0000-000000000502" x="415" y="2" width="130" height="16" pattern="$#,##0.00" fontName="Tahoma" fontSize="7.5" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA[$F{TOTAL_INGRESOS}]]></expression>
			<box rightPadding="4"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="staticText" uuid="c5000000-0000-0000-0000-000000000503" mode="Opaque" x="245" y="18" width="170" height="16" backcolor="#F7FAFC" forecolor="#1A202C" fontName="Tahoma" fontSize="7.5" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<text><![CDATA[TOTAL DESCUENTOS]]></text>
			<box rightPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="textField" uuid="c5000000-0000-0000-0000-000000000504" x="415" y="18" width="130" height="16" pattern="$#,##0.00" fontName="Tahoma" fontSize="7.5" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA[$F{TOTAL_DESCUENTOS}]]></expression>
			<box rightPadding="4"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="staticText" uuid="c5000000-0000-0000-0000-000000000505" mode="Opaque" x="245" y="34" width="170" height="18" backcolor="#EDF2F7" forecolor="#1A202C" fontName="Tahoma" fontSize="8.5" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<text><![CDATA[NETO A RECIBIR]]></text>
			<box rightPadding="6"><pen lineWidth="0.5" lineColor="#4A5568"/></box>
		</element>
		<element kind="textField" uuid="c5000000-0000-0000-0000-000000000506" x="415" y="34" width="130" height="18" pattern="$#,##0.00" fontName="Tahoma" fontSize="8.5" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA[$F{NETO}]]></expression>
			<box rightPadding="4"><pen lineWidth="0.5" lineColor="#4A5568"/></box>
		</element>
		<!-- Un neto negativo se muestra, no se esconde: significa que el trabajador debe -->
		<element kind="textField" uuid="c5000000-0000-0000-0000-000000000510" x="0" y="56" width="545" height="14" forecolor="#C05621" fontName="Tahoma" fontSize="7.0" bold="true" blankWhenNull="true" removeLineWhenBlank="true" vTextAlign="Middle">
			<expression><![CDATA[$F{NETO}.doubleValue() < 0
  ? "El finiquito arroja saldo a favor del empleador: el trabajador adeuda " + new java.text.DecimalFormat("$#,##0.00").format(Math.abs($F{NETO}.doubleValue())) + "."
  : null]]></expression>
		</element>
		<element kind="staticText" uuid="c5000000-0000-0000-0000-000000000520" x="0" y="76" width="545" height="34" forecolor="#4A5568" fontName="Tahoma" fontSize="7.0" vTextAlign="Top">
			<text><![CDATA[Las partes declaran que este finiquito se suscribe de manera libre y voluntaria, y que con su pago quedan canceladas todas las obligaciones derivadas de la relacion laboral. El acta debe registrarse en el Sistema Unico de Trabajo del Ministerio del Trabajo.]]></text>
		</element>
		<element kind="line" uuid="c5000000-0000-0000-0000-000000000530" x="20" y="150" width="200" height="1">
			<pen lineWidth="0.5" lineColor="#4A5568"/>
