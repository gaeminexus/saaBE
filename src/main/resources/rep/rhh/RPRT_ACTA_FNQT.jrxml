<!-- Acta de finiquito (RHH). Estilo corporativo cnt/crd + logo ASOPREP-FCPC. Ver docs/logica-negocio/reportes/REPORTE-ACTA-FINIQUITO.md -->
<jasperReport name="RPRT_ACTA_FNQT" language="java" pageWidth="595" pageHeight="842" columnWidth="545" leftMargin="25" rightMargin="25" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection" uuid="c5000000-0000-0000-0000-000000000000">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Oracle"/>
	<property name="com.jaspersoft.studio.report.description" value="Acta de finiquito del colaborador: rubros del finiquito, totales y firmas, para el registro en el SUT."/>
	<parameter name="P_LQDC_CODIGO" class="java.lang.Long">
		<description><![CDATA[Codigo de la liquidacion (RHH.LQDC.LQDCCDGO)]]></description>
	</parameter>
	<parameter name="P_IMAGEN" class="java.awt.Image">
		<description><![CDATA[Logo del fondo. Lo inyecta ReporteServiceImpl si el frontend no lo envia.]]></description>
	</parameter>
	<parameter name="P_USUARIO" class="java.lang.String">
		<description><![CDATA[Usuario que genera el reporte (opcional)]]></description>
	</parameter>
	<query language="SQL"><![CDATA[SELECT
    l.LQDCCDGO                                                        AS LIQUIDACION,
    l.LQDCFCHS                                                        AS FECHA_SALIDA,
    l.LQDCFCIN                                                        AS FECHA_INGRESO,
    NVL(l.LQDCANSR, 0)                                                AS ANIOS_SERVICIO,
    NVL(l.LQDCULRM, 0)                                                AS ULTIMA_REMUNERACION,
    NVL(l.LQDCTTIN, 0)                                                AS TOTAL_INGRESOS,
    NVL(l.LQDCTTDS, 0)                                                AS TOTAL_DESCUENTOS,
    NVL(l.LQDCNETO, 0)                                                AS NETO,
    NVL(l.LQDCACSU, ' ')                                              AS ACTA_SUT,
    e.MPLDIDNT                                                        AS IDENTIFICACION,
    NVL(e.MPLDAPLL, ' ') || ' ' || NVL(e.MPLDNMBR, ' ')               AS EMPLEADO,
    NVL(c.CSTRNMBR, '(sin causal registrada)')                        AS CAUSAL,
    NVL(c.CSTRARTC, ' ')                                              AS ARTICULO,
    NVL(g.CPNMNMBR, NVL(d.TMLQDSCR, 'Rubro'))                         AS RUBRO,
    NVL(d.TMLQTPCN, 1)                                                AS TIPO_CONCEPTO,
    NVL(d.TMLQBSCL, 0)                                                AS BASE_CALCULO,
    NVL(d.TMLQDIAS, 0)                                                AS DIAS,
    NVL(d.TMLQVLRO, 0)                                                AS VALOR,
    NVL(d.TMLQORDN, 0)                                                AS ORDEN
FROM RHH.LQDC l
     JOIN RHH.MPLD e ON e.MPLDCDGO = l.MPLDCDGO
     LEFT JOIN RHH.CSTR c ON c.CSTRCDGO = l.CSTRCDGO
     LEFT JOIN RHH.TMLQ d ON d.LQDCCDGO = l.LQDCCDGO
     LEFT JOIN RHH.CPNM g ON g.CPNMCDGO = d.CPNMCDGO
WHERE l.LQDCCDGO = $P{P_LQDC_CODIGO}
ORDER BY NVL(d.TMLQORDN, 0), d.TMLQCDGO]]></query>
	<field name="LIQUIDACION" class="java.math.BigDecimal"/>
	<field name="FECHA_SALIDA" class="java.sql.Timestamp"/>
	<field name="FECHA_INGRESO" class="java.sql.Timestamp"/>
	<field name="ANIOS_SERVICIO" class="java.math.BigDecimal"/>
	<field name="ULTIMA_REMUNERACION" class="java.math.BigDecimal"/>
	<field name="TOTAL_INGRESOS" class="java.math.BigDecimal"/>
	<field name="TOTAL_DESCUENTOS" class="java.math.BigDecimal"/>
	<field name="NETO" class="java.math.BigDecimal"/>
	<field name="ACTA_SUT" class="java.lang.String"/>
	<field name="IDENTIFICACION" class="java.lang.String"/>
	<field name="EMPLEADO" class="java.lang.String"/>
	<field name="CAUSAL" class="java.lang.String"/>
	<field name="ARTICULO" class="java.lang.String"/>
	<field name="RUBRO" class="java.lang.String"/>
	<field name="TIPO_CONCEPTO" class="java.math.BigDecimal"/>
	<field name="BASE_CALCULO" class="java.math.BigDecimal"/>
	<field name="DIAS" class="java.math.BigDecimal"/>
	<field name="VALOR" class="java.math.BigDecimal"/>
	<field name="ORDEN" class="java.math.BigDecimal"/>
	<background splitType="Stretch"/>
	<title height="170" splitType="Stretch">
		<element kind="image" uuid="c5000000-0000-0000-0000-000000000101" x="0" y="4" width="110" height="52" scaleImage="RetainShape" onErrorType="Blank" hImageAlign="Center" vImageAlign="Middle">
			<expression><![CDATA[$P{P_IMAGEN}]]></expression>
		</element>
		<element kind="rectangle" uuid="c5000000-0000-0000-0000-000000000102" x="118" y="4" width="427" height="52">
			<pen lineWidth="0.75" lineColor="#CBD5E0"/>
		</element>
		<element kind="staticText" uuid="c5000000-0000-0000-0000-000000000103" x="128" y="10" width="407" height="24" forecolor="#1A202C" fontName="Tahoma" fontSize="15.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
			<text><![CDATA[ACTA DE FINIQUITO]]></text>
		</element>
		<element kind="textField" uuid="c5000000-0000-0000-0000-000000000104" x="128" y="34" width="407" height="16" forecolor="#718096" fontName="Tahoma" fontSize="9.0" hTextAlign="Center" vTextAlign="Middle">
			<expression><![CDATA[$F{ACTA_SUT}.trim().length() > 0 ? ("Acta SUT " + $F{ACTA_SUT}) : "Pendiente de registro en el SUT"]]></expression>
		</element>
		<element kind="textField" uuid="c5000000-0000-0000-0000-000000000105" x="395" y="60" width="150" height="11" forecolor="#718096" fontSize="6.5" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA["Generado: " + new java.text.SimpleDateFormat("d/M/yyyy h:mm a").format(new java.util.Date()) + ($P{P_USUARIO} != null ? ("  ·  Por: " + $P{P_USUARIO}) : "")]]></expression>
		</element>
		<element kind="staticText" uuid="c5000000-0000-0000-0000-000000000110" mode="Opaque" x="0" y="78" width="545" height="14" backcolor="#EDF2F7" forecolor="#4A5568" fontName="Tahoma" fontSize="8.0" bold="true" vTextAlign="Middle">
			<text><![CDATA[DATOS DE LA RELACION LABORAL]]></text>
			<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="staticText" uuid="c5000000-0000-0000-0000-000000000111" mode="Opaque" x="0" y="92" width="100" height="14" backcolor="#F7FAFC" fontName="Tahoma" fontSize="7.5" bold="true" vTextAlign="Middle">
			<text><![CDATA[Trabajador]]></text>
			<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="textField" uuid="c5000000-0000-0000-0000-000000000112" x="100" y="92" width="260" height="14" fontName="Tahoma" fontSize="7.5" blankWhenNull="true" vTextAlign="Middle">
			<expression><![CDATA[$F{EMPLEADO}]]></expression>
			<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="staticText" uuid="c5000000-0000-0000-0000-000000000113" mode="Opaque" x="360" y="92" width="80" height="14" backcolor="#F7FAFC" fontName="Tahoma" fontSize="7.5" bold="true" vTextAlign="Middle">
			<text><![CDATA[Cedula]]></text>
			<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="textField" uuid="c5000000-0000-0000-0000-000000000114" x="440" y="92" width="105" height="14" fontName="Tahoma" fontSize="7.5" blankWhenNull="true" vTextAlign="Middle">
			<expression><![CDATA[$F{IDENTIFICACION}]]></expression>
			<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="staticText" uuid="c5000000-0000-0000-0000-000000000115" mode="Opaque" x="0" y="106" width="100" height="14" backcolor="#F7FAFC" fontName="Tahoma" fontSize="7.5" bold="true" vTextAlign="Middle">
			<text><![CDATA[Ingreso / Salida]]></text>
			<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="textField" uuid="c5000000-0000-0000-0000-000000000116" x="100" y="106" width="260" height="14" fontName="Tahoma" fontSize="7.5" blankWhenNull="true" vTextAlign="Middle">
			<expression><![CDATA[($F{FECHA_INGRESO} != null ? new java.text.SimpleDateFormat("d/M/yyyy").format($F{FECHA_INGRESO}) : "?")
+ "   al   " + new java.text.SimpleDateFormat("d/M/yyyy").format($F{FECHA_SALIDA})]]></expression>
			<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="staticText" uuid="c5000000-0000-0000-0000-000000000117" mode="Opaque" x="360" y="106" width="80" height="14" backcolor="#F7FAFC" fontName="Tahoma" fontSize="7.5" bold="true" vTextAlign="Middle">
			<text><![CDATA[Anios]]></text>
			<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="textField" uuid="c5000000-0000-0000-0000-000000000118" x="440" y="106" width="105" height="14" pattern="#,##0.00" fontName="Tahoma" fontSize="7.5" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA[$F{ANIOS_SERVICIO}]]></expression>
			<box rightPadding="8"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="staticText" uuid="c5000000-0000-0000-0000-000000000119" mode="Opaque" x="0" y="120" width="100" height="14" backcolor="#F7FAFC" fontName="Tahoma" fontSize="7.5" bold="true" vTextAlign="Middle">
			<text><![CDATA[Causal]]></text>
			<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="textField" uuid="c5000000-0000-0000-0000-00000000011a" x="100" y="120" width="340" height="14" fontName="Tahoma" fontSize="7.5" blankWhenNull="true" vTextAlign="Middle">
			<expression><![CDATA[$F{CAUSAL} + ($F{ARTICULO}.trim().length() > 0 ? ("   (" + $F{ARTICULO} + ")") : "")]]></expression>
			<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="staticText" uuid="c5000000-0000-0000-0000-00000000011b" mode="Opaque" x="440" y="120" width="105" height="14" backcolor="#F7FAFC" fontName="Tahoma" fontSize="7.5" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<text><![CDATA[Ult. remuneracion]]></text>
			<box rightPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="textField" uuid="c5000000-0000-0000-0000-00000000011c" x="0" y="140" width="545" height="26" forecolor="#4A5568" fontName="Tahoma" fontSize="7.5" textAdjust="StretchHeight" vTextAlign="Middle">
			<expression><![CDATA["Ultima remuneracion mensual: " + new java.text.DecimalFormat("$#,##0.00").format($F{ULTIMA_REMUNERACION}.doubleValue())
+ ". Los rubros que siguen se calcularon sobre esa base y sobre la antiguedad indicada."]]></expression>
		</element>
	</title>
	<pageHeader height="4" splitType="Stretch"/>
	<columnHeader height="26" splitType="Stretch">
		<element kind="staticText" uuid="c5000000-0000-0000-0000-000000000201" mode="Opaque" x="0" y="4" width="245" height="20" backcolor="#EDF2F7" forecolor="#4A5568" fontName="Tahoma" fontSize="7.0" bold="true" vTextAlign="Middle">
