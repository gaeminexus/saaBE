			<text><![CDATA[Valor]]></text>
			<box rightPadding="4"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
	</columnHeader>
	<detail>
		<band height="14" splitType="Prevent">
			<printWhenExpression><![CDATA[$F{VALOR} != null && $F{VALOR}.doubleValue() != 0]]></printWhenExpression>
			<element kind="textField" uuid="c5000000-0000-0000-0000-000000000301" x="0" y="0" width="245" height="14" fontName="Tahoma" fontSize="7.0" blankWhenNull="true" vTextAlign="Middle">
				<expression><![CDATA[$F{RUBRO} + ($F{TIPO_CONCEPTO}.intValue() == 2 ? "  (descuento)" : "")]]></expression>
				<box leftPadding="4"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
			</element>
			<element kind="textField" uuid="c5000000-0000-0000-0000-000000000302" x="245" y="0" width="90" height="14" fontName="Tahoma" fontSize="7.0" blankWhenNull="true" removeLineWhenBlank="true" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA[$F{BASE_CALCULO}.doubleValue() > 0 ? new java.text.DecimalFormat("$#,##0.00").format($F{BASE_CALCULO}.doubleValue()) : null]]></expression>
				<box rightPadding="4"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
			</element>
			<element kind="textField" uuid="c5000000-0000-0000-0000-000000000303" x="335" y="0" width="80" height="14" fontName="Tahoma" fontSize="7.0" blankWhenNull="true" removeLineWhenBlank="true" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA[$F{DIAS}.doubleValue() > 0 ? new java.text.DecimalFormat("#,##0.00").format($F{DIAS}.doubleValue()) : null]]></expression>
				<box rightPadding="4"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
			</element>
