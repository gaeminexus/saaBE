	</pageFooter>
	<summary height="200" splitType="Stretch">
		<element kind="staticText" uuid="c5000000-0000-0000-0000-000000000501" mode="Opaque" x="245" y="2" width="170" height="16" backcolor="#F7FAFC" forecolor="#1A202C" fontName="Tahoma" fontSize="7.5" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<text><![CDATA[TOTAL INGRESOS]]></text>
			<box rightPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
