		<element kind="textField" uuid="c5000000-0000-0000-0000-000000000603" x="0" y="100" width="545" height="16" fontName="Tahoma" fontSize="8.0" hTextAlign="Center" vTextAlign="Middle">
			<expression><![CDATA["No se encontro la liquidacion con codigo " + ($P{P_LQDC_CODIGO} != null ? String.valueOf($P{P_LQDC_CODIGO}) : "(nulo)") + "."]]></expression>
