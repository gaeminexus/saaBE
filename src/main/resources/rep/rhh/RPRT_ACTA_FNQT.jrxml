			<box rightPadding="4"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="staticText" uuid="c5000000-0000-0000-0000-000000000203" mode="Opaque" x="335" y="4" width="80" height="20" backcolor="#EDF2F7" forecolor="#4A5568" fontName="Tahoma" fontSize="7.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<text><![CDATA[Dias / anios]]></text>
			<box rightPadding="4"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
