<!-- Acta de finiquito de un ex-colaborador de la administracion anterior (RHH.LQEX/RHH.DLEX).
     Copia del layout de RPRT_ACTA_FNQT.jrxml (RHH.LQDC/RHH.TMLQ), adaptada a la cabecera y el
     detalle de e3-05. Ver docs/logica-negocio/rhh/API-LIQUIDACION-EXCOLABORADORES.md §7.
     Diferencias deliberadas contra el original:
       - Sin ACTA_SUT (LQEX no tiene esa columna): el titulo siempre dice "Pendiente de registro".
       - Sin columnas Base/Dias en el detalle (DLEX no las tiene, D1: los valores ya vienen
         calculados, no hay base de calculo que mostrar): el detalle queda en dos columnas,
         Concepto y Valor.
       - Sin el aviso de "saldo a favor del empleador": CK_LQEXNETO exige NETO > 0, esa rama
         es inalcanzable aqui (en LQDC el neto negativo si es posible). -->
<jasperReport name="RPRT_ACTA_FNQT_EXCL" language="java" pageWidth="595" pageHeight="842" columnWidth="545" leftMargin="25" rightMargin="25" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection" uuid="e3050000-0000-0000-0000-000000000000">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Oracle"/>
	<property name="com.jaspersoft.studio.report.description" value="Acta de finiquito de un ex-colaborador de la administracion anterior: conceptos, totales y firmas."/>
	<parameter name="P_LQEX_CODIGO" class="java.lang.Long">
		<description><![CDATA[Codigo de la liquidacion (RHH.LQEX.LQEXCDGO)]]></description>
	</parameter>
	<parameter name="P_IMAGEN" class="java.awt.Image">
		<description><![CDATA[Logo del fondo. Lo inyecta ReporteServiceImpl si el frontend no lo envia.]]></description>
	</parameter>
	<parameter name="P_USUARIO" class="java.lang.String">
		<description><![CDATA[Usuario que genera el reporte (opcional)]]></description>
	</parameter>
	<query language="SQL"><![CDATA[SELECT
    l.LQEXCDGO                                                        AS LIQUIDACION,
    l.LQEXFCSL                                                        AS FECHA_SALIDA,
    l.LQEXFCIN                                                        AS FECHA_INGRESO,
    NVL(ROUND(MONTHS_BETWEEN(l.LQEXFCSL, l.LQEXFCIN) / 12, 2), 0)     AS ANIOS_SERVICIO,
    NVL(l.LQEXULRM, 0)                                                AS ULTIMA_REMUNERACION,
    NVL(l.LQEXTTIN, 0)                                                AS TOTAL_INGRESOS,
    NVL(l.LQEXTTDS, 0)                                                AS TOTAL_DESCUENTOS,
    NVL(l.LQEXNETO, 0)                                                AS NETO,
    ' '                                                                AS ACTA_SUT,
    l.LQEXIDNT                                                        AS IDENTIFICACION,
    NVL(l.LQEXAPLL, ' ') || ' ' || NVL(l.LQEXNMBR, ' ')               AS EMPLEADO,
    NVL(c.CSTRNMBR, '(sin causal registrada)')                        AS CAUSAL,
    NVL(c.CSTRARTC, ' ')                                              AS ARTICULO,
    NVL(d.DLEXDSCR, CASE d.DLEXTPCN
        WHEN 1  THEN 'Remuneracion pendiente'
        WHEN 2  THEN 'Vacaciones no gozadas'
        WHEN 3  THEN 'Decimo tercer sueldo'
        WHEN 4  THEN 'Decimo cuarto sueldo'
        WHEN 5  THEN 'Fondos de reserva'
        WHEN 6  THEN 'Bonificacion por desahucio'
        WHEN 7  THEN 'Indemnizacion por despido intempestivo'
        WHEN 8  THEN 'Participacion de utilidades'
        WHEN 9  THEN 'Compensacion economica salario digno'
        WHEN 10 THEN 'Otro ingreso gravado de IR'
        WHEN 11 THEN 'Otro ingreso no gravado de IR'
        WHEN 20 THEN 'Aporte personal al IESS'
        WHEN 21 THEN 'Retencion de impuesto a la renta'
        WHEN 22 THEN 'Anticipo de quincena'
        WHEN 23 THEN 'Anticipo de remuneracion'
        WHEN 24 THEN 'Otros conceptos por cobrar'
        WHEN 25 THEN 'Otros ingresos (uniformes y similares)'
        ELSE 'Concepto ' || d.DLEXTPCN
    END)                                                               AS RUBRO,
    NVL(d.DLEXTPCN, 1)                                                AS TIPO_CONCEPTO,
    NVL(d.DLEXVLOR, 0)                                                AS VALOR,
    NVL(d.DLEXORDN, 0)                                                AS ORDEN
FROM RHH.LQEX l
     LEFT JOIN RHH.CSTR c ON c.CSTRCDGO = l.LQEXCSTR
     LEFT JOIN RHH.DLEX d ON d.LQEXCDGO = l.LQEXCDGO
WHERE l.LQEXCDGO = $P{P_LQEX_CODIGO}
ORDER BY NVL(d.DLEXORDN, 0), d.DLEXCDGO]]></query>
	<field name="LIQUIDACION" class="java.math.BigDecimal"/>
	<field name="FECHA_SALIDA" class="java.sql.Timestamp"/>
	<field name="FECHA_INGRESO" class="java.sql.Timestamp"/>
	<field name="ANIOS_SERVICIO" class="java.math.BigDecimal"/>
	<field name="ULTIMA_REMUNERACION" class="java.math.BigDecimal"/>
	<field name="TOTAL_INGRESOS" class="java.math.BigDecimal"/>
	<field name="TOTAL_DESCUENTOS" class="java.math.BigDecimal"/>
	<field name="NETO" class="java.math.BigDecimal"/>
	<field name="ACTA_SUT" class="java.lang.String"/>
	<field name="IDENTIFICACION" class="java.lang.String"/>
	<field name="EMPLEADO" class="java.lang.String"/>
	<field name="CAUSAL" class="java.lang.String"/>
	<field name="ARTICULO" class="java.lang.String"/>
	<field name="RUBRO" class="java.lang.String"/>
	<field name="TIPO_CONCEPTO" class="java.math.BigDecimal"/>
	<field name="VALOR" class="java.math.BigDecimal"/>
	<field name="ORDEN" class="java.math.BigDecimal"/>
	<background splitType="Stretch"/>
	<title height="170" splitType="Stretch">
		<element kind="image" uuid="e3050000-0000-0000-0000-000000000101" x="0" y="4" width="110" height="52" scaleImage="RetainShape" onErrorType="Blank" hImageAlign="Center" vImageAlign="Middle">
			<expression><![CDATA[$P{P_IMAGEN}]]></expression>
		</element>
		<element kind="rectangle" uuid="e3050000-0000-0000-0000-000000000102" x="118" y="4" width="427" height="52">
			<pen lineWidth="0.75" lineColor="#CBD5E0"/>
		</element>
		<element kind="staticText" uuid="e3050000-0000-0000-0000-000000000103" x="128" y="10" width="407" height="24" forecolor="#1A202C" fontName="Tahoma" fontSize="15.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
			<text><![CDATA[ACTA DE FINIQUITO]]></text>
		</element>
		<element kind="textField" uuid="e3050000-0000-0000-0000-000000000104" x="128" y="34" width="407" height="16" forecolor="#718096" fontName="Tahoma" fontSize="9.0" hTextAlign="Center" vTextAlign="Middle">
			<expression><![CDATA[$F{ACTA_SUT}.trim().length() > 0 ? ("Acta SUT " + $F{ACTA_SUT}) : "Pendiente de registro en el SUT"]]></expression>
		</element>
		<element kind="textField" uuid="e3050000-0000-0000-0000-000000000105" x="395" y="60" width="150" height="11" forecolor="#718096" fontSize="6.5" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA["Generado: " + new java.text.SimpleDateFormat("d/M/yyyy h:mm a").format(new java.util.Date()) + ($P{P_USUARIO} != null ? ("  ·  Por: " + $P{P_USUARIO}) : "")]]></expression>
		</element>
		<element kind="staticText" uuid="e3050000-0000-0000-0000-000000000110" mode="Opaque" x="0" y="78" width="545" height="14" backcolor="#EDF2F7" forecolor="#4A5568" fontName="Tahoma" fontSize="8.0" bold="true" vTextAlign="Middle">
			<text><![CDATA[DATOS DE LA RELACION LABORAL — EX-COLABORADOR (ADMINISTRACION ANTERIOR)]]></text>
			<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="staticText" uuid="e3050000-0000-0000-0000-000000000111" mode="Opaque" x="0" y="92" width="100" height="14" backcolor="#F7FAFC" fontName="Tahoma" fontSize="7.5" bold="true" vTextAlign="Middle">
			<text><![CDATA[Trabajador]]></text>
			<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="textField" uuid="e3050000-0000-0000-0000-000000000112" x="100" y="92" width="260" height="14" fontName="Tahoma" fontSize="7.5" blankWhenNull="true" vTextAlign="Middle">
			<expression><![CDATA[$F{EMPLEADO}]]></expression>
			<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="staticText" uuid="e3050000-0000-0000-0000-000000000113" mode="Opaque" x="360" y="92" width="80" height="14" backcolor="#F7FAFC" fontName="Tahoma" fontSize="7.5" bold="true" vTextAlign="Middle">
			<text><![CDATA[Cedula]]></text>
			<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="textField" uuid="e3050000-0000-0000-0000-000000000114" x="440" y="92" width="105" height="14" fontName="Tahoma" fontSize="7.5" blankWhenNull="true" vTextAlign="Middle">
			<expression><![CDATA[$F{IDENTIFICACION}]]></expression>
			<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="staticText" uuid="e3050000-0000-0000-0000-000000000115" mode="Opaque" x="0" y="106" width="100" height="14" backcolor="#F7FAFC" fontName="Tahoma" fontSize="7.5" bold="true" vTextAlign="Middle">
			<text><![CDATA[Ingreso / Salida]]></text>
			<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="textField" uuid="e3050000-0000-0000-0000-000000000116" x="100" y="106" width="260" height="14" fontName="Tahoma" fontSize="7.5" blankWhenNull="true" vTextAlign="Middle">
			<expression><![CDATA[($F{FECHA_INGRESO} != null ? new java.text.SimpleDateFormat("d/M/yyyy").format($F{FECHA_INGRESO}) : "?")
+ "   al   " + new java.text.SimpleDateFormat("d/M/yyyy").format($F{FECHA_SALIDA})]]></expression>
			<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="staticText" uuid="e3050000-0000-0000-0000-000000000117" mode="Opaque" x="360" y="106" width="80" height="14" backcolor="#F7FAFC" fontName="Tahoma" fontSize="7.5" bold="true" vTextAlign="Middle">
			<text><![CDATA[Anios]]></text>
			<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="textField" uuid="e3050000-0000-0000-0000-000000000118" x="440" y="106" width="105" height="14" pattern="#,##0.00" fontName="Tahoma" fontSize="7.5" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA[$F{ANIOS_SERVICIO}]]></expression>
			<box rightPadding="8"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="staticText" uuid="e3050000-0000-0000-0000-000000000119" mode="Opaque" x="0" y="120" width="100" height="14" backcolor="#F7FAFC" fontName="Tahoma" fontSize="7.5" bold="true" vTextAlign="Middle">
			<text><![CDATA[Causal]]></text>
			<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="textField" uuid="e3050000-0000-0000-0000-00000000011a" x="100" y="120" width="340" height="14" fontName="Tahoma" fontSize="7.5" blankWhenNull="true" vTextAlign="Middle">
			<expression><![CDATA[$F{CAUSAL} + ($F{ARTICULO}.trim().length() > 0 ? ("   (" + $F{ARTICULO} + ")") : "")]]></expression>
			<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="staticText" uuid="e3050000-0000-0000-0000-00000000011b" mode="Opaque" x="440" y="120" width="105" height="14" backcolor="#F7FAFC" fontName="Tahoma" fontSize="7.5" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<text><![CDATA[Ult. remuneracion]]></text>
			<box rightPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="textField" uuid="e3050000-0000-0000-0000-00000000011c" x="0" y="140" width="545" height="26" forecolor="#4A5568" fontName="Tahoma" fontSize="7.5" textAdjust="StretchHeight" vTextAlign="Middle">
			<expression><![CDATA["Ultima remuneracion mensual: " + new java.text.DecimalFormat("$#,##0.00").format($F{ULTIMA_REMUNERACION}.doubleValue())
+ ". Los conceptos que siguen ya vienen calculados de la administracion anterior, no los calcula el sistema."]]></expression>
		</element>
