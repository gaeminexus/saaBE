<!-- Planilla del IESS - reporte de control (RHH). Ver docs/logica-negocio/reportes/REPORTE-PLANILLA-IESS-CONTROL.md -->
<jasperReport name="RPRT_IESS_CNTR" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="792" leftMargin="25" rightMargin="25" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection" uuid="c7000000-0000-0000-0000-000000000000">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Oracle"/>
	<property name="com.jaspersoft.studio.report.description" value="Control de la planilla del IESS de un periodo: por empleado y por codigo IESS del concepto, para cuadrar contra la planilla emitida."/>
	<parameter name="P_PRDN_CODIGO" class="java.lang.Long">
		<description><![CDATA[Codigo del periodo de nomina (RHH.PRDN.PRDNCDGO)]]></description>
	</parameter>
	<parameter name="P_IMAGEN" class="java.awt.Image">
		<description><![CDATA[Logo del fondo. Lo inyecta ReporteServiceImpl si el frontend no lo envia.]]></description>
	</parameter>
	<parameter name="P_USUARIO" class="java.lang.String">
		<description><![CDATA[Usuario que genera el reporte (opcional)]]></description>
	</parameter>
	<query language="SQL"><![CDATA[SELECT
    p.PRDNANOO                                                        AS PERIODO_ANIO,
    p.PRDNMSEE                                                        AS PERIODO_MES,
    e.MPLDIDNT                                                        AS IDENTIFICACION,
    NVL(e.MPLDCDAF, ' ')                                              AS CODIGO_AFILIACION,
    NVL(e.MPLDAPLL, ' ') || ' ' || NVL(e.MPLDNMBR, ' ')               AS EMPLEADO,
    NVL(c.CPNMIESS, '(sin codigo IESS)')                              AS CODIGO_IESS,
    c.CPNMNMBR                                                        AS CONCEPTO,
    NVL(c.CPNMTPCN, 1)                                                AS TIPO_CONCEPTO,
    CASE NVL(c.CPNMTPCN, 1)
        WHEN 1 THEN 'Ingreso'
        WHEN 2 THEN 'Descuento'
        WHEN 3 THEN 'Aporte patronal'
        ELSE 'Otro'
    END                                                              AS TIPO_CONCEPTO_TXT,
    NVL(n.NMNABSIE, 0)                                                AS BASE_IESS,
    NVL(r.RNGLVLRO, 0)                                                AS VALOR
FROM RHH.PRDN p
     JOIN RHH.NMNA n ON n.PRDNCDGO = p.PRDNCDGO
     JOIN RHH.MPLD e ON e.MPLDCDGO = n.MPLDCDGO
     JOIN RHH.RNGL r ON r.NMNACDGO = n.NMNACDGO
     JOIN RHH.CPNM c ON c.CPNMCDGO = r.CPNMCDGO
WHERE p.PRDNCDGO = $P{P_PRDN_CODIGO}
  AND c.CPNMIESS IS NOT NULL
ORDER BY e.MPLDAPLL, e.MPLDNMBR, c.CPNMIESS]]></query>
	<field name="PERIODO_ANIO" class="java.math.BigDecimal"/>
	<field name="PERIODO_MES" class="java.math.BigDecimal"/>
	<field name="IDENTIFICACION" class="java.lang.String"/>
	<field name="CODIGO_AFILIACION" class="java.lang.String"/>
	<field name="EMPLEADO" class="java.lang.String"/>
	<field name="CODIGO_IESS" class="java.lang.String"/>
	<field name="CONCEPTO" class="java.lang.String"/>
	<field name="TIPO_CONCEPTO" class="java.math.BigDecimal"/>
	<field name="TIPO_CONCEPTO_TXT" class="java.lang.String"/>
	<field name="BASE_IESS" class="java.math.BigDecimal"/>
	<field name="VALOR" class="java.math.BigDecimal"/>
	<variable name="V_TOTAL" class="java.math.BigDecimal" calculation="Sum" resetType="Report">
		<expression><![CDATA[$F{VALOR}]]></expression>
	</variable>
	<variable name="V_TOTAL_EMPLEADO" class="java.math.BigDecimal" calculation="Sum" resetType="Group" resetGroup="G_EMPLEADO">
		<expression><![CDATA[$F{VALOR}]]></expression>
	</variable>
	<group name="G_EMPLEADO" minHeightToStartNewPage="50">
		<expression><![CDATA[$F{IDENTIFICACION}]]></expression>
		<groupHeader>
			<band height="18">
				<element kind="textField" uuid="c7000000-0000-0000-0000-000000000701" mode="Opaque" x="0" y="2" width="792" height="14" backcolor="#EDF2F7" forecolor="#1A202C" fontName="Tahoma" fontSize="7.5" bold="true" vTextAlign="Middle">
					<expression><![CDATA[$F{EMPLEADO} + "   ·   " + $F{IDENTIFICACION}
+ ($F{CODIGO_AFILIACION}.trim().length() > 0 ? ("   ·   afiliacion " + $F{CODIGO_AFILIACION}) : "")
+ "   ·   base imponible " + new java.text.DecimalFormat("$#,##0.00").format($F{BASE_IESS}.doubleValue())]]></expression>
					<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
				</element>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="18">
				<element kind="staticText" uuid="c7000000-0000-0000-0000-000000000711" x="0" y="0" width="618" height="14" forecolor="#4A5568" fontName="Tahoma" fontSize="7.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
					<text><![CDATA[Subtotal del empleado]]></text>
					<box rightPadding="8"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
				</element>
				<element kind="textField" uuid="c7000000-0000-0000-0000-000000000712" x="618" y="0" width="174" height="14" pattern="$#,##0.00" fontName="Tahoma" fontSize="7.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
					<expression><![CDATA[$V{V_TOTAL_EMPLEADO}]]></expression>
					<box rightPadding="8"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
				</element>
			</band>
		</groupFooter>
	</group>
	<background splitType="Stretch"/>
	<title height="88" splitType="Stretch">
		<element kind="image" uuid="c7000000-0000-0000-0000-000000000101" x="0" y="4" width="110" height="52" scaleImage="RetainShape" onErrorType="Blank" hImageAlign="Center" vImageAlign="Middle">
			<expression><![CDATA[$P{P_IMAGEN}]]></expression>
		</element>
		<element kind="rectangle" uuid="c7000000-0000-0000-0000-000000000102" x="118" y="4" width="674" height="52">
			<pen lineWidth="0.75" lineColor="#CBD5E0"/>
		</element>
		<element kind="staticText" uuid="c7000000-0000-0000-0000-000000000103" x="128" y="8" width="654" height="22" forecolor="#1A202C" fontName="Tahoma" fontSize="14.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
			<text><![CDATA[PLANILLA DEL IESS — REPORTE DE CONTROL]]></text>
		</element>
		<element kind="textField" uuid="c7000000-0000-0000-0000-000000000104" x="128" y="32" width="654" height="16" forecolor="#718096" fontName="Tahoma" fontSize="9.0" hTextAlign="Center" vTextAlign="Middle">
			<expression><![CDATA["Periodo " + ($F{PERIODO_MES} != null ? $F{PERIODO_MES}.toBigInteger().toString() : "?") + "/" + ($F{PERIODO_ANIO} != null ? $F{PERIODO_ANIO}.toBigInteger().toString() : "?")]]></expression>
		</element>
		<element kind="textField" uuid="c7000000-0000-0000-0000-000000000105" x="592" y="58" width="200" height="11" forecolor="#718096" fontSize="6.5" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA["Generado: " + new java.text.SimpleDateFormat("d/M/yyyy h:mm a").format(new java.util.Date()) + ($P{P_USUARIO} != null ? ("  ·  Por: " + $P{P_USUARIO}) : "")]]></expression>
		</element>
		<element kind="staticText" uuid="c7000000-0000-0000-0000-000000000106" x="0" y="70" width="792" height="14" forecolor="#4A5568" fontName="Tahoma" fontSize="7.0" vTextAlign="Middle">
			<text><![CDATA[Agrupado por el codigo IESS declarado en cada concepto (CPNMIESS). Un concepto sin codigo no aparece: no forma parte de la planilla.]]></text>
		</element>
	</title>
	<pageHeader height="4" splitType="Stretch"/>
	<columnHeader height="26" splitType="Stretch">
		<element kind="staticText" uuid="c7000000-0000-0000-0000-000000000201" mode="Opaque" x="0" y="4" width="110" height="20" backcolor="#F7FAFC" forecolor="#4A5568" fontName="Tahoma" fontSize="6.5" bold="true" vTextAlign="Middle">
			<text><![CDATA[Codigo IESS]]></text>
			<box leftPadding="4"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="staticText" uuid="c7000000-0000-0000-0000-000000000202" mode="Opaque" x="110" y="4" width="378" height="20" backcolor="#F7FAFC" forecolor="#4A5568" fontName="Tahoma" fontSize="6.5" bold="true" vTextAlign="Middle">
			<text><![CDATA[Concepto]]></text>
			<box leftPadding="4"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="staticText" uuid="c7000000-0000-0000-0000-000000000203" mode="Opaque" x="488" y="4" width="130" height="20" backcolor="#F7FAFC" forecolor="#4A5568" fontName="Tahoma" fontSize="6.5" bold="true" vTextAlign="Middle">
			<text><![CDATA[Tipo]]></text>
			<box leftPadding="4"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="staticText" uuid="c7000000-0000-0000-0000-000000000204" mode="Opaque" x="618" y="4" width="174" height="20" backcolor="#F7FAFC" forecolor="#4A5568" fontName="Tahoma" fontSize="6.5" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<text><![CDATA[Valor]]></text>
			<box rightPadding="4"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
	</columnHeader>
	<detail>
		<band height="14" splitType="Prevent">
			<element kind="textField" uuid="c7000000-0000-0000-0000-000000000301" x="0" y="0" width="110" height="14" fontName="Tahoma" fontSize="6.5" blankWhenNull="true" vTextAlign="Middle">
				<expression><![CDATA[$F{CODIGO_IESS}]]></expression>
				<box leftPadding="4"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
			</element>
			<element kind="textField" uuid="c7000000-0000-0000-0000-000000000302" x="110" y="0" width="378" height="14" fontName="Tahoma" fontSize="6.5" blankWhenNull="true" vTextAlign="Middle">
				<expression><![CDATA[$F{CONCEPTO}]]></expression>
				<box leftPadding="4"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
			</element>
			<element kind="textField" uuid="c7000000-0000-0000-0000-000000000303" x="488" y="0" width="130" height="14" fontName="Tahoma" fontSize="6.5" blankWhenNull="true" vTextAlign="Middle">
				<expression><![CDATA[$F{TIPO_CONCEPTO_TXT}]]></expression>
				<box leftPadding="4"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
			</element>
			<element kind="textField" uuid="c7000000-0000-0000-0000-000000000304" x="618" y="0" width="174" height="14" pattern="$#,##0.00" fontName="Tahoma" fontSize="6.5" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA[$F{VALOR}]]></expression>
				<box rightPadding="4"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
			</element>
		</band>
	</detail>
	<pageFooter height="24" splitType="Stretch">
		<element kind="line" uuid="c7000000-0000-0000-0000-000000000401" x="0" y="4" width="792" height="1">
			<pen lineWidth="0.25" lineColor="#E2E8F0"/>
		</element>
		<element kind="staticText" uuid="c7000000-0000-0000-0000-000000000402" x="0" y="8" width="600" height="12" forecolor="#A0AEC0" fontName="Tahoma" fontSize="6.5" vTextAlign="Middle">
			<text><![CDATA[ASOPREP-FCPC · Sistema de Administracion de Aportes (SAA) · Documento generado desde el sistema.]]></text>
		</element>
		<element kind="textField" uuid="c7000000-0000-0000-0000-000000000403" x="620" y="8" width="130" height="12" forecolor="#A0AEC0" fontSize="7.0" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA["Pagina " + $V{PAGE_NUMBER} + " de"]]></expression>
		</element>
		<element kind="textField" uuid="c7000000-0000-0000-0000-000000000404" x="752" y="8" width="40" height="12" forecolor="#A0AEC0" fontSize="7.0" evaluationTime="Report" hTextAlign="Left" vTextAlign="Middle">
			<expression><![CDATA[" " + $V{PAGE_NUMBER}]]></expression>
		</element>
	</pageFooter>
	<summary height="70" splitType="Stretch">
		<element kind="staticText" uuid="c7000000-0000-0000-0000-000000000501" mode="Opaque" x="0" y="0" width="618" height="16" backcolor="#EDF2F7" forecolor="#1A202C" fontName="Tahoma" fontSize="7.5" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<text><![CDATA[TOTAL DEL PERIODO]]></text>
			<box rightPadding="8"><pen lineWidth="0.5" lineColor="#4A5568"/></box>
		</element>
		<element kind="textField" uuid="c7000000-0000-0000-0000-000000000502" mode="Opaque" x="618" y="0" width="174" height="16" backcolor="#EDF2F7" pattern="$#,##0.00" fontName="Tahoma" fontSize="7.5" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA[$V{V_TOTAL}]]></expression>
			<box rightPadding="8"><pen lineWidth="0.5" lineColor="#4A5568"/></box>
		</element>
		<element kind="staticText" uuid="c7000000-0000-0000-0000-000000000510" x="0" y="24" width="792" height="40" forecolor="#4A5568" fontName="Tahoma" fontSize="7.5" vTextAlign="Top">
			<text><![CDATA[Este es el reporte de CONTROL, no el archivo de carga: el formato del archivo del IESS sigue pendiente del cliente. Sirve para cuadrar contra la planilla emitida por el IESS, que es el criterio de aceptacion 2 del documento maestro. Para el cuadre por totales de aporte personal, patronal, IECE y SECAP, use ademas el resumen de aportes (RPRT_APRT_RSMN).]]></text>
		</element>
	</summary>
	<noData height="140" splitType="Stretch">
		<element kind="image" uuid="c7000000-0000-0000-0000-000000000601" x="0" y="4" width="110" height="52" scaleImage="RetainShape" onErrorType="Blank" hImageAlign="Center" vImageAlign="Middle">
			<expression><![CDATA[$P{P_IMAGEN}]]></expression>
		</element>
		<element kind="staticText" uuid="c7000000-0000-0000-0000-000000000602" mode="Opaque" x="0" y="80" width="792" height="16" backcolor="#EDF2F7" forecolor="#4A5568" fontName="Tahoma" fontSize="9.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
			<text><![CDATA[SIN INFORMACION PARA PRESENTAR]]></text>
			<box><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="textField" uuid="c7000000-0000-0000-0000-000000000603" x="0" y="100" width="792" height="26" fontName="Tahoma" fontSize="8.0" textAdjust="StretchHeight" hTextAlign="Center" vTextAlign="Middle">
			<expression><![CDATA["El periodo " + ($P{P_PRDN_CODIGO} != null ? String.valueOf($P{P_PRDN_CODIGO}) : "(nulo)")
+ " no tiene renglones con codigo IESS. Compruebe que los conceptos de nomina tengan informado CPNMIESS."]]></expression>
		</element>
	</noData>
</jasperReport>
