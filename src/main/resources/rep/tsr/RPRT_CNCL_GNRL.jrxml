				<expression><![CDATA[$F{EMPRESA}]]></expression>
			</element>
			<element kind="staticText" uuid="b0000010-0001-0001-0001-000000000003"
					x="420" y="0" width="70" height="13" fontName="Tahoma" fontSize="8.0" bold="true" vTextAlign="Middle">
				<text><![CDATA[PERÍODO:]]></text>
