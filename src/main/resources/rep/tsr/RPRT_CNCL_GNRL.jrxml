    : ("N".equals($F{EXTRACTO_CARGADO}) ? "SIN EXTRACTO"
        : (( ($F{PEND_EXTRACTO} != null && $F{PEND_EXTRACTO}.intValue() > 0)
             || ($F{PEND_ASIENTO} != null && $F{PEND_ASIENTO}.intValue() > 0) )
            ? "PENDIENTES" : "OK"))]]></expression>
				<style backcolor="#FFFFFF">
					<conditionalStyle>
						<conditionExpression><![CDATA[$F{FECHA_CIERRE} == null
    || "N".equals($F{EXTRACTO_CARGADO})
    || ($F{PEND_EXTRACTO} != null && $F{PEND_EXTRACTO}.intValue() > 0)
    || ($F{PEND_ASIENTO} != null && $F{PEND_ASIENTO}.intValue() > 0)]]></conditionExpression>
