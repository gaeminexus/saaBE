<?xml version="1.0" encoding="UTF-8"?>
<!-- Conciliación general del período (todas las cuentas de una empresa). Ver
     docs/logica-negocio/tsr/DISENO-REPORTES-CONCILIACION-BANCARIA.md #3.

     Mismo diseño que RPRT_CNCL_CNTA: una sola consulta UNION ALL (ORDEN_SECCION=1 fila por
     cuenta, ORDEN_SECCION=2 resumen de partidas pendientes por tipo) en vez de subdatasets,
     por la misma razón documentada ahí (cero precedente local de subDataset/datasetRun). -->
<jasperReport name="RPRT_CNCL_GNRL" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="f2b3c4d5-2222-3333-4444-555566667777">
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageHeight" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.topMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.bottomMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.leftMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.rightMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnWidth" value="pixel"/>

	<parameter name="P_PATH" class="java.lang.String"/>
	<parameter name="P_REPORTE" class="java.lang.String"/>
	<parameter name="P_PJRQ_CODIGO" class="java.lang.Long"/>
	<parameter name="P_PRDO_CODIGO" class="java.lang.Long"/>
	<parameter name="P_USUARIO" class="java.lang.String"/>
	<parameter name="P_IMAGEN" class="java.awt.Image"/>

	<query language="sql"><![CDATA[
SELECT * FROM (
  -- ===== SECCION 1: una fila por cuenta bancaria activa de la empresa =====
  SELECT
    1 AS ORDEN_SECCION,
    e.PJRQNMBR AS EMPRESA,
    p.PRDONMBR AS PERIODO, p.PRDOINCO AS DESDE, p.PRDOFNN AS HASTA,
    ct.CTEBCRRE AS MES_CERRADO, ct.CTEBUSCR AS MES_CERRADO_POR, ct.CTEBFCCR AS MES_CERRADO_EL,
    b.BNCONMBR AS BANCO, c.CNBCNMRO AS NUMERO_CUENTA,
    pc.PLNNCNTA AS CUENTA_CONTABLE, pc.PLNNNMBR AS NOMBRE_CUENTA,
    -- EXTRACTO_CARGADO: misma regla que ExtractoBancarioDaoService.selectCuentasConCobertura
    -- (la que usa el Tablero de Cumplimiento) -- solapamiento de rango, no fecha de linea DEXB.
    (CASE WHEN EXISTS (SELECT 1 FROM TSR.EXBC x
                        WHERE x.CNBCCDGO = c.CNBCCDGO AND x.EXBCESTD = 1 AND x.EXBCESTP <> 4
                          AND x.EXBCFDSD <= p.PRDOFNN AND x.EXBCFHST >= p.PRDOINCO)
          THEN 'S' ELSE 'N' END) AS EXTRACTO_CARGADO,
    ci.CNCLSLDF AS SALDO_LIBROS, ci.CNCLDPTR AS DEPOSITOS_TRANSITO, ci.CNCLCHNC AS CHEQUES_NO_COBRADOS,
    ci.CNCLNCTR AS NC_NO_REGISTRADAS, ci.CNCLNDTR AS ND_NO_REGISTRADAS,
    (NVL(ci.CNCLSLDF,0) - NVL(ci.CNCLDPTR,0) + NVL(ci.CNCLCHNC,0) + NVL(ci.CNCLNCTR,0) - NVL(ci.CNCLNDTR,0)) AS SALDO_EXTRACTO_ESPERADO,
    ci.CNCLSLDE AS SALDO_EXTRACTO,
    ci.CNCLFCCR AS FECHA_CIERRE, ci.CNCLUSCR AS USUARIO_CIERRE,
    cc.CNCTESTR AS ESTADO_REVISION, cc.CNCTUSVR AS VERIFICADO_POR, cc.CNCTFCVR AS FECHA_VERIFICACION,
    cc.CNCTPDEX AS PEND_EXTRACTO, cc.CNCTPDAS AS PEND_ASIENTO, cc.CNCTTTGR AS TOTAL_GRUPOS,
    CAST(NULL AS NUMBER) AS R_TIPO, CAST(NULL AS VARCHAR2(60)) AS R_TIPO_NOMBRE,
    CAST(NULL AS NUMBER) AS R_CANTIDAD, CAST(NULL AS NUMBER) AS R_VALOR
  FROM CNT.PRDO p
  JOIN SCP.PJRQ e  ON e.PJRQCDGO = p.PJRQCDGO
  JOIN TSR.BNCO b  ON b.PJRQCDGO = e.PJRQCDGO
  JOIN TSR.CNBC c  ON c.BNCOCDGO = b.BNCOCDGO AND c.CNBCESTD = 1
  JOIN CNT.PLNN pc ON pc.PLNNCDGO = c.PLNNCDGO
  LEFT JOIN TSR.CNCL ci ON ci.CNCLCDGO = (
      SELECT MAX(x.CNCLCDGO) KEEP (DENSE_RANK LAST ORDER BY x.CNCLFCCR)
        FROM TSR.CNCL x
       WHERE x.CNBCCDGO = c.CNBCCDGO AND x.CNCLPRDO = p.PRDOCDGO AND x.CNCLESTD = 2)
  LEFT JOIN TSR.CNCT cc ON cc.CNBCCDGO = c.CNBCCDGO AND cc.PRDOCDGO = p.PRDOCDGO
  LEFT JOIN TSR.CTEB ct ON ct.PJRQCDGO = p.PJRQCDGO AND ct.PRDOCDGO = p.PRDOCDGO
  WHERE p.PRDOCDGO = $P{P_PRDO_CODIGO}
    AND p.PJRQCDGO = $P{P_PJRQ_CODIGO}

  UNION ALL

  -- ===== SECCION 2: resumen de partidas pendientes de toda la empresa, por tipo =====
  SELECT
    2,
    CAST(NULL AS VARCHAR2(200)), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS DATE), CAST(NULL AS DATE),
    CAST(NULL AS NUMBER), CAST(NULL AS VARCHAR2(50)), CAST(NULL AS DATE),
    CAST(NULL AS VARCHAR2(200)), CAST(NULL AS VARCHAR2(60)), CAST(NULL AS VARCHAR2(60)), CAST(NULL AS VARCHAR2(200)),
    CAST(NULL AS VARCHAR2(1)),
    CAST(NULL AS NUMBER), CAST(NULL AS NUMBER), CAST(NULL AS NUMBER), CAST(NULL AS NUMBER), CAST(NULL AS NUMBER),
    CAST(NULL AS NUMBER), CAST(NULL AS NUMBER),
    CAST(NULL AS DATE), CAST(NULL AS VARCHAR2(60)),
    CAST(NULL AS NUMBER), CAST(NULL AS VARCHAR2(50)), CAST(NULL AS DATE),
    CAST(NULL AS NUMBER), CAST(NULL AS NUMBER), CAST(NULL AS NUMBER),
    dt.DTCNTPOO AS R_TIPO,
    CASE dt.DTCNTPOO WHEN 1 THEN 'Depósitos en tránsito'
                     WHEN 2 THEN 'Cheques girados no cobrados'
                     WHEN 3 THEN 'Notas de crédito del banco no registradas'
                     WHEN 4 THEN 'Notas de débito del banco no registradas' END AS R_TIPO_NOMBRE,
    COUNT(*) AS R_CANTIDAD, SUM(dt.DTCNVLOR) AS R_VALOR
  FROM TSR.DTCN dt
  JOIN TSR.CNCL ci ON ci.CNCLCDGO = dt.CNCLCDGO
  JOIN CNT.PRDO po ON po.PRDOCDGO = ci.CNCLPRDO
  WHERE ci.PJRQCDGO = $P{P_PJRQ_CODIGO}
    AND ci.CNCLESTD = 2
    AND dt.DTCNESTD = 1
    AND po.PRDOINCO <= (SELECT q.PRDOFNN FROM CNT.PRDO q WHERE q.PRDOCDGO = $P{P_PRDO_CODIGO})
  GROUP BY dt.DTCNTPOO
)
ORDER BY ORDEN_SECCION, BANCO, NUMERO_CUENTA, R_TIPO
]]></query>

	<field name="ORDEN_SECCION" class="java.math.BigDecimal"/>
	<field name="EMPRESA" class="java.lang.String"/>
	<field name="PERIODO" class="java.lang.String"/>
	<field name="DESDE" class="java.sql.Timestamp"/>
	<field name="HASTA" class="java.sql.Timestamp"/>
	<field name="MES_CERRADO" class="java.math.BigDecimal"/>
	<field name="MES_CERRADO_POR" class="java.lang.String"/>
	<field name="MES_CERRADO_EL" class="java.sql.Timestamp"/>
	<field name="BANCO" class="java.lang.String"/>
	<field name="NUMERO_CUENTA" class="java.lang.String"/>
	<field name="CUENTA_CONTABLE" class="java.lang.String"/>
	<field name="NOMBRE_CUENTA" class="java.lang.String"/>
	<field name="EXTRACTO_CARGADO" class="java.lang.String"/>
	<field name="SALDO_LIBROS" class="java.math.BigDecimal"/>
	<field name="DEPOSITOS_TRANSITO" class="java.math.BigDecimal"/>
	<field name="CHEQUES_NO_COBRADOS" class="java.math.BigDecimal"/>
	<field name="NC_NO_REGISTRADAS" class="java.math.BigDecimal"/>
	<field name="ND_NO_REGISTRADAS" class="java.math.BigDecimal"/>
	<field name="SALDO_EXTRACTO_ESPERADO" class="java.math.BigDecimal"/>
	<field name="SALDO_EXTRACTO" class="java.math.BigDecimal"/>
	<field name="FECHA_CIERRE" class="java.sql.Timestamp"/>
	<field name="USUARIO_CIERRE" class="java.lang.String"/>
	<field name="ESTADO_REVISION" class="java.math.BigDecimal"/>
	<field name="VERIFICADO_POR" class="java.lang.String"/>
	<field name="FECHA_VERIFICACION" class="java.sql.Timestamp"/>
	<field name="PEND_EXTRACTO" class="java.math.BigDecimal"/>
	<field name="PEND_ASIENTO" class="java.math.BigDecimal"/>
	<field name="TOTAL_GRUPOS" class="java.math.BigDecimal"/>
	<field name="R_TIPO" class="java.math.BigDecimal"/>
	<field name="R_TIPO_NOMBRE" class="java.lang.String"/>
	<field name="R_CANTIDAD" class="java.math.BigDecimal"/>
	<field name="R_VALOR" class="java.math.BigDecimal"/>

	<variable name="CUENTAS_ACTIVAS" resetType="Report" calculation="Count" class="java.lang.Integer">
		<expression><![CDATA[$F{ORDEN_SECCION}.intValue() == 1 ? $F{NUMERO_CUENTA} : null]]></expression>
	</variable>
	<variable name="CUENTAS_VERIFICADAS" resetType="Report" calculation="Count" class="java.lang.Integer">
		<expression><![CDATA[($F{ORDEN_SECCION}.intValue() == 1 && $F{ESTADO_REVISION} != null && $F{ESTADO_REVISION}.intValue() == 2) ? $F{NUMERO_CUENTA} : null]]></expression>
	</variable>
	<variable name="CUENTAS_CON_EXTRACTO" resetType="Report" calculation="Count" class="java.lang.Integer">
		<expression><![CDATA[($F{ORDEN_SECCION}.intValue() == 1 && "S".equals($F{EXTRACTO_CARGADO})) ? $F{NUMERO_CUENTA} : null]]></expression>
	</variable>
	<variable name="SUMA_SALDO_LIBROS" resetType="Group" resetGroup="Seccion" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{ORDEN_SECCION}.intValue() == 1 ? $F{SALDO_LIBROS} : java.math.BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="SUMA_DEPOSITOS_TRANSITO" resetType="Group" resetGroup="Seccion" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{ORDEN_SECCION}.intValue() == 1 ? $F{DEPOSITOS_TRANSITO} : java.math.BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="SUMA_CHEQUES_NO_COBRADOS" resetType="Group" resetGroup="Seccion" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{ORDEN_SECCION}.intValue() == 1 ? $F{CHEQUES_NO_COBRADOS} : java.math.BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="SUMA_NC_NO_REGISTRADAS" resetType="Group" resetGroup="Seccion" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{ORDEN_SECCION}.intValue() == 1 ? $F{NC_NO_REGISTRADAS} : java.math.BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="SUMA_ND_NO_REGISTRADAS" resetType="Group" resetGroup="Seccion" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{ORDEN_SECCION}.intValue() == 1 ? $F{ND_NO_REGISTRADAS} : java.math.BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="SUMA_SALDO_ESPERADO" resetType="Group" resetGroup="Seccion" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{ORDEN_SECCION}.intValue() == 1 ? $F{SALDO_EXTRACTO_ESPERADO} : java.math.BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="SUMA_SALDO_EXTRACTO" resetType="Group" resetGroup="Seccion" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{ORDEN_SECCION}.intValue() == 1 && $F{SALDO_EXTRACTO} != null ? $F{SALDO_EXTRACTO} : java.math.BigDecimal.ZERO]]></expression>
	</variable>

