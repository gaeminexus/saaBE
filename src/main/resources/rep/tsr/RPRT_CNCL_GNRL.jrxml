				<expression><![CDATA[$F{PERIODO} + "  (" + new java.text.SimpleDateFormat("dd/MM/yyyy").format($F{DESDE})
    + " - " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($F{HASTA}) + ")"]]></expression>
			</element>
			<element kind="staticText" uuid="b0000010-0001-0001-0001-000000000005"
					x="0" y="14" width="130" height="13" fontName="Tahoma" fontSize="8.0" bold="true" vTextAlign="Middle">
