					mode="Opaque" x="0" y="30" width="802" height="13" backcolor="#5B7FA6" forecolor="#FFFFFF"
					fontName="Tahoma" fontSize="8.0" bold="true" vTextAlign="Middle">
				<text><![CDATA[2. CUENTAS BANCARIAS DE LA EMPRESA]]></text>
				<box leftPadding="5"/>
			</element>
			<element kind="staticText" uuid="b0000010-0001-0001-0001-000000000009"
					mode="Opaque" x="0" y="43" width="220" height="12" backcolor="#D1D1D1" fontName="Tahoma" fontSize="7.0" bold="true" vTextAlign="Middle">
				<text><![CDATA[Banco / Cuenta / Cta. contable]]></text>
				<box leftPadding="3"/>
			</element>
			<element kind="staticText" uuid="b0000010-0001-0001-0001-000000000010"
					mode="Opaque" x="220" y="43" width="65" height="12" backcolor="#D1D1D1" fontName="Tahoma" fontSize="7.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
				<text><![CDATA[Sdo.Libros]]></text>
				<box rightPadding="3"/>
			</element>
			<element kind="staticText" uuid="b0000010-0001-0001-0001-000000000011"
					mode="Opaque" x="285" y="43" width="65" height="12" backcolor="#D1D1D1" fontName="Tahoma" fontSize="7.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
				<text><![CDATA[(-)Dep.Trans.]]></text>
				<box rightPadding="3"/>
			</element>
			<element kind="staticText" uuid="b0000010-0001-0001-0001-000000000012"
					mode="Opaque" x="350" y="43" width="65" height="12" backcolor="#D1D1D1" fontName="Tahoma" fontSize="7.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
				<text><![CDATA[(+)Cheq.NC]]></text>
				<box rightPadding="3"/>
