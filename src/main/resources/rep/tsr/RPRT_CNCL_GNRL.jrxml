		<expression><![CDATA[$F{ORDEN_SECCION}]]></expression>
		<groupHeader>
			<band height="16" splitType="Stretch">
				<printWhenExpression><![CDATA[$F{ORDEN_SECCION}.intValue() == 2]]></printWhenExpression>
				<element kind="textField" uuid="c0000001-0002-0002-0002-000000000001"
						mode="Opaque" x="0" y="0" width="802" height="16"
						backcolor="#5B7FA6" forecolor="#FFFFFF" fontName="Tahoma" fontSize="9.0" bold="true" vTextAlign="Middle">
					<expression><![CDATA["4. RESUMEN DE PARTIDAS EN TRÁNSITO PENDIENTES DE TODA LA EMPRESA (al cierre del período)"]]></expression>
					<box leftPadding="5"/>
				</element>
			</band>
		</groupHeader>
