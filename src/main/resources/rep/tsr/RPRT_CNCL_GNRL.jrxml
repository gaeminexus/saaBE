			</element>
			<element kind="textField" uuid="b0000010-0001-0001-0001-000000000006"
					x="130" y="14" width="280" height="13" fontName="Tahoma" fontSize="8.0" vTextAlign="Middle" blankWhenNull="true">
				<expression><![CDATA[($F{MES_CERRADO} != null && $F{MES_CERRADO}.intValue() == 1)
    ? ("CERRADO por " + $F{MES_CERRADO_POR} + " el "
        + new java.text.SimpleDateFormat("dd/MM/yyyy").format($F{MES_CERRADO_EL}))
    : "ABIERTO"]]></expression>
			</element>
			<element kind="textField" uuid="b0000010-0001-0001-0001-000000000007"
					x="420" y="14" width="382" height="13" fontName="Tahoma" fontSize="8.0" vTextAlign="Middle">
				<expression><![CDATA["Cuentas activas: " + $V{CUENTAS_ACTIVAS}
    + "   |   Verificadas: " + $V{CUENTAS_VERIFICADAS}
    + "   |   Con extracto cargado: " + $V{CUENTAS_CON_EXTRACTO}]]></expression>
			</element>

			<!-- Encabezado de la tabla, sección 2 del diseño (aquí y no en <columnHeader> aparte:
