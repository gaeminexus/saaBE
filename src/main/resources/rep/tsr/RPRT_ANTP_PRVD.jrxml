<?xml version="1.0" encoding="UTF-8"?>
<!-- Comprobante de Entrega de Anticipo a Proveedor -->
<jasperReport name="RPRT_ANTP_PRVD" language="java" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="40" rightMargin="20" topMargin="20" bottomMargin="20" uuid="d2e3f4a5-b6c7-d8e9-f0a1-b2c3d4e5f6a7">
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageHeight" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.topMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.bottomMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.leftMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.rightMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnWidth" value="pixel"/>

	<parameter name="P_PATH" class="java.lang.String"/>
	<parameter name="P_REPORTE" class="java.lang.String"/>
	<parameter name="P_ANTICIPO_ID" class="java.lang.Long"/>
	<parameter name="P_IMAGEN" class="java.awt.Image"/>

	<query language="sql"><![CDATA[SELECT
  AP.ANTPCDGO                                                           AS ID,
  NVL(AP.ANTPNDOC, ' ')                                                AS NUMERODOC,
  AP.ANTPFANT                                                           AS FECHAANTICIPO,
  AP.ANTPFRCP                                                           AS FECHARECEPCION,
  AP.ANTPFCRG                                                           AS FECHAREGISTRO,
  AP.ANTPVLOR                                                           AS VALOR,
  AP.ANTPSALD                                                           AS SALDO,
  DECODE(AP.ANTPFPAG, 1,'Efectivo', 2,'Transferencia', 3,'Cheque', 'N/A') AS FORMA_PAGO,
  NVL(AP.ANTPREFR, ' ')                                                AS REFERENCIA,
  NVL(AP.ANTPBANC, ' ')                                                AS BANCO,
  NVL(AP.ANTPOBSR, ' ')                                                AS OBSERVACION,
  DECODE(AP.ANTPESTD, 1,'Activo', 2,'Agotado', 3,'Anulado', 'N/A')    AS ESTADO_DESC,
  NVL(T.TTLRRZSC, T.TTLRNMBR)                                          AS NOMBRE_TITULAR,
  T.TTLRIDNT,
  NVL(A.ASNTNMAL, ' ')                                                 AS NUM_ASIENTO,
  NVL(USR.PJRQNMBR, ' ')                                               AS NOMBRE_USUARIO,
  NVL(EMP.PJRQNMBR, ' ')                                               AS NOMBRE_EMPRESA
FROM PGS.ANTP AP
JOIN  TSR.TTLR  T   ON AP.ANTPTTLR = T.TTLRCDGO
LEFT JOIN CNT.ASNT  A   ON AP.ANTPASNT = A.ASNTCDGO
LEFT JOIN SCP.PJRQ  USR ON AP.ANTPUSAR = USR.PJRQCDGO
LEFT JOIN SCP.PJRQ  EMP ON AP.ANTPPJRQ = EMP.PJRQCDGO
WHERE AP.ANTPCDGO = $P{P_ANTICIPO_ID}]]></query>

	<field name="ID"             class="java.math.BigDecimal"/>
	<field name="NUMERODOC"      class="java.lang.String"/>
	<field name="FECHAANTICIPO"  class="java.sql.Date"/>
	<field name="FECHARECEPCION" class="java.sql.Date"/>
	<field name="FECHAREGISTRO"  class="java.sql.Timestamp"/>
	<field name="VALOR"          class="java.math.BigDecimal"/>
	<field name="SALDO"          class="java.math.BigDecimal"/>
	<field name="FORMA_PAGO"     class="java.lang.String"/>
	<field name="REFERENCIA"     class="java.lang.String"/>
	<field name="BANCO"          class="java.lang.String"/>
	<field name="OBSERVACION"    class="java.lang.String"/>
	<field name="ESTADO_DESC"    class="java.lang.String"/>
	<field name="NOMBRE_TITULAR" class="java.lang.String"/>
	<field name="TTLRIDNT"       class="java.lang.String"/>
	<field name="NUM_ASIENTO"    class="java.lang.String"/>
	<field name="NOMBRE_USUARIO" class="java.lang.String"/>
	<field name="NOMBRE_EMPRESA" class="java.lang.String"/>

	<background splitType="Stretch"/>

