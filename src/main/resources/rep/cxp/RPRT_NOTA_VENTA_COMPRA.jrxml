<!-- Reporte de RESPALDO INTERNO de una nota de venta de compra (PGS.FCTC, TIPOCOMPROBANTE='02').
     NO es un RIDE: la nota de venta la EMITE el proveedor en papel, no la genera este sistema ni
     la autoriza el SRI. Ver docs/logica-negocio/cxp/PLAN-REPORTE-NOTA-VENTA-COMPRA.md.
     Falta el .jasper: JasperReports 7.0.3 no compila en runtime (ver CLAUDE.md, sección
     Reportes) y ReporteServiceImpl:110 sólo cae al .jrxml si no encuentra el .jasper -y ese
     respaldo está muerto-. Generarlo con Jaspersoft Studio 7.0.3 y commitear los dos archivos
     antes de usar este reporte en producción.
     Pendiente de decisión (ver el commit): FCTC no tiene una columna de "fecha en que se tipeó
     el documento" -FCTCFCRG es fecha de registro CONTABLE (ATS), un concepto distinto, y no se
     puebla en ningún lugar del código hoy-, así que el pie sólo muestra el usuario que registró,
     sin fecha. -->
<jasperReport name="RPRT_NOTA_VENTA_COMPRA" language="java" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" uuid="7c8a1d20-3f4e-4b5a-9c6d-2e1f0a9b8c7d">
	<parameter name="P_ID_FACTURA" class="java.lang.Long">
		<defaultValueExpression><![CDATA[0L]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[
		SELECT
		    /* ── Cabecera de la nota de venta (PGS.FCTC) ─────────────────────── */
		    f.NUMERO                                                        AS numero,
		    TO_CHAR(f.FECHA,     'DD/MM/YYYY')                              AS fecha,
		    COALESCE(f.AUTORIZACION,       '')                              AS autorizacion,
		    COALESCE(f.OBSERVACION,        '')                              AS observacion,
		    COALESCE(f.SUBTOTAL, 0)                                         AS subtotal,
		    COALESCE(f.DESCUENTO, 0)                                        AS descuentoCabecera,
		    COALESCE(f.TOTAL, 0)                                            AS total,
		    /* ── Datos de la empresa (mismo origen que RPRT_RIDE_FACTURA: CBR.FCDR) ── */
		    COALESCE(fd.NUMDOC,            '')                              AS rucEmpresa,
		    COALESCE(fd.RAZONSOCIAL,       '')                              AS razonSocialEmpresa,
		    COALESCE(fd.NOMBRECOMERCIAL,   '')                              AS nombreComercialEmpresa,
		    COALESCE(fd.DIRECCION,         '')                              AS direccionEmpresa,
		    COALESCE(fd.TELEFONO,          '')                              AS telefonoEmpresa,
		    COALESCE(fd.LOGO,              '')                              AS pathLogo,
		    /* ── Proveedor emisor de la nota de venta (TSR.TTLR) ─────────────── */
		    COALESCE(t.TTLRRZSC, t.TTLRNMBR, '')                            AS nombreProveedor,
		    COALESCE(t.TTLRIDNT,           '')                              AS rucProveedor,
		    COALESCE(t.TTLRDRCC,           '')                              AS direccionProveedor,
		    COALESCE(t.TTLRTLFN,           '')                              AS telefonoProveedor,
		    /* ── Usuario que registró (SCP.PJRQ, mismo id que FCTC.USUARIO) ─── */
		    COALESCE(pj.PJRQNMBR,          '')                              AS nombreUsuario,
		    /* ── Línea de detalle (PGS.DFCC) ─────────────────────────────────── */
		    COALESCE(d.DESCRIPCION,        '')                              AS descripcionLinea,
		    COALESCE(d.CANTIDAD, 0)                                         AS cantidadLinea,
		    COALESCE(d.VALOR, 0)                                            AS valorLinea,
		    COALESCE(d.DESCUENTO, 0)                                        AS descuentoLinea,
		    COALESCE(d.TOTAL, 0)                                            AS totalLinea
		FROM      PGS.FCTC f
		LEFT JOIN CBR.FCDR fd ON fd.EMPRESA   = f.EMPRESA AND fd.ESTADO = 1
		LEFT JOIN TSR.TTLR  t ON t.TTLRCDGO   = f.TITULAR
		LEFT JOIN SCP.PJRQ  pj ON pj.PJRQCDGO = f.USUARIO
		LEFT JOIN PGS.DFCC  d ON d.FACTURA    = f.ID AND d.ESTADO = 1
		WHERE f.ID = $P{P_ID_FACTURA}
		ORDER BY d.ID
	]]></query>
