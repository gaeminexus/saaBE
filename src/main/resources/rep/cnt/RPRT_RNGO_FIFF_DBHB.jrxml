	<parameter name="P_FILTRO" class="java.lang.String"/>
	<parameter name="P_MAYORIZADO" class="java.lang.String"/>
	<parameter name="P_PJRQ_CODIGO" class="java.lang.Long"/>
	<parameter name="P_USUARIO" class="java.lang.String"/>
	<parameter name="P_NIVEL_MAXIMO" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[6]]></defaultValueExpression>
	</parameter>

	<query language="SQL"><![CDATA[SELECT  dtmtcdgo, dtmtscrp, plnncdgo, dtmtslan, dtmtdbee, dtmthbrr, dtmtslac, dtmtctcn,
       plnncdpd, plnnnmbr, plnntpoo, plnnnvll, myrzcdgo,
       decode(plnnnvll,1, dtmtdbee, 0) DEBE,
       decode(plnnnvll,1, dtmthbrr, 0) HABER ,
       decode(plnnnvll,1, dtmtslac, 0)  MOVIMIENTO,
       (SELECT e.PJRQNMBR FROM SCP.PJRQ e WHERE e.PJRQCDGO = $P{P_PJRQ_CODIGO}) EMPRESA_NOMBRE
FROM CNT.DTMT
WHERE DTMTSCRP = $P{P_DTMTSCRP}
AND LENGTH(REPLACE(DTMTCTCN,'.','')) <= $P{P_NIVEL_MAXIMO}
ORDER BY DTMTCTCN]]></query>

	<field name="DTMTCDGO" class="java.math.BigDecimal"/>
	<field name="DTMTSCRP" class="java.math.BigDecimal"/>
