<?xml version="1.0" encoding="UTF-8"?>
<!-- Convertido de sintaxis JRXML clasica a sintaxis compacta el 2026-09-08: JasperReports
     7.0.3 open-source YA NO TRAE ningun loader capaz de compilar la sintaxis clasica
     (xmlns="http://jasperreports.sourceforge.net/jasperreports", <textFieldExpression>,
     etc.). Confirmado leyendo el jar de fuentes net.sf.jasperreports:jasperreports:7.0.3:
     JRXmlLoader.loadXML itera net.sf.jasperreports.engine.xml.ReportLoader vía extensiones, y
     el UNICO ReportLoader que trae el jar es JacksonReportLoader (el de la sintaxis
     compacta). El .jasper clasico YA COMPILADO carga y llena perfecto (es solo
     deserializacion binaria, no le importa el dialecto fuente) pero el .jrxml clasico no se
     puede volver a compilar con ninguna combinacion de classpath: no es un jar que falte,
     es que el loader no existe en esta version. Ver CLAUDE.md / "Reportes".

     Conversion mecanica: mismos elementos, mismas coordenadas, misma consulta y columnas,
     solo la sintaxis (reportElement/textElement/textFieldExpression -> atributos planos en
     <element kind="...">). Los cambios de fondo (titulo literal, empresa, firmas, usuario)
     van sobre esta base, pedidos por el usuario el 2026-09-08. -->
<jasperReport name="RPRTCNTB_ACUM_CNFI" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="a1b2c3d4-0001-0001-0001-000000000001">
	<parameter name="P_FECHAINICIAL" class="java.lang.String"/>
	<parameter name="P_FECHAFINAL" class="java.lang.String"/>
	<parameter name="P_DTMTSCRP" class="java.lang.Integer"/>
	<parameter name="P_REPORTE" class="java.lang.String"/>
	<parameter name="P_PATH" class="java.lang.String"/>
	<parameter name="P_IMAGEN" class="java.awt.Image"/>
	<parameter name="P_FILTRO" class="java.lang.String"/>
	<parameter name="P_MAYORIZADO" class="java.lang.String"/>
	<parameter name="P_PJRQ_CODIGO" class="java.lang.Long"/>
	<parameter name="P_USUARIO" class="java.lang.String"/>
	<parameter name="P_NIVEL_MAXIMO" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[6]]></defaultValueExpression>
	</parameter>

	<query language="SQL"><![CDATA[SELECT    dtmtcdgo, dtmtscrp, plnncdgo, dtmtslan, dtmtdbee, dtmthbrr, dtmtslac, dtmtctcn,         plnncdpd, plnnnmbr, plnntpoo, plnnnvll, myrzcdgo,
decode(plnnnvll,1, dtmtslan, 0)  SALDO_ANTERIOR,
decode(plnnnvll,1, dtmtslac, 0)  SALDO,
(SELECT e.PJRQNMBR FROM SCP.PJRQ e WHERE e.PJRQCDGO = $P{P_PJRQ_CODIGO}) EMPRESA_NOMBRE

FROM CNT.DTMT
WHERE DTMTSCRP = $P{P_DTMTSCRP}
AND LENGTH(REPLACE(DTMTCTCN,'.','')) <= $P{P_NIVEL_MAXIMO}
ORDER BY DTMTCTCN]]></query>

	<field name="DTMTCDGO" class="java.math.BigDecimal"/>
	<field name="DTMTSCRP" class="java.math.BigDecimal"/>
	<field name="PLNNCDGO" class="java.math.BigDecimal"/>
	<field name="DTMTSLAN" class="java.math.BigDecimal"/>
	<field name="DTMTDBEE" class="java.math.BigDecimal"/>
	<field name="DTMTHBRR" class="java.math.BigDecimal"/>
	<field name="DTMTSLAC" class="java.math.BigDecimal"/>
	<field name="DTMTCTCN" class="java.lang.String"/>
	<field name="PLNNCDPD" class="java.math.BigDecimal"/>
	<field name="PLNNNMBR" class="java.lang.String"/>
	<field name="PLNNTPOO" class="java.math.BigDecimal"/>
	<field name="PLNNNVLL" class="java.math.BigDecimal"/>
	<field name="MYRZCDGO" class="java.math.BigDecimal"/>
	<field name="SALDO" class="java.math.BigDecimal"/>
	<field name="SALDO_ANTERIOR" class="java.math.BigDecimal"/>
	<field name="EMPRESA_NOMBRE" class="java.lang.String"/>

	<variable name="SUMA_SALANT" class="java.math.BigDecimal" calculation="Sum">
		<expression><![CDATA[$F{SALDO_ANTERIOR}]]></expression>
	</variable>
	<variable name="SUMA_SALDO" class="java.math.BigDecimal" calculation="Sum">
		<expression><![CDATA[$F{SALDO}]]></expression>
	</variable>

	<background splitType="Stretch"/>

	<pageHeader height="96" splitType="Stretch">
