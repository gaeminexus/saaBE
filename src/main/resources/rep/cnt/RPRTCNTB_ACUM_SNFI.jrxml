			</element>
			<element kind="textField" uuid="a1b2c3d4-1003-0001-0001-000000000003" x="430" y="0" width="70" height="11" fontSize="8.0" pattern="#,##0.00;(-#,##0.00)" hTextAlign="Right">
				<expression><![CDATA[$F{DTMTSLAC}]]></expression>
			</element>
		</band>
	</detail>

	<summary height="78" splitType="Stretch">
		<element kind="staticText" uuid="a1b2c3d4-1004-0001-0001-000000000001" x="370" y="6" width="50" height="15" fontName="Tahoma" fontSize="8.0" bold="true">
			<text><![CDATA[TOTAL:]]></text>
		</element>
		<element kind="textField" uuid="a1b2c3d4-1004-0001-0001-000000000002" x="430" y="6" width="70" height="15" fontName="Tahoma" fontSize="8.0" bold="true" pattern="#,##0.00;(-#,##0.00)" hTextAlign="Right">
			<expression><![CDATA[$V{SUMA_SALDO}]]></expression>
		</element>
		<element kind="line" uuid="a1b2c3d4-1004-0001-0001-000000000003" x="370" y="4" width="180" height="1"/>
		<!-- Firmas: SOLO dos, Gerente General y Contador/a. La Resolucion SBS-2013-0507 nombra
		     CUATRO responsables (Consejo de Administracion, representante legal, auditor
		     interno, contador general) pero eso es quien RESPONDE, no quien FIRMA - lectura
		     corregida el 2026-09-09 tras revisar un estado financiero real y publicado de otro
		     FCPC del mismo perfil (FOJUPIN-FCPC, julio 2022, portal de transparencia del BIESS):
		     firma con dos, GERENTE GENERAL y CONTADORA, igual en los cinco estados del
		     documento. No volver a los cuatro leyendo solo la norma. -->
		<element kind="line" uuid="a1b2c3d4-1004-0001-0001-000000000004" x="60" y="46" width="200" height="1"/>
		<element kind="staticText" uuid="a1b2c3d4-1004-0001-0001-000000000005" x="60" y="49" width="200" height="15" fontSize="8.0" hTextAlign="Center">
			<text><![CDATA[GERENTE GENERAL]]></text>
