<?xml version="1.0" encoding="UTF-8"?>
<!-- Convertido de sintaxis JRXML clasica a sintaxis compacta el 2026-09-08: ver la nota
     completa en RPRTCNTB_ACUM_CNFI.jrxml (mismo motivo, JasperReports 7.0.3 open-source no
     trae ningun loader capaz de compilar la sintaxis clasica). Conversion mecanica: mismos
     elementos, coordenadas, consulta y columnas; los cambios de fondo (titulo literal,
     empresa, firmas, usuario) van sobre esta base, pedidos por el usuario el 2026-09-08. -->
<jasperReport name="RPRTCNTB_ACUM_SNFI" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="a1b2c3d4-1001-0001-0001-000000000001">
	<parameter name="P_FECHAFINAL" class="java.lang.String"/>
	<parameter name="P_DTMTSCRP" class="java.lang.Integer"/>
	<parameter name="P_REPORTE" class="java.lang.String"/>
	<parameter name="P_PATH" class="java.lang.String"/>
	<parameter name="P_IMAGEN" class="java.awt.Image"/>
	<parameter name="P_FILTRO" class="java.lang.String"/>
	<parameter name="P_MAYORIZADO" class="java.lang.String"/>
	<parameter name="P_PJRQ_CODIGO" class="java.lang.Long"/>
	<parameter name="P_USUARIO" class="java.lang.String"/>
	<parameter name="P_NIVEL_MAXIMO" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[6]]></defaultValueExpression>
	</parameter>

	<query language="SQL"><![CDATA[SELECT  dtmtcdgo, dtmtscrp, plnncdgo, dtmtslan, dtmtdbee, dtmthbrr, dtmtslac, dtmtctcn,         plnncdpd, plnnnmbr, plnntpoo, plnnnvll, myrzcdgo,
decode(plnnnvll,1, dtmtslac, 0)  SALDO,
(SELECT e.PJRQNMBR FROM SCP.PJRQ e WHERE e.PJRQCDGO = $P{P_PJRQ_CODIGO}) EMPRESA_NOMBRE

FROM CNT.DTMT
WHERE DTMTSCRP = $P{P_DTMTSCRP}
AND LENGTH(REPLACE(DTMTCTCN,'.','')) <= $P{P_NIVEL_MAXIMO}
ORDER BY DTMTCTCN]]></query>

	<field name="DTMTCDGO" class="java.math.BigDecimal"/>
	<field name="DTMTSCRP" class="java.math.BigDecimal"/>
	<field name="PLNNCDGO" class="java.math.BigDecimal"/>
	<field name="DTMTSLAN" class="java.math.BigDecimal"/>
	<field name="DTMTDBEE" class="java.math.BigDecimal"/>
	<field name="DTMTHBRR" class="java.math.BigDecimal"/>
	<field name="DTMTSLAC" class="java.math.BigDecimal"/>
	<field name="DTMTCTCN" class="java.lang.String"/>
	<field name="PLNNCDPD" class="java.math.BigDecimal"/>
	<field name="PLNNNMBR" class="java.lang.String"/>
	<field name="PLNNTPOO" class="java.math.BigDecimal"/>
	<field name="PLNNNVLL" class="java.math.BigDecimal"/>
	<field name="MYRZCDGO" class="java.math.BigDecimal"/>
	<field name="SALDO" class="java.math.BigDecimal"/>
	<field name="EMPRESA_NOMBRE" class="java.lang.String"/>

	<variable name="SUMA_SALDO" class="java.math.BigDecimal" calculation="Sum">
		<expression><![CDATA[$F{SALDO}]]></expression>
	</variable>

	<background splitType="Stretch"/>

	<pageHeader height="96" splitType="Stretch">
		<element kind="textField" uuid="a1b2c3d4-1001-0001-0001-000000000002" x="300" y="28" width="57" height="15" fontSize="8.0" bold="true" pattern="dd-MMM-yyyy">
			<expression><![CDATA[$P{P_FECHAFINAL}]]></expression>
		</element>
		<element kind="staticText" uuid="a1b2c3d4-1001-0001-0001-000000000003" x="223" y="28" width="76" height="15" fontSize="8.0" bold="true">
			<text><![CDATA[FECHA DE CORTE]]></text>
		</element>
		<element kind="textField" uuid="a1b2c3d4-1001-0001-0001-000000000004" x="473" y="20" width="58" height="15" fontSize="8.0" pattern="dd-MMM-yyyy">
			<expression><![CDATA[new java.util.Date()]]></expression>
		</element>
		<element kind="textField" uuid="a1b2c3d4-1001-0001-0001-000000000005" x="466" y="5" width="51" height="15" fontSize="8.0" hTextAlign="Right">
			<expression><![CDATA["Página "+$V{PAGE_NUMBER}+" de"]]></expression>
		</element>
		<element kind="textField" uuid="a1b2c3d4-1001-0001-0001-000000000006" x="519" y="5" width="24" height="15" fontSize="8.0" evaluationTime="Report">
			<expression><![CDATA[" " + $V{PAGE_NUMBER}]]></expression>
		</element>
		<element kind="textField" uuid="a1b2c3d4-1001-0001-0001-000000000007" x="473" y="35" width="58" height="15" fontSize="8.0" pattern="K:mm a">
			<expression><![CDATA[new java.util.Date()]]></expression>
		</element>
		<element kind="staticText" uuid="a1b2c3d4-1001-0001-0001-000000000008" x="92" y="5" width="380" height="20" fontSize="13.0" bold="true" hTextAlign="Center">
			<text><![CDATA[ESTADO DE SITUACIÓN FINANCIERA]]></text>
		</element>
		<element kind="staticText" uuid="a1b2c3d4-1001-0001-0001-000000000009" x="10" y="51" width="60" height="13" fontSize="8.0" bold="true">
			<text><![CDATA[EMPRESA:]]></text>
		</element>
		<element kind="textField" uuid="a1b2c3d4-1001-0001-0001-000000000010" x="70" y="51" width="270" height="13" fontSize="8.0" blankWhenNull="true">
			<expression><![CDATA[$F{EMPRESA_NOMBRE}]]></expression>
		</element>
		<element kind="image" uuid="a1b2c3d4-1001-0001-0001-000000000011" positionType="FixRelativeToBottom" x="10" y="5" width="80" height="40" scaleImage="RealSize" evaluationTime="Report" lazy="true">
			<expression><![CDATA[$P{P_IMAGEN}]]></expression>
		</element>
		<element kind="textField" uuid="a1b2c3d4-1001-0001-0001-000000000012" x="10" y="67" width="539" height="15" fontSize="8.0" bold="true">
			<expression><![CDATA[$P{P_FILTRO}]]></expression>
		</element>
		<element kind="textField" uuid="a1b2c3d4-1001-0001-0001-000000000013" x="473" y="51" width="74" height="15" forecolor="#0000CC" fontName="SansSerif" fontSize="8.0" bold="true">
			<expression><![CDATA[$P{P_MAYORIZADO}]]></expression>
		</element>
		<element kind="textField" uuid="a1b2c3d4-1001-0001-0001-000000000014" x="10" y="83" width="300" height="13" fontSize="7.0">
			<expression><![CDATA["Impreso por: " + $P{P_USUARIO}]]></expression>
		</element>
		<element kind="line" uuid="a1b2c3d4-1001-0001-0001-000000000015" x="10" y="93" width="539" height="1"/>
	</pageHeader>

	<columnHeader height="22" splitType="Stretch">
		<element kind="line" uuid="a1b2c3d4-1002-0001-0001-000000000001" x="10" y="3" width="540" height="1"/>
		<element kind="staticText" uuid="a1b2c3d4-1002-0001-0001-000000000002" x="10" y="4" width="100" height="13" fontName="Tahoma" bold="true">
			<text><![CDATA[CUENTA]]></text>
		</element>
		<element kind="staticText" uuid="a1b2c3d4-1002-0001-0001-000000000003" x="121" y="4" width="121" height="13" fontName="Tahoma" bold="true">
			<text><![CDATA[DESCRIPCION]]></text>
		</element>
		<element kind="staticText" uuid="a1b2c3d4-1002-0001-0001-000000000004" x="430" y="4" width="70" height="13" fontName="Tahoma" bold="true" hTextAlign="Right">
			<text><![CDATA[SALDO]]></text>
		</element>
		<element kind="line" uuid="a1b2c3d4-1002-0001-0001-000000000005" x="10" y="18" width="540" height="1"/>
	</columnHeader>

	<detail>
		<band height="11" splitType="Stretch">
			<element kind="textField" uuid="a1b2c3d4-1003-0001-0001-000000000001" x="10" y="0" width="100" height="11" fontSize="8.0">
				<expression><![CDATA[$F{DTMTCTCN}]]></expression>
			</element>
			<element kind="textField" uuid="a1b2c3d4-1003-0001-0001-000000000002" x="121" y="0" width="299" height="11" fontSize="8.0">
