			<box leftPadding="5"/>
		</element>
		<element kind="textField" uuid="d0000000-0000-0000-0000-00000000012a" x="90" y="128" width="445" height="13" fontName="Tahoma" fontSize="7.5" blankWhenNull="true" vTextAlign="Middle">
			<expression><![CDATA[$F{OBSERVACION}]]></expression>
			<box leftPadding="5"/>
		</element>
		<element kind="line" uuid="d0000000-0000-0000-0000-000000000130" x="0" y="150" width="535" height="1">
			<pen lineWidth="0.5"/>
		</element>
		<element kind="staticText" uuid="d0000000-0000-0000-0000-000000000131" x="0" y="156" width="535" height="30" fontName="Tahoma" fontSize="7.0" forecolor="#4A5568">
			<text><![CDATA[Este documento muestra únicamente lo recibido en cada línea. No incluye una proyección de cómo se aplicará el pago (capital, interés, mora, seguros): entre el registro y la aprobación de contabilidad la mora sigue corriendo, así que ese reparto solo se conoce con certeza al procesar el cobro.]]></text>
		</element>
	</title>
	<pageHeader height="4" splitType="Stretch"/>
	<columnHeader height="16" splitType="Stretch">
		<element kind="staticText" uuid="d0000000-0000-0000-0000-000000000200" mode="Opaque" x="0" y="0" width="395" height="16" backcolor="#EDF2F7" forecolor="#4A5568" fontName="Tahoma" fontSize="7.5" bold="true" hTextAlign="Left" vTextAlign="Middle">
