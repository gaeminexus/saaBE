	<detail>
		<band height="18" splitType="Stretch">
			<!-- Encabezados de seccion (filas sinteticas, LINEA_CODIGO = -1): ocupan las DOS
			     columnas y suprimen las columnas normales de esa fila. Nunca aparecen mezclados
			     con las lineas reales de la otra direccion del dinero. -->
			<element kind="staticText" uuid="d0000000-0000-0000-0000-000000000310" mode="Opaque" x="0" y="0" width="535" height="18" backcolor="#276749" forecolor="#FFFFFF" fontName="Tahoma" fontSize="7.5" bold="true" hTextAlign="Left" vTextAlign="Middle">
				<printWhenExpression><![CDATA["HEADER_FAVOR".equals($F{TIPO_LINEA})]]></printWhenExpression>
				<text><![CDATA[APORTES A SU FAVOR — su saldo AUMENTA]]></text>
				<box leftPadding="6"/>
			</element>
			<element kind="staticText" uuid="d0000000-0000-0000-0000-000000000311" mode="Opaque" x="0" y="0" width="535" height="18" backcolor="#C05621" forecolor="#FFFFFF" fontName="Tahoma" fontSize="7.5" bold="true" hTextAlign="Left" vTextAlign="Middle">
				<printWhenExpression><![CDATA["HEADER_CONSUMIDO".equals($F{TIPO_LINEA})]]></printWhenExpression>
				<text><![CDATA[APORTES QUE SE CONSUMEN — su saldo DISMINUYE]]></text>
				<box leftPadding="6"/>
			</element>
			<!-- Filas de datos: prestamo, aporte a favor, o aporte consumido. -->
			<element kind="textField" uuid="d0000000-0000-0000-0000-000000000300" x="0" y="0" width="395" height="18" fontName="Tahoma" fontSize="7.5" blankWhenNull="true" vTextAlign="Middle">
				<printWhenExpression><![CDATA[!$F{TIPO_LINEA}.startsWith("HEADER")]]></printWhenExpression>
				<expression><![CDATA["PRESTAMO".equals($F{TIPO_LINEA})
    ? ("Préstamo #" + ($F{PRESTAMO_NUMERO} != null ? $F{PRESTAMO_NUMERO}.toBigInteger().toString() : $F{PRESTAMO_CODIGO}.toBigInteger().toString())
        + ($F{PRODUCTO_NOMBRE} != null ? (" — " + $F{PRODUCTO_NOMBRE}) : ""))
    : ("APORTE_CONSUMIDO".equals($F{TIPO_LINEA})
        ? ("Aporte consumido — " + $F{TIPO_APORTE_NOMBRE})
        : ("Aporte — " + $F{TIPO_APORTE_NOMBRE}
            + ($F{PERIODO_DEVENGO} != null ? ("  ·  Período " + new java.text.SimpleDateFormat("MM/yyyy").format($F{PERIODO_DEVENGO})) : "")))]]></expression>
				<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
			</element>
			<element kind="textField" uuid="d0000000-0000-0000-0000-000000000301" x="395" y="0" width="140" height="18" pattern="$#,##0.00" fontName="Tahoma" fontSize="7.5" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle">
				<printWhenExpression><![CDATA[!$F{TIPO_LINEA}.startsWith("HEADER")]]></printWhenExpression>
				<expression><![CDATA[$F{LINEA_VALOR}]]></expression>
				<box rightPadding="8"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
			</element>
		</band>
	</detail>
