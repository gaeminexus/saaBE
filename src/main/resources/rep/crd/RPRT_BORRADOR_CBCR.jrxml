			<expression><![CDATA[($F{BANCO_NOMBRE} != null ? $F{BANCO_NOMBRE} : "") + ($F{CUENTA_NUMERO} != null ? (" — Cta. " + $F{CUENTA_NUMERO}) : "")
+ ($F{REFERENCIA} != null && $F{REFERENCIA}.trim().length() > 0 ? ("  ·  Ref: " + $F{REFERENCIA}) : "")]]></expression>
			<box leftPadding="5"/>
		</element>
		<element kind="staticText" uuid="d0000000-0000-0000-0000-000000000129" mode="Opaque" x="0" y="128" width="90" height="13" backcolor="#EFEFEF" fontName="Tahoma" fontSize="7.5" bold="true" vTextAlign="Middle">
