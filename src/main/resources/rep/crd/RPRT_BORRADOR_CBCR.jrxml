	<summary height="56" splitType="Stretch">
		<!-- Cubierto con deposito: prestamo + aporte a favor (todo lo que SI entro al banco). -->
		<element kind="staticText" uuid="d0000000-0000-0000-0000-000000000502" x="0" y="0" width="395" height="16" fontName="Tahoma" fontSize="7.5" hTextAlign="Right" vTextAlign="Middle">
			<text><![CDATA[Cubierto con depósito]]></text>
			<box rightPadding="8"/>
		</element>
		<element kind="textField" uuid="d0000000-0000-0000-0000-000000000503" x="395" y="0" width="140" height="16" pattern="$#,##0.00" fontName="Tahoma" fontSize="7.5" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA[$V{V_TOTAL_PRESTAMO}.add($V{V_TOTAL_FAVOR})]]></expression>
			<box rightPadding="8"/>
		</element>
		<!-- Cubierto consumiendo aportes: solo aparece si hubo parte de precancelacion mixta. -->
		<element kind="staticText" uuid="d0000000-0000-0000-0000-000000000504" x="0" y="16" width="395" height="16" fontName="Tahoma" fontSize="7.5" forecolor="#C05621" hTextAlign="Right" vTextAlign="Middle">
			<printWhenExpression><![CDATA[$V{V_TOTAL_CONSUMIDO}.doubleValue() > 0.0]]></printWhenExpression>
			<text><![CDATA[Cubierto consumiendo aportes]]></text>
			<box rightPadding="8"/>
		</element>
		<element kind="textField" uuid="d0000000-0000-0000-0000-000000000505" x="395" y="16" width="140" height="16" pattern="$#,##0.00" fontName="Tahoma" fontSize="7.5" forecolor="#C05621" hTextAlign="Right" vTextAlign="Middle">
			<printWhenExpression><![CDATA[$V{V_TOTAL_CONSUMIDO}.doubleValue() > 0.0]]></printWhenExpression>
			<expression><![CDATA[$V{V_TOTAL_CONSUMIDO}]]></expression>
			<box rightPadding="8"/>
		</element>
		<!-- Total general: deposito + consumido (nunca sumados en la misma linea que el detalle,
		     pero el total SI necesita mostrar cuanto es en conjunto). -->
		<element kind="staticText" uuid="d0000000-0000-0000-0000-000000000500" mode="Opaque" x="0" y="36" width="395" height="18" backcolor="#D1D1D1" fontName="Tahoma" fontSize="8.5" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<text><![CDATA[TOTAL DEL COBRO]]></text>
			<box rightPadding="8"/>
		</element>
		<element kind="textField" uuid="d0000000-0000-0000-0000-000000000501" mode="Opaque" x="395" y="36" width="140" height="18" backcolor="#D1D1D1" pattern="$#,##0.00" fontName="Tahoma" fontSize="8.5" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA[$V{V_TOTAL_PRESTAMO}.add($V{V_TOTAL_FAVOR}).add($V{V_TOTAL_CONSUMIDO})]]></expression>
			<box rightPadding="8"/>
		</element>
	</summary>
	<noData height="80" splitType="Stretch">
		<element kind="staticText" uuid="d0000000-0000-0000-0000-000000000600" mode="Opaque" x="0" y="0" width="535" height="16" backcolor="#EDF2F7" forecolor="#4A5568" fontName="Tahoma" fontSize="9.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
			<text><![CDATA[SIN INFORMACIÓN PARA PRESENTAR]]></text>
			<box><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
