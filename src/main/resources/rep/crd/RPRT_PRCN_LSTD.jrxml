			<expression><![CDATA["Generado: " + $P{GENERADO} + (($P{USUARIO} != null && !$P{USUARIO}.isEmpty()) ? "   Usuario: " + $P{USUARIO} : "")]]></expression>
		</element>
		<element kind="staticText" uuid="c7000000-0000-0000-0000-000000000017" style="Texto" x="0" y="62" width="802" height="12" fontSize="6.0" italic="true">
			<text><![CDATA[La fecha de cancelación en las cargas Petro/ARCH es el último día del mes de afectación; en la migración, el vencimiento de la cuota. Otros pag. = interés vencido + desgravamen + seguro de incendio + saldo otros (en una precancelación incluye el capital futuro).]]></text>
		</element>
		<element kind="textField" uuid="c7000000-0000-0000-0000-000000000018" style="Texto" x="0" y="78" width="802" height="16" fontSize="9.0" bold="true" hTextAlign="Center" printWhenExpression="$P{CANTIDAD} == null || $P{CANTIDAD}.longValue() == 0L">
			<expression><![CDATA["Sin préstamos cancelados en el rango"]]></expression>
		</element>
	</title>
