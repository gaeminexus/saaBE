			<text><![CDATA[PRÉSTAMOS CANCELADOS]]></text>
		</element>
		<element kind="textField" uuid="c7000000-0000-0000-0000-000000000014" style="Texto" x="90" y="21" width="712" height="12" bold="true">
			<expression><![CDATA["Rango de fecha de cancelación: " + $P{FECHA_DESDE} + " al " + $P{FECHA_HASTA}]]></expression>
		</element>
