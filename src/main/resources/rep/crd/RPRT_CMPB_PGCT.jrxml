			<text><![CDATA[Total pagado]]></text>
			<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="textField" uuid="b7c00000-0000-0000-0000-00000000011c" x="354" y="116" width="174" height="14" pattern="$#,##0.00" fontName="Tahoma" fontSize="7.5" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA[$F{TOTAL_PAGADO}]]></expression>
