		</element>
		<element kind="staticText" uuid="b7c00000-0000-0000-0000-00000000011d" mode="Opaque" x="528" y="116" width="90" height="14" backcolor="#F7FAFC" fontName="Tahoma" fontSize="7.5" bold="true" hTextAlign="Left" vTextAlign="Middle">
			<text><![CDATA[Saldo pendiente]]></text>
			<box leftPadding="6"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="textField" uuid="b7c00000-0000-0000-0000-00000000011e" x="618" y="116" width="174" height="14" pattern="$#,##0.00" fontName="Tahoma" fontSize="7.5" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA[$F{SALDO_PENDIENTE}]]></expression>
			<box rightPadding="8"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<!-- FRASE RESUMEN -->
		<element kind="textField" uuid="b7c00000-0000-0000-0000-000000000120" x="0" y="134" width="792" height="24" forecolor="#4A5568" fontName="Tahoma" fontSize="9.0" textAdjust="StretchHeight" vTextAlign="Middle">
			<expression><![CDATA[( $F{NUM_PAGOS}.intValue() + " " + ($F{NUM_PAGOS}.intValue() == 1 ? "pago" : "pagos")
   + " por " + new java.text.DecimalFormat("$#,##0.00").format($F{TOTAL_PAGADO}.doubleValue()) )
+ ( $F{SALDO_PENDIENTE}.doubleValue() <= 0.01
    ? " cubrieron la cuota completa: no queda saldo pendiente."
    : (". Todavia queda pendiente " + new java.text.DecimalFormat("$#,##0.00").format($F{SALDO_PENDIENTE}.doubleValue()) + " de esta cuota.") )]]></expression>
		</element>
	</title>
	<pageHeader height="4" splitType="Stretch"/>
	<columnHeader height="40" splitType="Stretch">
		<element kind="staticText" uuid="b7c00000-0000-0000-0000-000000000201" x="0" y="2" width="792" height="12" forecolor="#718096" fontName="Tahoma" fontSize="7.0" bold="true" vTextAlign="Middle">
			<text><![CDATA[PAGOS REGISTRADOS — IMPUTACION: DESGRAVAMEN, MORA, INTERES VENCIDO, INTERES, CAPITAL, SEGURO]]></text>
		</element>
		<element kind="staticText" uuid="b7c00000-0000-0000-0000-000000000202" mode="Opaque" x="0" y="16" width="70" height="22" backcolor="#EDF2F7" forecolor="#4A5568" fontName="Tahoma" fontSize="7.0" bold="true" hTextAlign="Left" vTextAlign="Middle">
			<text><![CDATA[Fecha del pago]]></text>
			<box leftPadding="4"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="staticText" uuid="b7c00000-0000-0000-0000-000000000203" mode="Opaque" x="70" y="16" width="150" height="22" backcolor="#EDF2F7" forecolor="#4A5568" fontName="Tahoma" fontSize="7.0" bold="true" hTextAlign="Left" vTextAlign="Middle">
			<text><![CDATA[Operacion]]></text>
			<box leftPadding="4"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="staticText" uuid="b7c00000-0000-0000-0000-000000000204" mode="Opaque" x="220" y="16" width="78" height="22" backcolor="#EDF2F7" forecolor="#4A5568" fontName="Tahoma" fontSize="7.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<text><![CDATA[Desgrav.]]></text>
			<box rightPadding="4"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="staticText" uuid="b7c00000-0000-0000-0000-000000000205" mode="Opaque" x="298" y="16" width="70" height="22" backcolor="#EDF2F7" forecolor="#4A5568" fontName="Tahoma" fontSize="7.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<text><![CDATA[Mora]]></text>
			<box rightPadding="4"><pen lineWidth="0.25" lineColor="#CBD5E0"/></box>
		</element>
		<element kind="staticText" uuid="b7c00000-0000-0000-0000-000000000206" mode="Opaque" x="368" y="16" width="80" height="22" backcolor="#EDF2F7" forecolor="#4A5568" fontName="Tahoma" fontSize="7.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<text><![CDATA[Int. vencido]]></text>
