<!-- Comprobante de pagos de la cuota (CRD). Estilo corporativo cnt/crd + logo ASOPREP-FCPC. Ver docs/logica-negocio/crd/ESPECIFICACION-REPORTE-JASPER-COMPROBANTE-PAGOS-CUOTA.md -->
<jasperReport name="RPRT_CMPB_PGCT" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="792" leftMargin="25" rightMargin="25" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection" uuid="b7c00000-0000-0000-0000-000000000000">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Oracle"/>
	<property name="com.jaspersoft.studio.report.description" value="Comprobante de pagos de una cuota (DTPR): pagos registrados, composicion de la cuota y observaciones."/>
	<parameter name="P_DTPR_CODIGO" class="java.lang.Long">
		<description><![CDATA[Codigo de la cuota (CRD.DTPR.DTPRCDGO)]]></description>
	</parameter>
	<parameter name="P_IMAGEN" class="java.awt.Image">
		<description><![CDATA[Logo del fondo. Lo inyecta ReporteServiceImpl si el frontend no lo envia.]]></description>
	</parameter>
	<parameter name="P_USUARIO" class="java.lang.String">
		<description><![CDATA[Usuario que genera el reporte (opcional)]]></description>
	</parameter>
	<query language="SQL"><![CDATA[SELECT
    d.DTPRCDGO                                                        AS CODIGO_CUOTA,
    d.DTPRNMCT                                                        AS NUMERO_CUOTA,
    d.DTPRFCVN                                                        AS FECHA_VENCIMIENTO,
    CASE NVL(d.DTPRESTD, -1)
        WHEN 1 THEN 'Pendiente'
        WHEN 2 THEN 'Activa'
        WHEN 3 THEN 'Emitida'
        WHEN 4 THEN 'Pagada'
        WHEN 5 THEN 'En mora'
        WHEN 6 THEN 'Parcial'
        WHEN 7 THEN 'Cancelada anticipada'
        WHEN 8 THEN 'Vencida'
        ELSE 'Estado ' || TO_CHAR(d.DTPRESTD)
    END                                                              AS ESTADO_TXT,
    NVL(NVL(NULLIF(d.DTPRTTLL, 0), d.DTPRCTAA), 0)                    AS CUOTA_TOTAL,
    -- Saldo pendiente = suma de la columna "Pendiente" de la composicion (§3.5), igual que en
    -- pantalla. DTPRSLDO NO servia: no incluye la mora (interes en mora) ni otros conceptos.
    (  GREATEST(NVL(d.DTPRDSGR, 0) - NVL((SELECT SUM(x.PGPRDSGR) FROM CRD.PGPR x WHERE x.DTPRCDGO = d.DTPRCDGO AND NVL(x.PGPRANUL, 0) = 0), 0), 0)
     + GREATEST(NVL(d.DTPRSLMR, 0), 0)
     + GREATEST(NVL(d.DTPRSLIV, 0), 0)
     + GREATEST(NVL(d.DTPRSLIN, 0), 0)
     + GREATEST(NVL(d.DTPRCPTL, 0) - NVL((SELECT SUM(x.PGPRCPPG) FROM CRD.PGPR x WHERE x.DTPRCDGO = d.DTPRCDGO AND NVL(x.PGPRANUL, 0) = 0), 0), 0)
     + GREATEST(NVL(d.DTPRVLSI, 0) - NVL((SELECT SUM(x.PGPRVLSI) FROM CRD.PGPR x WHERE x.DTPRCDGO = d.DTPRCDGO AND NVL(x.PGPRANUL, 0) = 0), 0), 0)
     + GREATEST(NVL(d.DTPRSLOT, 0) - NVL((SELECT SUM(x.PGPRSLOT) FROM CRD.PGPR x WHERE x.DTPRCDGO = d.DTPRCDGO AND NVL(x.PGPRANUL, 0) = 0), 0), 0)
    )                                                                AS SALDO_PENDIENTE,
    -- Valores PACTADOS de la cuota
    NVL(d.DTPRDSGR, 0)                                                AS PAC_DSGR,
    NVL(d.DTPRMRAA, 0)                                                AS PAC_MORA,
    NVL(d.DTPRINVN, 0)                                                AS PAC_INVN,
    NVL(d.DTPRINTR, 0)                                                AS PAC_INTR,
    NVL(d.DTPRCPTL, 0)                                                AS PAC_CPTL,
    NVL(d.DTPRVLSI, 0)                                                AS PAC_SEGU,
    NVL(d.DTPRSLOT, 0)                                                AS PAC_EXTRA,
    -- SALDOS pendientes por concepto (autoritativos, piso en 0)
    GREATEST(NVL(d.DTPRSLMR, 0), 0)                                  AS SAL_MORA,
    GREATEST(NVL(d.DTPRSLIV, 0), 0)                                  AS SAL_INVN,
    GREATEST(NVL(d.DTPRSLIN, 0), 0)                                  AS SAL_INTR,
    GREATEST(NVL(d.DTPRSLCP, 0), 0)                                  AS SAL_CPTL,
    -- Contexto de la cabecera
    p.PRSTCDGO                                                        AS PRESTAMO_CODIGO,
    p.PRSTIDAS                                                        AS ID_ASOPREP,
    pr.PRDCNMBR                                                       AS PRODUCTO_NOMBRE,
    e.ENTDRZNS                                                        AS PARTICIPE,
    -- Agregados de pagos VIGENTES (subconsultas escalares; excluyen anulados)
    (SELECT NVL(SUM(x.PGPRVLRR), 0) FROM CRD.PGPR x WHERE x.DTPRCDGO = d.DTPRCDGO AND NVL(x.PGPRANUL, 0) = 0) AS TOTAL_PAGADO,
    (SELECT COUNT(*)                FROM CRD.PGPR x WHERE x.DTPRCDGO = d.DTPRCDGO AND NVL(x.PGPRANUL, 0) = 0) AS NUM_PAGOS,
    (SELECT NVL(SUM(x.PGPRDSGR), 0) FROM CRD.PGPR x WHERE x.DTPRCDGO = d.DTPRCDGO AND NVL(x.PGPRANUL, 0) = 0) AS SUM_DSGR,
    (SELECT NVL(SUM(x.PGPRMRPG), 0) FROM CRD.PGPR x WHERE x.DTPRCDGO = d.DTPRCDGO AND NVL(x.PGPRANUL, 0) = 0) AS SUM_MORA,
    (SELECT NVL(SUM(x.PGPRINVP), 0) FROM CRD.PGPR x WHERE x.DTPRCDGO = d.DTPRCDGO AND NVL(x.PGPRANUL, 0) = 0) AS SUM_INVN,
    (SELECT NVL(SUM(x.PGPRINPG), 0) FROM CRD.PGPR x WHERE x.DTPRCDGO = d.DTPRCDGO AND NVL(x.PGPRANUL, 0) = 0) AS SUM_INTR,
    (SELECT NVL(SUM(x.PGPRCPPG), 0) FROM CRD.PGPR x WHERE x.DTPRCDGO = d.DTPRCDGO AND NVL(x.PGPRANUL, 0) = 0) AS SUM_CPTL,
    (SELECT NVL(SUM(x.PGPRVLSI), 0) FROM CRD.PGPR x WHERE x.DTPRCDGO = d.DTPRCDGO AND NVL(x.PGPRANUL, 0) = 0) AS SUM_SEGU,
    (SELECT NVL(SUM(x.PGPRSLOT), 0) FROM CRD.PGPR x WHERE x.DTPRCDGO = d.DTPRCDGO AND NVL(x.PGPRANUL, 0) = 0) AS SUM_EXTRA,
    -- Fila de pago (NULL si la cuota no tiene pagos vigentes)
    g.PGPRCDGO                                                        AS PAGO_CODIGO,
    g.PGPRFCHA                                                        AS FECHA_PAGO,
    CASE
        WHEN g.PGPRTPOO IS NULL              THEN 'Pago de cuota'
        WHEN g.PGPRTPOO = 'PAGO_MANUAL'      THEN 'Pago de cuota'
        WHEN g.PGPRTPOO = 'PAGO_APORTES'     THEN 'Pago con aportes'
        WHEN g.PGPRTPOO = 'ABONO_CAPITAL'    THEN 'Abono a capital'
        WHEN g.PGPRTPOO = 'PRECANCELACION'   THEN 'Precancelacion'
        WHEN g.PGPRTPOO = 'REGISTRO_APORTE'  THEN 'Registro de aporte'
        WHEN g.PGPRTPOO = 'DESCUENTO_NOMINA' THEN 'Descuento por nomina'
        WHEN g.PGPRTPOO = 'MIGRACION'        THEN 'Saldo migrado'
        ELSE LOWER(REPLACE(g.PGPRTPOO, '_', ' '))
    END                                                              AS OPERACION_TXT,
    g.EVPRCDGO                                                        AS EVENTO_CODIGO,
    NVL(g.PGPRDSGR, 0)                                               AS PG_DSGR,
    NVL(g.PGPRMRPG, 0)                                               AS PG_MORA,
    NVL(g.PGPRINVP, 0)                                               AS PG_INVN,
    NVL(g.PGPRINPG, 0)                                               AS PG_INTR,
    NVL(g.PGPRCPPG, 0)                                               AS PG_CPTL,
    NVL(g.PGPRVLSI, 0)                                               AS PG_SEGU,
    NVL(g.PGPRVLRR, 0)                                               AS PG_TOTAL,
    g.PGPROBSR                                                        AS PG_OBS
FROM CRD.DTPR d
     JOIN CRD.PRST p  ON p.PRSTCDGO = d.PRSTCDGO
     JOIN CRD.PRDC pr ON pr.PRDCCDGO = p.PRDCCDGO
     JOIN CRD.ENTD e  ON e.ENTDCDGO = p.ENTDCDGO
     LEFT JOIN CRD.PGPR g ON g.DTPRCDGO = d.DTPRCDGO AND NVL(g.PGPRANUL, 0) = 0
WHERE d.DTPRCDGO = $P{P_DTPR_CODIGO}
ORDER BY g.PGPRFCHA ASC NULLS LAST]]></query>
	<field name="CODIGO_CUOTA" class="java.math.BigDecimal"/>
	<field name="NUMERO_CUOTA" class="java.math.BigDecimal"/>
	<field name="FECHA_VENCIMIENTO" class="java.sql.Timestamp"/>
	<field name="ESTADO_TXT" class="java.lang.String"/>
	<field name="CUOTA_TOTAL" class="java.math.BigDecimal"/>
	<field name="SALDO_PENDIENTE" class="java.math.BigDecimal"/>
	<field name="PAC_DSGR" class="java.math.BigDecimal"/>
	<field name="PAC_MORA" class="java.math.BigDecimal"/>
	<field name="PAC_INVN" class="java.math.BigDecimal"/>
	<field name="PAC_INTR" class="java.math.BigDecimal"/>
	<field name="PAC_CPTL" class="java.math.BigDecimal"/>
	<field name="PAC_SEGU" class="java.math.BigDecimal"/>
	<field name="PAC_EXTRA" class="java.math.BigDecimal"/>
	<field name="SAL_MORA" class="java.math.BigDecimal"/>
	<field name="SAL_INVN" class="java.math.BigDecimal"/>
	<field name="SAL_INTR" class="java.math.BigDecimal"/>
	<field name="SAL_CPTL" class="java.math.BigDecimal"/>
	<field name="PRESTAMO_CODIGO" class="java.math.BigDecimal"/>
	<field name="ID_ASOPREP" class="java.math.BigDecimal"/>
	<field name="PRODUCTO_NOMBRE" class="java.lang.String"/>
	<field name="PARTICIPE" class="java.lang.String"/>
	<field name="TOTAL_PAGADO" class="java.math.BigDecimal"/>
	<field name="NUM_PAGOS" class="java.math.BigDecimal"/>
	<field name="SUM_DSGR" class="java.math.BigDecimal"/>
	<field name="SUM_MORA" class="java.math.BigDecimal"/>
	<field name="SUM_INVN" class="java.math.BigDecimal"/>
	<field name="SUM_INTR" class="java.math.BigDecimal"/>
	<field name="SUM_CPTL" class="java.math.BigDecimal"/>
	<field name="SUM_SEGU" class="java.math.BigDecimal"/>
	<field name="SUM_EXTRA" class="java.math.BigDecimal"/>
	<field name="PAGO_CODIGO" class="java.math.BigDecimal"/>
	<field name="FECHA_PAGO" class="java.sql.Timestamp"/>
	<field name="OPERACION_TXT" class="java.lang.String"/>
	<field name="EVENTO_CODIGO" class="java.math.BigDecimal"/>
	<field name="PG_DSGR" class="java.math.BigDecimal"/>
	<field name="PG_MORA" class="java.math.BigDecimal"/>
	<field name="PG_INVN" class="java.math.BigDecimal"/>
	<field name="PG_INTR" class="java.math.BigDecimal"/>
	<field name="PG_CPTL" class="java.math.BigDecimal"/>
	<field name="PG_SEGU" class="java.math.BigDecimal"/>
	<field name="PG_TOTAL" class="java.math.BigDecimal"/>
	<field name="PG_OBS" class="java.lang.String"/>
	<variable name="V_OBS" class="java.lang.String" calculation="Nothing" resetType="Report">
		<expression><![CDATA[($V{V_OBS} == null ? "" : $V{V_OBS})
+ ( ($F{PG_OBS} != null && $F{PG_OBS}.trim().length() > 0 && $F{FECHA_PAGO} != null)
    ? ( new java.text.SimpleDateFormat("d/M/yyyy").format($F{FECHA_PAGO}) + "   " + $F{PG_OBS}.trim() + "\n" )
    : "" )]]></expression>
		<initialValueExpression><![CDATA[""]]></initialValueExpression>
	</variable>
	<background splitType="Stretch"/>
	<title height="162" splitType="Stretch">
		<!-- CABECERA con LOGO -->
		<element kind="image" uuid="b7c00000-0000-0000-0000-000000000101" x="0" y="4" width="120" height="60" scaleImage="RetainShape" onErrorType="Blank" hImageAlign="Center" vImageAlign="Middle">
			<expression><![CDATA[$P{P_IMAGEN}]]></expression>
		</element>
		<element kind="rectangle" uuid="b7c00000-0000-0000-0000-000000000102" x="130" y="4" width="555" height="60">
			<pen lineWidth="0.75" lineColor="#CBD5E0"/>
		</element>
		<element kind="textField" uuid="b7c00000-0000-0000-0000-000000000103" x="142" y="12" width="531" height="26" forecolor="#1A202C" fontName="Tahoma" fontSize="16.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
			<expression><![CDATA["Pagos de la cuota #" + $F{NUMERO_CUOTA}.toBigInteger()]]></expression>
		</element>
		<element kind="textField" uuid="b7c00000-0000-0000-0000-000000000104" x="142" y="38" width="531" height="18" forecolor="#718096" fontName="Tahoma" fontSize="10.0" hTextAlign="Center" vTextAlign="Middle">
			<expression><![CDATA[$F{PRODUCTO_NOMBRE} + " #" + ($F{ID_ASOPREP} != null ? $F{ID_ASOPREP}.toBigInteger().toString() : $F{PRESTAMO_CODIGO}.toBigInteger().toString())]]></expression>
		</element>
		<element kind="textField" uuid="b7c00000-0000-0000-0000-000000000105" x="692" y="8" width="100" height="12" forecolor="#718096" fontSize="7.0" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA["Generado: " + new java.text.SimpleDateFormat("d/M/yyyy h:mm a").format(new java.util.Date())]]></expression>
		</element>
		<element kind="textField" uuid="b7c00000-0000-0000-0000-000000000106" x="692" y="22" width="100" height="12" forecolor="#718096" fontSize="7.0" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA[$P{P_USUARIO} != null ? ("Por: " + $P{P_USUARIO}) : null]]></expression>
		</element>
		<!-- BANDA DE DATOS -->
		<element kind="staticText" uuid="b7c00000-0000-0000-0000-000000000110" mode="Opaque" x="0" y="74" width="792" height="14" backcolor="#EDF2F7" forecolor="#4A5568" fontName="Tahoma" fontSize="8.0" bold="true" hTextAlign="Left" vTextAlign="Middle">
			<text><![CDATA[DATOS DE LA CUOTA]]></text>
			<box leftPadding="6">
				<pen lineWidth="0.25" lineColor="#CBD5E0"/>
			</box>
		</element>
