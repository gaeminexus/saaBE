			<element kind="textField" uuid="e5000000-0000-0000-0000-000000000404" x="200" y="0" width="70" height="14" fontSize="7.0" pattern="#,##0.00" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA[$F{PGPCVLRR}]]></expression>
				<box rightPadding="4"><pen lineWidth="0.25"/></box>
			</element>
			<element kind="textField" uuid="e5000000-0000-0000-0000-000000000405" x="270" y="0" width="80" height="14" fontSize="6.5" hTextAlign="Center" vTextAlign="Middle">
				<expression><![CDATA[$F{PGPCESTD_TXT}]]></expression>
				<box><pen lineWidth="0.25"/></box>
			</element>
			<element kind="textField" uuid="e5000000-0000-0000-0000-000000000406" x="350" y="0" width="75" height="14" fontSize="7.0" pattern="#,##0.00" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA[$F{DINERO_BANCO}]]></expression>
				<box rightPadding="4"><pen lineWidth="0.25"/></box>
			</element>
			<element kind="textField" uuid="e5000000-0000-0000-0000-000000000407" x="425" y="0" width="80" height="14" fontSize="7.0" pattern="#,##0.00" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA[$F{CRUZADO_PRESTAMOS}]]></expression>
				<box rightPadding="4"><pen lineWidth="0.25"/></box>
			</element>
