			<element kind="textField" uuid="e5000000-0000-0000-0000-000000000403" x="130" y="0" width="70" height="14" fontSize="7.0" pattern="#,##0.00" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA[$F{PGPCVLSG}]]></expression>
