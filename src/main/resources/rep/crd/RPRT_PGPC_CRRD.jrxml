<!-- Reporte de la corrida mensual de pago de pension complementaria a jubilados. Contrato: docs/logica-negocio/crd/API-PAGO-PENSION-COMPLEMENTARIA.md (Sec 4/4quater/8). -->
<!-- PENDIENTE DE COMPILAR (bloqueante): este .jrxml NO tiene su .jasper todavia. En esta maquina no hay Jaspersoft Studio 7.0.3 (solo iReport 5.6.0, discontinuado e incompatible: un .jasper generado con eso apunta a JasperReports 5.6, no a 7.0.3, y ReporteServiceImpl:110 exige el .jasper: sin el, este reporte revienta la primera vez que alguien lo ejecuta). El usuario tiene Jaspersoft Studio 7.0.3 y lo compila el. NO ESTA COMPLETO hasta que el .jasper se agregue en el mismo directorio y se commitee. -->
<!-- REDISENADO 2026-09-05 (segunda vuelta): la primera version filtraba por PGPCFCRG (fecha de -->
<!-- EJECUCION de la corrida) usando P_ANIO/P_MES como si fueran ese mes calendario. La corrida real -->
<!-- se ejecuto el 4-5 de septiembre pero el usuario pidio el reporte con P_ANIO/P_MES=2026/8 (el -->
<!-- PERIODO que queria ver): la seccion de pagados salio vacia y TODOS los jubilados, incluidos -->
<!-- los que si cobraron, cayeron en "sin pago" (su fila de septiembre no calzaba en la ventana de -->
<!-- agosto que pedia el filtro). Confirmado sin ambiguedad con un caso real: GARCIA SALTOS MILTON -->
<!-- RENEE (PGPC 4, prestamo 7747, devengo CRE-2026-08-0168 y cruce CRE-2026-08-0167, ambos del -->
<!-- 2026-09-04/05) tenia que aparecer pagado y el reporte lo mostraba "sin pago". -->
<!-- NUEVO CRITERIO: P_ANIO/P_MES es el PERIODO CUBIERTO (PGPCANNO/PGPCMESS), el criterio intuitivo -->
<!-- para quien pide "el reporte de agosto". Para no perder el detalle retroactivo (un jubilado -->
<!-- pagado hoy por varios meses atrasados en la MISMA corrida), la CTE "objetivo" encuentra a los -->
<!-- jubilados con al menos una fila en el periodo pedido y despues trae TODAS sus filas de la MISMA -->
<!-- fecha de corrida (TRUNC(PGPCFCRG) igual): asi se ve el retroactivo completo de cada uno, no -->
<!-- solo la porcion que etiqueta el periodo pedido. -->
<!-- LIMITES DEL MODELO DE DATOS, verificados contra el codigo antes de escribir esta query (no inventar mas alla de esto): -->
<!--   1) NO hay vinculo grabado entre un PGPC y la CUOTA especifica que cruzo: pero SI hay FK real -->
<!--      de PGPR (pago de cuota) a PRST (prestamo) y a DTPR (cuota). La correlacion PGPC->PGPR sigue -->
<!--      siendo HEURISTICA (por entidad del prestamo + TRUNC(PGPRFCHA)=PGPCFCHA, misma variable -->
<!--      'fecha' del bucle retroactivo), pero ya no hace falta parsear texto de ninguna glosa: el -->
<!--      numero de prestamo y de cuota salen de columnas reales (PRSTCDGO, PGPRNMCT). -->
<!--   2) Un jubilado BLOQUEADO no genera NINGUNA fila en PGPC, y el motivo de bloqueo NO SE PERSISTE -->
<!--      en ninguna tabla: solo existe transitoriamente en la respuesta HTTP de -->
<!--      previsualizarCorrida/generarPagosDelMes. Por eso este reporte NO PUEDE mostrar el motivo -->
<!--      real de un bloqueo de un periodo ya pasado: es un limite del modelo de datos, no una -->
<!--      omision del reporte. Solo se puede contar CUANTOS jubilados no tienen fila: la ausencia -->
<!--      no distingue "bloqueado" de "al dia, no se le debia nada". -->
<!--   3) P_IDEMPRESA no filtra jubilados: ni CRD.PGPC ni CRD.ENTD ni CRD.FLLL tienen columna de -->
<!--      empresa (verificado leyendo las tres entidades). Solo se usa para ubicar la orden de pago -->
<!--      al proveedor del seguro medico en PGS.PGTR (que si es multiempresa). -->
<jasperReport name="RPRT_PGPC_CRRD" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30" whenNoDataType="AllSectionsNoDetail" uuid="e5000000-0000-0000-0000-000000000001">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Oracle"/>
	<property name="com.jaspersoft.studio.report.description" value="Corrida mensual de pago de pension complementaria a jubilados: resumen, detalle de cruce a prestamos con cuotas/capital/interes, y seguro"/>
	<parameter name="P_ANIO" class="java.lang.Long">
		<description><![CDATA[Anio del PERIODO CUBIERTO por el pago (PGPCANNO) -- el que el usuario quiere ver, no la fecha de ejecucion de la corrida]]></description>
	</parameter>
	<parameter name="P_MES" class="java.lang.Long">
		<description><![CDATA[Mes (1-12) del PERIODO CUBIERTO por el pago (PGPCMESS)]]></description>
	</parameter>
	<parameter name="P_IDEMPRESA" class="java.lang.Long">
		<description><![CDATA[Empresa contable -- solo se usa para ubicar la orden de pago al proveedor del seguro en PGS.PGTR]]></description>
	</parameter>
	<parameter name="P_USUARIO" class="java.lang.String"/>
	<query language="SQL"><![CDATA[WITH objetivo AS (
    SELECT DISTINCT p.ENTDCDGO AS ENTDCDGO, TRUNC(p.PGPCFCRG) AS FECHA_CORRIDA
    FROM CRD.PGPC p
    WHERE p.PGPCANNO = $P{P_ANIO}
      AND p.PGPCMESS = $P{P_MES}
),
cruce AS (
    SELECT pr.ENTDCDGO AS ENTDCDGO,
           TRUNC(g.PGPRFCHA) AS FECHA,
           SUM(g.PGPRVLRR) AS CRZ_VALOR,
           LISTAGG(
               'Prestamo ' || TO_CHAR(pr.PRSTCDGO) || ' cuota ' || TO_CHAR(g.PGPRNMCT)
               || ': capital $' || TO_CHAR(NVL(g.PGPRCPPG,0), 'FM999999990.00')
               || ', interes $' || TO_CHAR(NVL(g.PGPRINPG,0) + NVL(g.PGPRINVP,0), 'FM999999990.00')
               || ', mora $' || TO_CHAR(NVL(g.PGPRMRPG,0), 'FM999999990.00'),
               '; '
           ) WITHIN GROUP (ORDER BY g.PGPRFCHA, g.PGPRCDGO) AS CRZ_DETALLE
    FROM CRD.PGPR g
    JOIN CRD.PRST pr ON pr.PRSTCDGO = g.PRSTCDGO
    WHERE (g.PGPRANUL IS NULL OR g.PGPRANUL = 0)
    GROUP BY pr.ENTDCDGO, TRUNC(g.PGPRFCHA)
)
SELECT
    e.ENTDCDGO AS ENTDCDGO,
    e.ENTDNMID AS ENTDNMID,
    e.ENTDRZNS AS ENTDRZNS,
    p.PGPCCDGO AS PGPCCDGO,
    p.PGPCANNO AS PGPCANNO,
    p.PGPCMESS AS PGPCMESS,
    p.PGPCVLPN AS PGPCVLPN,
    p.PGPCVLSG AS PGPCVLSG,
    p.PGPCVLRR AS PGPCVLRR,
    CASE p.PGPCESTD
        WHEN 1 THEN 'REGISTRADA'
        WHEN 2 THEN 'EN_PAGO'
        WHEN 3 THEN 'PAGADA'
        WHEN 4 THEN 'RECHAZADA'
        WHEN 5 THEN 'ANULADA'
        ELSE 'Estado ' || TO_CHAR(p.PGPCESTD)
    END AS PGPCESTD_TXT,
    p.PGPCFCHA AS PGPCFCHA,
    p.PGPCFCRG AS PGPCFCRG,
    p.PGPCFCPG AS PGPCFCPG,
    CASE WHEN p.PGPCESTD IN (2,3) THEN p.PGPCVLPN ELSE 0 END AS DINERO_BANCO,
    NVL(cr.CRZ_VALOR, 0) AS CRUZADO_PRESTAMOS,
    NVL(cr.CRZ_DETALLE, 'Sin cruce a prestamo este mes') AS DETALLE_CRUCE_PRESTAMOS,
    (SELECT MAX(g2.PGTRCDGO) FROM PGS.PGTR g2
       WHERE g2.PGTRORGN = 'CRD_SEGURO_JUBILADOS'
         AND g2.PGTRIDOR = ($P{P_ANIO} * 100 + $P{P_MES})
         AND g2.PGTRPJRQ = $P{P_IDEMPRESA}) AS ORDEN_PROVEEDOR_CDGO,
    (SELECT MAX(g2.PGTRVLOR) FROM PGS.PGTR g2
       WHERE g2.PGTRORGN = 'CRD_SEGURO_JUBILADOS'
         AND g2.PGTRIDOR = ($P{P_ANIO} * 100 + $P{P_MES})
         AND g2.PGTRPJRQ = $P{P_IDEMPRESA}) AS ORDEN_PROVEEDOR_VALOR,
    (SELECT COUNT(*) FROM CRD.ENTD ee WHERE ee.ENTDIDST = 3) AS CANT_EVALUADOS,
    (SELECT COUNT(DISTINCT ee.ENTDCDGO) FROM CRD.ENTD ee
        WHERE ee.ENTDIDST = 3
        AND EXISTS (SELECT 1 FROM CRD.PGPC pp WHERE pp.ENTDCDGO = ee.ENTDCDGO
                    AND pp.PGPCANNO = $P{P_ANIO} AND pp.PGPCMESS = $P{P_MES})) AS CANT_PAGADOS,
    (SELECT COUNT(*) FROM CRD.ENTD ee
        WHERE ee.ENTDIDST = 3
        AND NOT EXISTS (SELECT 1 FROM CRD.PGPC pp WHERE pp.ENTDCDGO = ee.ENTDCDGO
                        AND pp.PGPCANNO = $P{P_ANIO} AND pp.PGPCMESS = $P{P_MES})) AS CANT_SIN_PAGO
FROM objetivo o
JOIN CRD.PGPC p ON p.ENTDCDGO = o.ENTDCDGO AND TRUNC(p.PGPCFCRG) = o.FECHA_CORRIDA
JOIN CRD.ENTD e ON e.ENTDCDGO = p.ENTDCDGO
LEFT JOIN cruce cr ON cr.ENTDCDGO = p.ENTDCDGO AND cr.FECHA = p.PGPCFCHA
ORDER BY e.ENTDRZNS, p.PGPCANNO, p.PGPCMESS]]></query>
	<field name="ENTDCDGO" class="java.math.BigDecimal"/>
	<field name="ENTDNMID" class="java.lang.String"/>
	<field name="ENTDRZNS" class="java.lang.String"/>
	<field name="PGPCCDGO" class="java.math.BigDecimal"/>
	<field name="PGPCANNO" class="java.math.BigDecimal"/>
	<field name="PGPCMESS" class="java.math.BigDecimal"/>
	<field name="PGPCVLPN" class="java.math.BigDecimal"/>
	<field name="PGPCVLSG" class="java.math.BigDecimal"/>
	<field name="PGPCVLRR" class="java.math.BigDecimal"/>
	<field name="PGPCESTD_TXT" class="java.lang.String"/>
	<field name="PGPCFCHA" class="java.sql.Date"/>
	<field name="PGPCFCRG" class="java.sql.Timestamp"/>
	<field name="PGPCFCPG" class="java.sql.Date"/>
	<field name="DINERO_BANCO" class="java.math.BigDecimal"/>
	<field name="CRUZADO_PRESTAMOS" class="java.math.BigDecimal"/>
	<field name="DETALLE_CRUCE_PRESTAMOS" class="java.lang.String"/>
	<field name="ORDEN_PROVEEDOR_CDGO" class="java.math.BigDecimal"/>
	<field name="ORDEN_PROVEEDOR_VALOR" class="java.math.BigDecimal"/>
	<field name="CANT_EVALUADOS" class="java.math.BigDecimal"/>
	<field name="CANT_PAGADOS" class="java.math.BigDecimal"/>
	<field name="CANT_SIN_PAGO" class="java.math.BigDecimal"/>
	<variable name="V_TOTAL_PENSION" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{PGPCVLPN} != null ? $F{PGPCVLPN} : java.math.BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="V_TOTAL_SEGURO" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{PGPCVLSG} != null ? $F{PGPCVLSG} : java.math.BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="V_TOTAL_GENERAL" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{PGPCVLRR} != null ? $F{PGPCVLRR} : java.math.BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="V_TOTAL_DINERO_BANCO" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{DINERO_BANCO} != null ? $F{DINERO_BANCO} : java.math.BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="V_TOTAL_CRUZADO" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CRUZADO_PRESTAMOS} != null ? $F{CRUZADO_PRESTAMOS} : java.math.BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="V_SUBTOTAL_JUBILADO" calculation="Sum" class="java.math.BigDecimal" resetType="Group" resetGroup="G_JUBILADO">
		<expression><![CDATA[$F{PGPCVLRR} != null ? $F{PGPCVLRR} : java.math.BigDecimal.ZERO]]></expression>
	</variable>
	<group name="G_JUBILADO">
		<expression><![CDATA[$F{ENTDCDGO}]]></expression>
		<groupHeader>
			<band height="16" splitType="Stretch">
				<element kind="textField" uuid="e5000000-0000-0000-0000-000000000111" mode="Opaque" x="0" y="0" width="782" height="16" backcolor="#EEEEEE" fontName="Tahoma" fontSize="8.0" bold="true" hTextAlign="Left" vTextAlign="Middle">
					<expression><![CDATA[$F{ENTDNMID} + " - " + $F{ENTDRZNS}]]></expression>
					<box leftPadding="4"><pen lineWidth="0.25"/></box>
				</element>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="14" splitType="Stretch">
				<element kind="staticText" uuid="e5000000-0000-0000-0000-000000000112" x="600" y="0" width="120" height="14" fontName="Tahoma" fontSize="7.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
					<text><![CDATA[Subtotal jubilado:]]></text>
				</element>
				<element kind="textField" uuid="e5000000-0000-0000-0000-000000000113" x="722" y="0" width="60" height="14" fontName="Tahoma" fontSize="7.0" bold="true" pattern="#,##0.00" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true">
					<expression><![CDATA[$V{V_SUBTOTAL_JUBILADO}]]></expression>
				</element>
			</band>
		</groupFooter>
	</group>
	<background splitType="Stretch"/>
	<title height="190" splitType="Stretch">
		<element kind="staticText" uuid="e5000000-0000-0000-0000-000000000201" x="0" y="0" width="782" height="20" fontName="Tahoma" fontSize="12.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
			<text><![CDATA[REPORTE MENSUAL DE PAGO DE PENSION COMPLEMENTARIA A JUBILADOS]]></text>
		</element>
		<element kind="textField" uuid="e5000000-0000-0000-0000-000000000202" x="0" y="22" width="782" height="16" fontName="Tahoma" fontSize="9.0" hTextAlign="Center" vTextAlign="Middle">
			<expression><![CDATA["Periodo cubierto: " + $P{P_MES} + "/" + $P{P_ANIO} + " -- empresa " + $P{P_IDEMPRESA}]]></expression>
		</element>
		<element kind="staticText" uuid="e5000000-0000-0000-0000-000000000203" x="0" y="40" width="782" height="12" fontName="Tahoma" fontSize="7.0" italic="true" hTextAlign="Center" vTextAlign="Middle">
			<text><![CDATA[El filtro es el PERIODO CUBIERTO por el pago (PGPCANNO/PGPCMESS). Si un jubilado cobro varios meses atrasados en esta misma corrida, se muestran TODAS sus filas de esa corrida, no solo la de este periodo.]]></text>
		</element>
		<element kind="staticText" uuid="e5000000-0000-0000-0000-000000000206" mode="Opaque" x="0" y="56" width="782" height="14" backcolor="#D1D1D1" fontName="Tahoma" fontSize="8.5" bold="true" hTextAlign="Left" vTextAlign="Middle">
			<text><![CDATA[RESUMEN DE LA CORRIDA]]></text>
			<box leftPadding="4"/>
		</element>
		<element kind="textField" uuid="e5000000-0000-0000-0000-000000000207" x="0" y="71" width="782" height="14" fontName="Tahoma" fontSize="8.0" hTextAlign="Left" vTextAlign="Middle" evaluationTime="Report">
			<expression><![CDATA["Jubilados JUBILADO_COMPLEMENTARIO evaluados: " + $F{CANT_EVALUADOS}
    + "   |   Con pago generado este periodo: " + $F{CANT_PAGADOS}
    + "   |   Sin pago generado este periodo: " + $F{CANT_SIN_PAGO}
    + " (bloqueado o al dia -- no se distingue, ver nota al pie)"]]></expression>
			<box leftPadding="4"/>
		</element>
		<element kind="textField" uuid="e5000000-0000-0000-0000-000000000208" x="0" y="87" width="782" height="16" fontName="Tahoma" fontSize="9.0" bold="true" hTextAlign="Left" vTextAlign="Middle" evaluationTime="Report">
			<expression><![CDATA["Total pension: $" + $V{V_TOTAL_PENSION}.setScale(2, java.math.RoundingMode.HALF_UP)
    + "   Total seguro: $" + $V{V_TOTAL_SEGURO}.setScale(2, java.math.RoundingMode.HALF_UP)
    + "   Total cruzado a prestamos: $" + $V{V_TOTAL_CRUZADO}.setScale(2, java.math.RoundingMode.HALF_UP)
    + "   Total transferido al banco: $" + $V{V_TOTAL_DINERO_BANCO}.setScale(2, java.math.RoundingMode.HALF_UP)
    + "   TOTAL GENERAL: $" + $V{V_TOTAL_GENERAL}.setScale(2, java.math.RoundingMode.HALF_UP)]]></expression>
			<box leftPadding="4"/>
		</element>
		<element kind="textField" uuid="e5000000-0000-0000-0000-000000000209" x="0" y="105" width="782" height="14" fontName="Tahoma" fontSize="8.0" hTextAlign="Left" vTextAlign="Middle" evaluationTime="Report">
			<expression><![CDATA[$F{ORDEN_PROVEEDOR_CDGO} == null
    ? "Orden de pago al proveedor del seguro medico del periodo: NO ENCONTRADA para " + $P{P_MES} + "/" + $P{P_ANIO}
    : "Orden de pago al proveedor del seguro medico del periodo: PagoProgramado " + $F{ORDEN_PROVEEDOR_CDGO}.longValue()
        + " -- $" + $F{ORDEN_PROVEEDOR_VALOR}.setScale(2, java.math.RoundingMode.HALF_UP)]]></expression>
			<box leftPadding="4"/>
		</element>
		<element kind="staticText" uuid="e5000000-0000-0000-0000-000000000210" x="0" y="123" width="782" height="36" fontName="Tahoma" fontSize="6.5" italic="true" hTextAlign="Left" vTextAlign="Top">
			<text><![CDATA[Cruzado a prestamos: heuristica por entidad del prestamo + fecha contra CRD.PGPR (pagos de cuota vigentes) -- no hay FK grabada de PGPC a la cuota que cancelo. ADVERTENCIA: si un mismo jubilado tuvo cruces contra DOS prestamos distintos el mismo dia -- el caso NORMAL de un retroactivo de varios meses de mora, no una excepcion -- el detalle de esta columna puede agrupar o atribuir mal las cuotas entre esos prestamos; no tomarlo como exacto en ese escenario, solo como orientacion. La ausencia de fila en CRD.PGPC no distingue jubilado bloqueado de jubilado al dia -- ese dato no se persiste hoy en ninguna tabla (no existe forma de mostrar el motivo real de un bloqueo pasado). Si "Con pago generado" + "Sin pago generado" no suma el total de evaluados, o si el resumen de arriba aparece en blanco, es que no hubo ninguna fila para este periodo -- revisar el detalle abajo.]]></text>
		</element>
		<element kind="textField" uuid="e5000000-0000-0000-0000-000000000204" x="0" y="172" width="391" height="12" fontName="Tahoma" fontSize="7.0" hTextAlign="Left" vTextAlign="Middle">
			<expression><![CDATA["Generado por: " + $P{P_USUARIO}]]></expression>
		</element>
		<element kind="textField" uuid="e5000000-0000-0000-0000-000000000205" x="391" y="172" width="391" height="12" fontName="Tahoma" fontSize="7.0" pattern="dd/MM/yyyy HH:mm" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA[new java.util.Date()]]></expression>
		</element>
	</title>
	<columnHeader height="16" splitType="Stretch">
		<element kind="staticText" uuid="e5000000-0000-0000-0000-000000000301" mode="Opaque" x="0" y="0" width="60" height="16" backcolor="#EEEEEE" fontName="Tahoma" fontSize="7.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
			<text><![CDATA[PERIODO]]></text>
			<box><pen lineWidth="0.25"/></box>
		</element>
		<element kind="staticText" uuid="e5000000-0000-0000-0000-000000000302" mode="Opaque" x="60" y="0" width="70" height="16" backcolor="#EEEEEE" fontName="Tahoma" fontSize="7.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<text><![CDATA[PENSION]]></text>
			<box rightPadding="4"><pen lineWidth="0.25"/></box>
		</element>
		<element kind="staticText" uuid="e5000000-0000-0000-0000-000000000303" mode="Opaque" x="130" y="0" width="70" height="16" backcolor="#EEEEEE" fontName="Tahoma" fontSize="7.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<text><![CDATA[SEGURO]]></text>
			<box rightPadding="4"><pen lineWidth="0.25"/></box>
		</element>
		<element kind="staticText" uuid="e5000000-0000-0000-0000-000000000304" mode="Opaque" x="200" y="0" width="70" height="16" backcolor="#EEEEEE" fontName="Tahoma" fontSize="7.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<text><![CDATA[TOTAL]]></text>
			<box rightPadding="4"><pen lineWidth="0.25"/></box>
		</element>
		<element kind="staticText" uuid="e5000000-0000-0000-0000-000000000305" mode="Opaque" x="270" y="0" width="80" height="16" backcolor="#EEEEEE" fontName="Tahoma" fontSize="7.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
			<text><![CDATA[ESTADO]]></text>
			<box><pen lineWidth="0.25"/></box>
		</element>
		<element kind="staticText" uuid="e5000000-0000-0000-0000-000000000306" mode="Opaque" x="350" y="0" width="75" height="16" backcolor="#EEEEEE" fontName="Tahoma" fontSize="7.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<text><![CDATA[DINERO AL BANCO]]></text>
			<box rightPadding="4"><pen lineWidth="0.25"/></box>
		</element>
		<element kind="staticText" uuid="e5000000-0000-0000-0000-000000000307" mode="Opaque" x="425" y="0" width="80" height="16" backcolor="#EEEEEE" fontName="Tahoma" fontSize="7.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<text><![CDATA[CRUZADO PRESTAMOS]]></text>
			<box rightPadding="4"><pen lineWidth="0.25"/></box>
		</element>
		<element kind="staticText" uuid="e5000000-0000-0000-0000-000000000308" mode="Opaque" x="505" y="0" width="277" height="16" backcolor="#EEEEEE" fontName="Tahoma" fontSize="7.0" bold="true" hTextAlign="Left" vTextAlign="Middle">
			<text><![CDATA[DETALLE DEL CRUCE (prestamo / cuota / capital / interes / mora)]]></text>
			<box leftPadding="4"><pen lineWidth="0.25"/></box>
		</element>
	</columnHeader>
	<detail>
		<band height="14" splitType="Stretch">
			<element kind="textField" uuid="e5000000-0000-0000-0000-000000000401" x="0" y="0" width="60" height="14" fontSize="7.0" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle">
				<expression><![CDATA[$F{PGPCMESS} == null ? "" : ($F{PGPCMESS}.intValue() + "/" + $F{PGPCANNO}.intValue())]]></expression>
				<box><pen lineWidth="0.25"/></box>
			</element>
			<element kind="textField" uuid="e5000000-0000-0000-0000-000000000402" x="60" y="0" width="70" height="14" fontSize="7.0" pattern="#,##0.00" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA[$F{PGPCVLPN}]]></expression>
				<box rightPadding="4"><pen lineWidth="0.25"/></box>
			</element>
			<element kind="textField" uuid="e5000000-0000-0000-0000-000000000403" x="130" y="0" width="70" height="14" fontSize="7.0" pattern="#,##0.00" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA[$F{PGPCVLSG}]]></expression>
