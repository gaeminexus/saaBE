	</columnHeader>
	<detail>
		<band height="14" splitType="Stretch">
			<element kind="textField" uuid="e5000000-0000-0000-0000-000000000401" x="0" y="0" width="60" height="14" fontSize="7.0" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle">
				<expression><![CDATA[$F{PGPCMESS} == null ? "" : ($F{PGPCMESS}.intValue() + "/" + $F{PGPCANNO}.intValue())]]></expression>
				<box><pen lineWidth="0.25"/></box>
			</element>
			<element kind="textField" uuid="e5000000-0000-0000-0000-000000000402" x="60" y="0" width="70" height="14" fontSize="7.0" pattern="#,##0.00" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA[$F{PGPCVLPN}]]></expression>
