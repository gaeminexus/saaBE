				<box leftPadding="3" rightPadding="3"/>
			</element>
			<element kind="staticText" positionType="Float" uuid="a4000001-0000-0000-0000-000000000060" x="0" y="398" width="535" height="13" mode="Opaque" backcolor="#1F3864" forecolor="#FFFFFF" fontSize="9.0" bold="true" hTextAlign="Left" vTextAlign="Middle">
				<text><![CDATA[4. VERIFICACIÓN Y RECEPCIÓN]]></text>
				<box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#000000"/></box>
			</element>
			<element kind="rectangle" uuid="a4000001-0000-0000-0000-000000000061" positionType="Float" x="0" y="411" width="262" height="110" mode="Transparent">
