			<element kind="staticText" uuid="a4000001-0000-0000-0000-000000000066" positionType="Float" x="273" y="428" width="262" height="12" fontSize="8.0" hTextAlign="Left" vTextAlign="Middle">
				<text><![CDATA[Recibido y registrado en nómina.]]></text>
				<box leftPadding="3" rightPadding="3"/>
			</element>
			<element kind="line" uuid="a4000001-0000-0000-0000-000000000067" positionType="Float" x="30" y="475" width="200" height="1"/>
			<element kind="line" uuid="a4000001-0000-0000-0000-000000000068" positionType="Float" x="303" y="475" width="200" height="1"/>
