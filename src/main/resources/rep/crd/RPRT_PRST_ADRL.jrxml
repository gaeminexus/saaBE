<!-- Autorización de descuento por rol de pagos (CRD) — formato FOR-CRE-AUT-01 del cliente.
     DISENO-SOLICITUD-V1-AUTORIZACION-Y-REGLAS-OTORGAMIENTO.md (A3) + DISENO-IMPRESOS-OTORGAMIENTO.md (IM1-IM3, IM8, IM15).
     Sintaxis compacta. Se llena por <query> con P_PRSTCDGO (una fila): sin SELECT *, columnas explícitas. SIN fontName
     (ni Tahoma): el exportador PDF pierde la negrita. IM1: el texto fijo es LITERAL del modelo. IM2: un dato sin fuente
     sale como línea para llenar a mano. IM3: el número de operación es PRSTIDAS; sin él, marca BORRADOR. IM8: la ciudad
     es QUITO fija y la fecha larga es la de aprobación (sin aprobar, la de impresión). La cuota es DTPRTTLL de la cuota 1
     (con desgravamen e incendio; el pagaré usa la cuota sin desgravamen). El anexo «Diccionario de campos» NO se imprime.
     Los montos se formatean con NumeroALetrasUtil.formatearMontoEc (clase del WAR, crd.util). -->
<jasperReport name="RPRT_PRST_ADRL" language="java" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="25" bottomMargin="25" whenNoDataType="AllSectionsNoDetail" uuid="a4000001-0000-0000-0000-999999999999">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Oracle"/>
	<property name="com.jaspersoft.studio.report.description" value="Autorización de descuento por rol de pagos (FOR-CRE-AUT-01)"/>
	<parameter name="P_PRSTCDGO" class="java.lang.Long"><description><![CDATA[Código del préstamo (CRD.PRST.PRSTCDGO).]]></description></parameter>
	<parameter name="P_IMAGEN" class="java.awt.Image"><description><![CDATA[Logo. Lo inyecta ReporteServiceImpl.]]></description></parameter>
	<parameter name="P_USUARIO" class="java.lang.String"><description><![CDATA[Usuario que imprime (pie de página).]]></description></parameter>
	<query language="SQL"><![CDATA[SELECT p.PRSTCDGO                                   AS NRO_SOLICITUD,
       p.PRSTIDAS                                   AS NRO_OPERACION,
       p.PRSTIDST                                   AS ID_ESTADO,
       TO_CHAR(COALESCE(TRUNC(p.PRSTFCAP), TRUNC(SYSDATE)), 'FMDD "de" month "de" YYYY', 'NLS_DATE_LANGUAGE=SPANISH') AS FECHA_LARGA,
       TRIM(e.ENTDRZNS)                             AS NOMBRES_APELLIDOS,
       TRIM(e.ENTDNMID)                             AS CEDULA,
       TRIM(TO_CHAR(e.ENTDRLPC))                    AS CODIGO_EMPLEADO,
       TRIM(pt.PRTCCRGA)                            AS CARGO,
       TRIM(pt.PRTCUNAD)                            AS UNIDAD,
       TRIM(pt.PRTCLGRT)                            AS LUGAR_TRABAJO,
       UPPER(TRIM(tp.TPPRNMBR))                     AS TIPO_PRESTAMO,
       TRIM(pr.PRDCCDPT)                            AS COD_DESCUENTO,
       p.PRSTMNSL                                   AS MONTO,
       p.PRSTTSAA                                   AS TASA,
       p.PRSTPLZO                                   AS NRO_CUOTAS,
       (SELECT MAX(d.DTPRTTLL) FROM CRD.DTPR d WHERE d.PRSTCDGO = p.PRSTCDGO AND d.DTPRNMCT = 1) AS CUOTA,
       TO_CHAR((SELECT MIN(d.DTPRFCVN) FROM CRD.DTPR d WHERE d.PRSTCDGO = p.PRSTCDGO AND d.DTPRNMCT >= 1), 'FMMONTH YYYY', 'NLS_DATE_LANGUAGE=SPANISH') AS MES_PRIMER_DESCUENTO,
       TO_CHAR((SELECT MAX(d.DTPRFCVN) FROM CRD.DTPR d WHERE d.PRSTCDGO = p.PRSTCDGO AND d.DTPRNMCT >= 1), 'FMMONTH YYYY', 'NLS_DATE_LANGUAGE=SPANISH') AS MES_ULTIMO_DESCUENTO,
       TRIM(p.PRSTUSRG)                             AS USUARIO_ELABORA
  FROM CRD.PRST p
  JOIN CRD.ENTD e   ON e.ENTDCDGO  = p.ENTDCDGO
  JOIN CRD.PRDC pr  ON pr.PRDCCDGO = p.PRDCCDGO
  LEFT JOIN CRD.TPPR tp ON tp.TPPRCDGO = pr.TPPRCDGO
  LEFT JOIN CRD.PRTC pt ON pt.PRTCCDGO = (SELECT MAX(t2.PRTCCDGO) FROM CRD.PRTC t2 WHERE t2.ENTDCDGO = e.ENTDCDGO)
 WHERE p.PRSTCDGO = $P{P_PRSTCDGO}]]></query>
