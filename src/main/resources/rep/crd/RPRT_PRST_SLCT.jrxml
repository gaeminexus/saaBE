<!-- Solicitud de crédito (CRD) — formato FOR-CRE-SOL-01 del cliente.
     DISENO-IMPRESOS-OTORGAMIENTO.md (IM1, IM2, IM10–IM15). Sintaxis compacta. Se llena por <query> con P_PRSTCDGO
     (una fila): sin SELECT *, columnas explícitas. SIN fontName (ni Tahoma): el exportador PDF pierde la negrita.
     IM1: el texto fijo es LITERAL del modelo (generado desde el texto del cliente). IM2: un dato sin fuente sale como
     línea para llenar a mano. IM14: las casillas son rectángulos dibujados (la fuente del PDF no trae el carácter).
     El anexo «Diccionario de campos» NO se imprime. Las secciones 6 y 7 (uso de Crédito) van en página aparte.
     Los montos se formatean con NumeroALetrasUtil.formatearMontoEc (clase del WAR, crd.util). -->
<jasperReport name="RPRT_PRST_SLCT" language="java" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="25" bottomMargin="25" whenNoDataType="AllSectionsNoDetail" uuid="a3000001-0000-0000-0000-000000000000">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Oracle"/>
	<property name="com.jaspersoft.studio.report.description" value="Solicitud de crédito (FOR-CRE-SOL-01)"/>
	<parameter name="P_PRSTCDGO" class="java.lang.Long"><description><![CDATA[Código del préstamo (CRD.PRST.PRSTCDGO).]]></description></parameter>
	<parameter name="P_IMAGEN" class="java.awt.Image"><description><![CDATA[Logo. Lo inyecta ReporteServiceImpl.]]></description></parameter>
	<parameter name="P_USUARIO" class="java.lang.String"><description><![CDATA[Usuario que imprime (pie de página).]]></description></parameter>
	<parameter name="P_SALDO_CREDITOS_VIGENTES" class="java.math.BigDecimal"><description><![CDATA[Opcional: saldo de los créditos vigentes del partícipe. No hay fuente en SQL (el saldo lo calcula el servicio de saldos); sin valor sale en blanco.]]></description></parameter>
	<query language="SQL"><![CDATA[SELECT p.PRSTCDGO                                   AS NRO_SOLICITUD,
       COALESCE(TRUNC(p.PRSTFCRG), TRUNC(p.PRSTFCHA)) AS FECHA_SOLICITUD,
       p.PRSTIDST                                   AS ID_ESTADO,
       e.ENTDCDGO                                   AS CODIGO_PARTICIPE,
       TRIM(e.ENTDRZNS)                             AS NOMBRES_APELLIDOS,
       TRIM(e.ENTDNMID)                             AS CEDULA,
       TRIM(e.ENTDFCNC)                             AS FECHA_NACIMIENTO,
       TRIM(ec.ESCVNMBR)                            AS ESTADO_CIVIL,
       TRIM(pt.PRTCLGRT)                            AS EMPLEADOR,
       CASE e.ENTDIDST WHEN 1 THEN 'ACTIVO' WHEN 8 THEN 'ACTIVO'
                       WHEN 3 THEN 'JUBILADO' WHEN 6 THEN 'JUBILADO' WHEN 7 THEN 'JUBILADO' END AS CONDICION,
       TRIM(pt.PRTCCRGA)                            AS CARGO,
       TRUNC(pt.PRTCFCIT)                           AS FECHA_INGRESO,
       COALESCE(TRIM(dr.DRCCCLPR || CASE WHEN dr.DRCCNMRO IS NOT NULL THEN ' ' || TRIM(dr.DRCCNMRO) END
                                 || CASE WHEN dr.DRCCCLSC IS NOT NULL THEN ' y ' || TRIM(dr.DRCCCLSC) END),
                TRIM(dr.DRCCDSCR))                  AS DIRECCION,
       COALESCE(TRIM(e.ENTDTLFN), TRIM(dr.DRCCTLFN)) AS TELEFONO,
       COALESCE(TRIM(e.ENTDMVLI), TRIM(dr.DRCCCLLR)) AS CELULAR,
       COALESCE(TRIM(e.ENTDCRPR), TRIM(e.ENTDCRIN)) AS EMAIL,
       UPPER(TRIM(tp.TPPRNMBR))                     AS TIPO_PRESTAMO,
       p.PRSTTSAA                                   AS TASA,
       p.PRSTMNSL                                   AS MONTO,
       p.PRSTPLZO                                   AS NRO_CUOTAS,
       p.PRSTVLCT                                   AS CUOTA_ESTIMADA,
       TRIM(mv.MTVPNMBR)                            AS DESTINO_CREDITO,
       p.PRSTPROR                                   AS ID_ORIGINAL,
       NVL(p.PRSTESNV, 0)                           AS ES_NOVACION,
       NVL(p.PRSTRSTR, 0)                           AS REESTRUCTURADO,
       po.PRSTIDAS                                  AS NRO_OP_ANTERIOR,
       (SELECT SUM(a.APRTVLRR) FROM CRD.APRT a
          JOIN CRD.TPAP ta ON ta.TPAPCDGO = a.TPAPCDGO
         WHERE a.ENTDCDGO = e.ENTDCDGO AND ta.TPAPIDST = 1) AS SALDO_CTA_INDIVIDUAL,
       (SELECT pe.PRECTTIN FROM CRD.PREC pe
         WHERE pe.PRECCDGO = (SELECT MAX(pe2.PRECCDGO) FROM CRD.PREC pe2
                               WHERE pe2.PRSTCDGO = p.PRSTCDGO AND NVL(pe2.PRECIDST, 1) = 1)) AS INGRESO_MENSUAL,
       (SELECT SUM(v.PRSTVLCT) FROM CRD.PRST v
         WHERE v.ENTDCDGO = e.ENTDCDGO AND v.PRSTCDGO <> p.PRSTCDGO
           AND v.PRSTIDST IN (2, 8, 11))            AS CUOTAS_VIGENTES,
       CASE WHEN p.PRSTPROR IS NULL THEN p.PRSTMNSL
            WHEN p.PRSTVLSS IS NOT NULL THEN p.PRSTMNSL - p.PRSTVLSS END AS VALOR_LIQUIDO,
       TRIM(bx.BEXTNMBR)                            AS BANCO,
       CASE cb.CNBPTPCN WHEN 1 THEN 'AHORROS' WHEN 2 THEN 'CORRIENTE' END AS TIPO_CUENTA,
       TRIM(cb.CNBPNMRO)                            AS NRO_CUENTA,
       TRIM(p.PRSTUSRG)                             AS USUARIO_ELABORA,
       TRIM(p.PRSTUSAP)                             AS APROBADOR
  FROM CRD.PRST p
  JOIN CRD.ENTD e   ON e.ENTDCDGO  = p.ENTDCDGO
  JOIN CRD.PRDC pr  ON pr.PRDCCDGO = p.PRDCCDGO
  LEFT JOIN CRD.TPPR tp ON tp.TPPRCDGO = pr.TPPRCDGO
  LEFT JOIN CRD.MTVP mv ON mv.MTVPCDGO = p.MTVPCDGO
  LEFT JOIN CRD.PRST po ON po.PRSTCDGO = p.PRSTPROR
  LEFT JOIN CRD.ESCV ec ON ec.ESCVCDGO = e.ESCVCDGO
  LEFT JOIN CRD.PRTC pt ON pt.PRTCCDGO = (SELECT MAX(t2.PRTCCDGO) FROM CRD.PRTC t2 WHERE t2.ENTDCDGO = e.ENTDCDGO)
  LEFT JOIN CRD.DRCC dr ON dr.DRCCCDGO = (SELECT MAX(d2.DRCCCDGO) KEEP (DENSE_RANK FIRST ORDER BY NVL(d2.DRCCPRDF, 0) DESC, d2.DRCCCDGO DESC)
                                            FROM CRD.DRCC d2
                                           WHERE d2.ENTDCDGO = e.ENTDCDGO AND NVL(d2.DRCCIDST, 1) = 1
                                             AND NVL(d2.DRCCTRBJ, 0) <> 1
                                             AND NOT EXISTS (SELECT 1 FROM CRD.DRTR t WHERE t.DRCCCDGO = d2.DRCCCDGO))
  LEFT JOIN CRD.CNBP cb ON cb.CNBPCDGO = (SELECT MAX(c3.CNBPCDGO) FROM CRD.CNBP c3
                                           WHERE c3.ENTDCDGO = e.ENTDCDGO AND NVL(c3.CNBPIDST, 1) = 1)
  LEFT JOIN TSR.BEXT bx ON bx.BEXTCDGO = cb.BEXTCDGO
 WHERE p.PRSTCDGO = $P{P_PRSTCDGO}]]></query>
