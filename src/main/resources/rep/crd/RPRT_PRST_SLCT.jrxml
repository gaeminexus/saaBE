				<expression><![CDATA["USD " + ($F{CAPACIDAD_PAGO} != null ? com.saa.ejb.crd.util.NumeroALetrasUtil.formatearMontoEc(Double.valueOf($F{CAPACIDAD_PAGO}.doubleValue())) : "____________")]]></expression>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box>
			</element>
			<element kind="staticText" uuid="a3000001-0000-0000-0000-000000000076" x="0" y="435" width="112" height="14" mode="Opaque" backcolor="#E6E6E6" fontSize="8.0" bold="true" hTextAlign="Left" vTextAlign="Middle">
				<text><![CDATA[Monto máximo a otorgar]]></text>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box>
			</element>
			<element kind="textField" uuid="a3000001-0000-0000-0000-000000000077" x="112" y="435" width="150" height="14" fontSize="8.0" hTextAlign="Left" vTextAlign="Middle">
				<expression><![CDATA["USD " + ($F{SALDO_CTA_INDIVIDUAL} != null ? com.saa.ejb.crd.util.NumeroALetrasUtil.formatearMontoEc(Double.valueOf($F{SALDO_CTA_INDIVIDUAL}.doubleValue())) : "____________")]]></expression>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box>
			</element>
			<element kind="staticText" uuid="a3000001-0000-0000-0000-000000000078" x="262" y="435" width="130" height="14" mode="Opaque" backcolor="#E6E6E6" fontSize="8.0" bold="true" hTextAlign="Left" vTextAlign="Middle">
				<text><![CDATA[Valor líquido a recibir]]></text>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box>
			</element>
			<element kind="textField" uuid="a3000001-0000-0000-0000-000000000079" x="392" y="435" width="143" height="14" fontSize="8.0" hTextAlign="Left" vTextAlign="Middle">
				<expression><![CDATA["USD " + ($F{VALOR_LIQUIDO} != null ? com.saa.ejb.crd.util.NumeroALetrasUtil.formatearMontoEc(Double.valueOf($F{VALOR_LIQUIDO}.doubleValue())) : "____________")]]></expression>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box>
			</element>
			<element kind="staticText" uuid="a3000001-0000-0000-0000-000000000080" x="0" y="453" width="535" height="13" mode="Opaque" backcolor="#1F3864" forecolor="#FFFFFF" fontSize="9.0" bold="true" hTextAlign="Left" vTextAlign="Middle">
				<text><![CDATA[4. AUTORIZACIÓN DE DESCUENTO Y ACREDITACIÓN]]></text>
				<box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#000000"/></box>
			</element>
			<element kind="textField" uuid="a3000001-0000-0000-0000-000000000081" x="0" y="468" width="535" height="33" fontSize="8.0" hTextAlign="Justified" vTextAlign="Top" textAdjust="StretchHeight">
				<expression><![CDATA["Ratifico mi autorización a " + ($F{EMPLEADOR} != null && !$F{EMPLEADOR}.isEmpty() ? $F{EMPLEADOR} : "______________________") + " para que me descuente mensualmente por Rol de Pagos el aporte, así como la cuota mensual correspondiente por los créditos que mantengo en ASOPREP-FCPC, y solicito que el valor que me corresponde por el crédito " + ($F{TIPO_PRESTAMO} != null && !$F{TIPO_PRESTAMO}.isEmpty() ? $F{TIPO_PRESTAMO} : "____________") + " que me encuentro tramitando se deposite a la siguiente cuenta, de la cual soy titular:"]]></expression>
				<box leftPadding="0" rightPadding="0"/>
			</element>
			<element kind="staticText" uuid="a3000001-0000-0000-0000-000000000082" x="0" y="501" width="112" height="14" mode="Opaque" backcolor="#E6E6E6" fontSize="8.0" bold="true" hTextAlign="Left" vTextAlign="Middle">
				<text><![CDATA[Banco]]></text>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box>
			</element>
			<element kind="textField" uuid="a3000001-0000-0000-0000-000000000083" x="112" y="501" width="423" height="14" fontSize="8.0" hTextAlign="Left" vTextAlign="Middle">
				<expression><![CDATA[($F{BANCO} != null && !$F{BANCO}.isEmpty() ? $F{BANCO} : "____________")]]></expression>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box>
			</element>
			<element kind="staticText" uuid="a3000001-0000-0000-0000-000000000084" x="0" y="515" width="112" height="14" mode="Opaque" backcolor="#E6E6E6" fontSize="8.0" bold="true" hTextAlign="Left" vTextAlign="Middle">
				<text><![CDATA[Tipo de cuenta]]></text>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box>
			</element>
			<element kind="textField" uuid="a3000001-0000-0000-0000-000000000085" x="112" y="515" width="423" height="14" fontSize="8.0" hTextAlign="Left" vTextAlign="Middle">
				<expression><![CDATA[($F{TIPO_CUENTA} != null && !$F{TIPO_CUENTA}.isEmpty() ? $F{TIPO_CUENTA} : "____________")]]></expression>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box>
			</element>
			<element kind="staticText" uuid="a3000001-0000-0000-0000-000000000086" x="0" y="529" width="112" height="14" mode="Opaque" backcolor="#E6E6E6" fontSize="8.0" bold="true" hTextAlign="Left" vTextAlign="Middle">
				<text><![CDATA[Número]]></text>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box>
			</element>
			<element kind="textField" uuid="a3000001-0000-0000-0000-000000000087" x="112" y="529" width="423" height="14" fontSize="8.0" hTextAlign="Left" vTextAlign="Middle">
				<expression><![CDATA[($F{NRO_CUENTA} != null && !$F{NRO_CUENTA}.isEmpty() ? $F{NRO_CUENTA} : "____________")]]></expression>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box>
			</element>
			<element kind="textField" uuid="a3000001-0000-0000-0000-000000000301" x="0" y="547" width="535" height="36" fontSize="8.0" hTextAlign="Justified" vTextAlign="Top" textAdjust="StretchHeight" markup="styled">
				<expression><![CDATA["<style isBold='true'>Plazo de desembolso:</style> Una vez aprobada la presente solicitud y suscritos el pagaré y la tabla de amortización, el valor líquido del crédito será acreditado en la cuenta antes indicada en un plazo máximo de setenta y dos (72) horas hábiles, entendiéndose por tales las comprendidas en días laborables de lunes a viernes, excluidos feriados nacionales y locales."]]></expression>
				<box leftPadding="0" rightPadding="0"/>
			</element>
		</band>
		<band height="262" splitType="Stretch">
			<element kind="break" uuid="a3000001-0000-0000-0000-000000000302" x="0" y="0" width="535" height="1"/>
			<element kind="staticText" uuid="a3000001-0000-0000-0000-000000000088" x="0" y="22" width="535" height="13" mode="Opaque" backcolor="#1F3864" forecolor="#FFFFFF" fontSize="9.0" bold="true" hTextAlign="Left" vTextAlign="Middle">
				<text><![CDATA[5. AUTORIZACIONES Y DECLARACIONES DEL PARTÍCIPE]]></text>
				<box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#000000"/></box>
			</element>
			<element kind="textField" uuid="a3000001-0000-0000-0000-000000000089" x="0" y="38" width="535" height="125" fontSize="7.5" hTextAlign="Justified" vTextAlign="Top" textAdjust="StretchHeight">
				<expression><![CDATA["a) Burós y referencias crediticias: Autorizo expresa e irrevocablemente a la ASOCIACIÓN DEL FONDO COMPLEMENTARIO PREVISIONAL CERRADO ASOPREP-FCPC, DE JUBILACIÓN Y CESANTÍA, DE LAS EMPRESAS PÚBLICAS DEL SECTOR HIDROCARBURÍFERO, o a quien sea el futuro cesionario, beneficiario o acreedor del crédito solicitado o del documento o título cambiario que lo respalde, para que obtenga cuantas veces sean necesarias, de cualquier fuente de información, incluidos los burós de crédito, mi información de riesgos crediticios; y, de igual forma, para que pueda transferir o entregar dicha información a los burós de crédito o a las entidades que los sustituyan, a cualquier persona jurídica que preste servicios de referencias crediticias, a la Central de Riesgos si fuera pertinente y/o a cualquier persona natural o jurídica que brinde servicios de cobranza.\nb) Garantía con cuenta individual: Acepto que, en caso de incumplimiento, cese o desvinculación, los valores adeudados a ASOPREP-FCPC sean compensados con el saldo de mi cuenta individual, de conformidad con la normativa vigente.\nc) Licitud de fondos: Declaro que los recursos con los que cancelaré el presente crédito provienen de actividades lícitas y que no serán destinados a ninguna actividad relacionada con el lavado de activos, financiamiento del terrorismo u otros delitos.\nd) Protección de datos personales: Conforme a la Ley Orgánica de Protección de Datos Personales, autorizo a ASOPREP-FCPC el tratamiento de mis datos personales para fines de análisis, otorgamiento, administración y recuperación del crédito.\ne) Veracidad: Declaro bajo juramento que la información y documentación entregadas son legítimas y verdaderas y, en consecuencia, eximo a ASOPREP-FCPC de toda responsabilidad si éstas fueran falsas o erróneas. Asimismo, autorizo expresamente a ASOPREP-FCPC a realizar el análisis que considere pertinente e informar a las autoridades competentes si fuera el caso."]]></expression>
				<box leftPadding="0" rightPadding="0"/>
			</element>
			<element kind="line" positionType="Float" uuid="a3000001-0000-0000-0000-000000000090" x="150" y="225" width="235" height="1"/>
			<element kind="textField" uuid="a3000001-0000-0000-0000-000000000091" x="100" y="228" width="335" height="12" positionType="Float" fontSize="8.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
				<expression><![CDATA[($F{NOMBRES_APELLIDOS} != null && !$F{NOMBRES_APELLIDOS}.isEmpty() ? $F{NOMBRES_APELLIDOS} : "")]]></expression>
				<box leftPadding="3" rightPadding="3"/>
			</element>
			<element kind="textField" uuid="a3000001-0000-0000-0000-000000000092" x="100" y="240" width="335" height="12" positionType="Float" fontSize="8.0" hTextAlign="Center" vTextAlign="Middle">
				<expression><![CDATA["Firma del Partícipe — C.C. " + ($F{CEDULA} != null && !$F{CEDULA}.isEmpty() ? $F{CEDULA} : "")]]></expression>
				<box leftPadding="3" rightPadding="3"/>
			</element>
		</band>
