<!-- Solicitud de crédito (CRD) — formato FOR-CRE-SOL-01 del cliente.
     DISENO-IMPRESOS-OTORGAMIENTO.md (IM1, IM2, IM10–IM15). Sintaxis compacta. Se llena por <query> con P_PRSTCDGO
     (una fila): sin SELECT *, columnas explícitas. SIN fontName (ni Tahoma): el exportador PDF pierde la negrita.
     IM1: el texto fijo es LITERAL del modelo (generado desde el texto del cliente). IM2: un dato sin fuente sale como
     línea para llenar a mano. IM14: las casillas son rectángulos dibujados (la fuente del PDF no trae el carácter).
     El anexo «Diccionario de campos» NO se imprime. Las secciones 6 y 7 (uso de Crédito) van en página aparte.
     Los montos se formatean con NumeroALetrasUtil.formatearMontoEc (clase del WAR, crd.util).
     DISENO-SOLICITUD-V1-AUTORIZACION-Y-REGLAS-OTORGAMIENTO.md (2026-11-07): SV1-SV14. Formato V1 del cliente + las
     correcciones de la «super». EMPLEADOR = filial de la entidad; INGRESO_MENSUAL = PRTC.PRTCRMUN; CAPACIDAD_PAGO = 50 %
     del ingreso; MONTO_MAXIMO = cuenta individual (100 %); SALDO_CREDITOS_VIGENTES y DESCUENTOS se calculan en el query
     (el original de una novación entra SIEMPRE, también ya cancelado: A1-bis). El saldo de capital traduce a SQL
     PagoPrestamoService.calcularSaldoCapitalPendiente (cuotas fuera de 4/7: max(0, capital - capital pagado en PGPR
     vigente)); NO se usa PRSTSLCP (columna muerta). Cuota de un préstamo = DTPRTTLL de su primera cuota no pagada (>=1),
     o de la última si no le quedan pendientes. «Vigentes» = PRSTIDST IN (2, 8, 10, 11). -->
<jasperReport name="RPRT_PRST_SLCT" language="java" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="25" bottomMargin="25" whenNoDataType="AllSectionsNoDetail" uuid="a3000001-0000-0000-0000-000000000000">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Oracle"/>
	<property name="com.jaspersoft.studio.report.description" value="Solicitud de crédito (FOR-CRE-SOL-01)"/>
	<parameter name="P_PRSTCDGO" class="java.lang.Long"><description><![CDATA[Código del préstamo (CRD.PRST.PRSTCDGO).]]></description></parameter>
	<parameter name="P_IMAGEN" class="java.awt.Image"><description><![CDATA[Logo. Lo inyecta ReporteServiceImpl.]]></description></parameter>
	<parameter name="P_USUARIO" class="java.lang.String"><description><![CDATA[Usuario que imprime (pie de página).]]></description></parameter>
	<query language="SQL"><![CDATA[SELECT p.PRSTCDGO                                   AS NRO_SOLICITUD,
       COALESCE(TRUNC(p.PRSTFCRG), TRUNC(p.PRSTFCHA)) AS FECHA_SOLICITUD,
       TRUNC(p.PRSTFCAP)                            AS FECHA_APROBACION,
       (SELECT MAX(pg.PGTRFRSP) FROM PGS.PGTR pg WHERE pg.PGTRCDGO = p.PRSTIDPG AND pg.PGTRESTD = 3) AS FECHA_DESEMBOLSO,
       p.PRSTIDST                                   AS ID_ESTADO,
       e.ENTDCDGO                                   AS CODIGO_PARTICIPE,
       TRIM(e.ENTDRZNS)                             AS NOMBRES_APELLIDOS,
       TRIM(e.ENTDNMID)                             AS CEDULA,
       TRIM(e.ENTDFCNC)                             AS FECHA_NACIMIENTO,
       TRIM(ec.ESCVNMBR)                            AS ESTADO_CIVIL,
       TRIM(fl.FLLLNMBR)                            AS EMPLEADOR,
       CASE e.ENTDIDST WHEN 1 THEN 'ACTIVO' WHEN 8 THEN 'ACTIVO'
                       WHEN 3 THEN 'JUBILADO' WHEN 6 THEN 'JUBILADO' WHEN 7 THEN 'JUBILADO' END AS CONDICION,
       TRIM(pt.PRTCCRGA)                            AS CARGO,
       TRUNC(pt.PRTCFCIT)                           AS FECHA_INGRESO,
       COALESCE(TRIM(dr.DRCCCLPR || CASE WHEN dr.DRCCNMRO IS NOT NULL THEN ' ' || TRIM(dr.DRCCNMRO) END
                                 || CASE WHEN dr.DRCCCLSC IS NOT NULL THEN ' y ' || TRIM(dr.DRCCCLSC) END),
                TRIM(dr.DRCCDSCR))                  AS DIRECCION,
       COALESCE(TRIM(e.ENTDTLFN), TRIM(dr.DRCCTLFN)) AS TELEFONO,
       COALESCE(TRIM(e.ENTDMVLI), TRIM(dr.DRCCCLLR)) AS CELULAR,
       COALESCE(TRIM(e.ENTDCRPR), TRIM(e.ENTDCRIN)) AS EMAIL,
       UPPER(TRIM(tp.TPPRNMBR))                     AS TIPO_PRESTAMO,
       p.PRSTTSAA                                   AS TASA,
       p.PRSTMNSL                                   AS MONTO,
       p.PRSTPLZO                                   AS NRO_CUOTAS,
       p.PRSTVLCT                                   AS CUOTA_ESTIMADA,
       TRIM(mv.MTVPNMBR)                            AS DESTINO_CREDITO,
       p.PRSTPROR                                   AS ID_ORIGINAL,
       NVL(p.PRSTESNV, 0)                           AS ES_NOVACION,
       NVL(p.PRSTRSTR, 0)                           AS REESTRUCTURADO,
       po.PRSTIDAS                                  AS NRO_OP_ANTERIOR,
       (SELECT SUM(a.APRTVLRR) FROM CRD.APRT a
          JOIN CRD.TPAP ta ON ta.TPAPCDGO = a.TPAPCDGO
         WHERE a.ENTDCDGO = e.ENTDCDGO AND ta.TPAPIDST = 1) AS SALDO_CTA_INDIVIDUAL,
       CASE WHEN pt.PRTCRMUN > 0 THEN pt.PRTCRMUN END AS INGRESO_MENSUAL,
       CASE WHEN pt.PRTCRMUN > 0 THEN ROUND(pt.PRTCRMUN * 0.50, 2) END AS CAPACIDAD_PAGO,
       (SELECT SUM(CASE WHEN v.PRSTIDST IN (2, 8, 10, 11) THEN NVL(ROUND((SELECT SUM(GREATEST(0, NVL(d.DTPRCPTL, 0) - NVL((SELECT SUM(NVL(g.PGPRCPPG, 0)) FROM CRD.PGPR g
                                                                    WHERE g.DTPRCDGO = d.DTPRCDGO AND NVL(g.PGPRANUL, 0) = 0), 0)))
                           FROM CRD.DTPR d WHERE d.PRSTCDGO = v.PRSTCDGO AND (d.DTPRESTD IS NULL OR d.DTPRESTD NOT IN (4, 7))), 2), 0) ELSE NVL(p.PRSTVLSS, 0) END)
          FROM CRD.PRST v
         WHERE v.ENTDCDGO = e.ENTDCDGO AND v.PRSTCDGO <> p.PRSTCDGO
           AND (v.PRSTIDST IN (2, 8, 10, 11) OR v.PRSTCDGO = p.PRSTPROR)) AS SALDO_CREDITOS_VIGENTES,
       (SELECT SUM(COALESCE((SELECT MAX(d.DTPRTTLL) KEEP (DENSE_RANK FIRST ORDER BY d.DTPRNMCT) FROM CRD.DTPR d
                             WHERE d.PRSTCDGO = v.PRSTCDGO AND d.DTPRNMCT >= 1 AND (d.DTPRESTD IS NULL OR d.DTPRESTD NOT IN (4, 7))),
                           (SELECT MAX(d.DTPRTTLL) KEEP (DENSE_RANK LAST ORDER BY d.DTPRNMCT) FROM CRD.DTPR d
                             WHERE d.PRSTCDGO = v.PRSTCDGO AND d.DTPRNMCT >= 1),
                           v.PRSTVLCT, 0))
          FROM CRD.PRST v
         WHERE v.ENTDCDGO = e.ENTDCDGO AND v.PRSTCDGO <> p.PRSTCDGO
           AND (v.PRSTIDST IN (2, 8, 10, 11) OR v.PRSTCDGO = p.PRSTPROR)) AS DESCUENTOS,
       CASE WHEN p.PRSTPROR IS NOT NULL THEN COALESCE((SELECT MAX(d.DTPRTTLL) KEEP (DENSE_RANK FIRST ORDER BY d.DTPRNMCT) FROM CRD.DTPR d
                             WHERE d.PRSTCDGO = po.PRSTCDGO AND d.DTPRNMCT >= 1 AND (d.DTPRESTD IS NULL OR d.DTPRESTD NOT IN (4, 7))),
                           (SELECT MAX(d.DTPRTTLL) KEEP (DENSE_RANK LAST ORDER BY d.DTPRNMCT) FROM CRD.DTPR d
                             WHERE d.PRSTCDGO = po.PRSTCDGO AND d.DTPRNMCT >= 1),
                           po.PRSTVLCT, 0) ELSE 0 END AS CUOTAS_VIGENTES,
       CASE WHEN p.PRSTPROR IS NULL THEN p.PRSTMNSL
            WHEN p.PRSTVLSS IS NOT NULL THEN p.PRSTMNSL - p.PRSTVLSS
            WHEN po.PRSTIDST IN (2, 8, 10, 11) THEN p.PRSTMNSL - NVL(ROUND((SELECT SUM(GREATEST(0, NVL(d.DTPRCPTL, 0) - NVL((SELECT SUM(NVL(g.PGPRCPPG, 0)) FROM CRD.PGPR g
                                                                    WHERE g.DTPRCDGO = d.DTPRCDGO AND NVL(g.PGPRANUL, 0) = 0), 0)))
                           FROM CRD.DTPR d WHERE d.PRSTCDGO = po.PRSTCDGO AND (d.DTPRESTD IS NULL OR d.DTPRESTD NOT IN (4, 7))), 2), 0) END AS VALOR_LIQUIDO,
       TRIM(bx.BEXTNMBR)                            AS BANCO,
       CASE cb.CNBPTPCN WHEN 1 THEN 'AHORROS' WHEN 2 THEN 'CORRIENTE' END AS TIPO_CUENTA,
       TRIM(cb.CNBPNMRO)                            AS NRO_CUENTA,
       (SELECT n.NVAPNMBR || ' (' || c.TOTAL || CASE WHEN c.TOTAL = 1 THEN ' nivel)' ELSE ' niveles)' END
          FROM CRD.NVAP n
          JOIN (SELECT RGAPCDGO, COUNT(*) AS TOTAL, MAX(NVAPORDN) AS MX FROM CRD.NVAP WHERE NVAPESTD = 1 GROUP BY RGAPCDGO) c
            ON c.RGAPCDGO = n.RGAPCDGO AND n.NVAPORDN = c.MX AND n.NVAPESTD = 1
         WHERE n.RGAPCDGO = COALESCE((SELECT MAX(a.RGAPCDGO) KEEP (DENSE_RANK FIRST ORDER BY a.APPRORDN) FROM CRD.APPR a
                           WHERE a.PRSTCDGO = p.PRSTCDGO AND a.APPRESTD = 1),
                         (SELECT MIN(r.RGAPCDGO) KEEP (DENSE_RANK FIRST ORDER BY r.RGAPPRRD, r.RGAPCDGO) FROM CRD.RGAP r
                           WHERE r.RGAPESTD = 1 AND (r.TPPRCDGO IS NULL OR r.TPPRCDGO = pr.TPPRCDGO)
                             AND (r.RGAPMNMN IS NULL OR p.PRSTMNSL >= r.RGAPMNMN) AND (r.RGAPMNMX IS NULL OR p.PRSTMNSL <= r.RGAPMNMX)
                             AND (r.RGAPPLMN IS NULL OR p.PRSTPLZO >= r.RGAPPLMN) AND (r.RGAPPLMX IS NULL OR p.PRSTPLZO <= r.RGAPPLMX)))) AS NIVEL_APROBACION,
       (SELECT MAX(a2.APPRUSRO) FROM CRD.APPR a2
         WHERE a2.PRSTCDGO = p.PRSTCDGO AND a2.APPRESTD = 1 AND a2.APPRDCSN = 1
           AND a2.APPRORDN = (SELECT MAX(n2.NVAPORDN) FROM CRD.NVAP n2
                               WHERE n2.RGAPCDGO = COALESCE((SELECT MAX(a3.RGAPCDGO) KEEP (DENSE_RANK FIRST ORDER BY a3.APPRORDN) FROM CRD.APPR a3
                           WHERE a3.PRSTCDGO = p.PRSTCDGO AND a3.APPRESTD = 1),
                         (SELECT MIN(r3.RGAPCDGO) KEEP (DENSE_RANK FIRST ORDER BY r3.RGAPPRRD, r3.RGAPCDGO) FROM CRD.RGAP r3
                           WHERE r3.RGAPESTD = 1 AND (r3.TPPRCDGO IS NULL OR r3.TPPRCDGO = pr.TPPRCDGO)
                             AND (r3.RGAPMNMN IS NULL OR p.PRSTMNSL >= r3.RGAPMNMN) AND (r3.RGAPMNMX IS NULL OR p.PRSTMNSL <= r3.RGAPMNMX)
                             AND (r3.RGAPPLMN IS NULL OR p.PRSTPLZO >= r3.RGAPPLMN) AND (r3.RGAPPLMX IS NULL OR p.PRSTPLZO <= r3.RGAPPLMX)))
                                 AND n2.NVAPESTD = 1
                                 AND n2.NVAPORDN < (SELECT MAX(n3.NVAPORDN) FROM CRD.NVAP n3 WHERE n3.RGAPCDGO = n2.RGAPCDGO AND n3.NVAPESTD = 1))) AS REVISADO_POR,
       TRIM(p.PRSTUSRG)                             AS USUARIO_ELABORA,
       TRIM(p.PRSTUSAP)                             AS APROBADOR
  FROM CRD.PRST p
  JOIN CRD.ENTD e   ON e.ENTDCDGO  = p.ENTDCDGO
  JOIN CRD.PRDC pr  ON pr.PRDCCDGO = p.PRDCCDGO
  LEFT JOIN CRD.FLLL fl ON fl.FLLLCDGO = e.FLLLCDGO
  LEFT JOIN CRD.TPPR tp ON tp.TPPRCDGO = pr.TPPRCDGO
  LEFT JOIN CRD.MTVP mv ON mv.MTVPCDGO = p.MTVPCDGO
  LEFT JOIN CRD.PRST po ON po.PRSTCDGO = p.PRSTPROR
  LEFT JOIN CRD.ESCV ec ON ec.ESCVCDGO = e.ESCVCDGO
  LEFT JOIN CRD.PRTC pt ON pt.PRTCCDGO = (SELECT MAX(t2.PRTCCDGO) FROM CRD.PRTC t2 WHERE t2.ENTDCDGO = e.ENTDCDGO)
  LEFT JOIN CRD.DRCC dr ON dr.DRCCCDGO = (SELECT MAX(d2.DRCCCDGO) KEEP (DENSE_RANK FIRST ORDER BY NVL(d2.DRCCPRDF, 0) DESC, d2.DRCCCDGO DESC)
                                            FROM CRD.DRCC d2
                                           WHERE d2.ENTDCDGO = e.ENTDCDGO AND NVL(d2.DRCCIDST, 1) = 1
                                             AND NVL(d2.DRCCTRBJ, 0) <> 1
                                             AND NOT EXISTS (SELECT 1 FROM CRD.DRTR t WHERE t.DRCCCDGO = d2.DRCCCDGO))
  LEFT JOIN CRD.CNBP cb ON cb.CNBPCDGO = (SELECT MAX(c3.CNBPCDGO) FROM CRD.CNBP c3
                                           WHERE c3.ENTDCDGO = e.ENTDCDGO AND NVL(c3.CNBPIDST, 1) = 1)
  LEFT JOIN TSR.BEXT bx ON bx.BEXTCDGO = cb.BEXTCDGO
 WHERE p.PRSTCDGO = $P{P_PRSTCDGO}]]></query>
