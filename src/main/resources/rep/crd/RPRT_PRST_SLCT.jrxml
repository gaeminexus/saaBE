				<box leftPadding="3" rightPadding="3"/>
			</element>
			<element kind="rectangle" uuid="a3000001-0000-0000-0000-000000000006" x="395" y="0" width="140" height="62" mode="Transparent">
				<pen lineWidth="0.75" lineColor="#000000"/>
			</element>
			<element kind="textField" uuid="a3000001-0000-0000-0000-000000000007" x="395" y="6" width="140" height="16" fontSize="9.0" bold="true" hTextAlign="Left" vTextAlign="Middle">
				<expression><![CDATA["No. Solicitud: " + ($F{NRO_SOLICITUD} != null ? $F{NRO_SOLICITUD}.toBigInteger().toString() : "________")]]></expression>
				<box leftPadding="5" rightPadding="5"/>
			</element>
			<element kind="textField" uuid="a3000001-0000-0000-0000-000000000008" x="395" y="23" width="140" height="16" fontSize="9.0" bold="true" hTextAlign="Left" vTextAlign="Middle">
				<expression><![CDATA["Fecha: " + ($F{FECHA_SOLICITUD} != null ? new java.text.SimpleDateFormat("yyyy-MM-dd").format($F{FECHA_SOLICITUD}) : "____________")]]></expression>
				<box leftPadding="5" rightPadding="5"/>
			</element>
			<element kind="textField" uuid="a3000001-0000-0000-0000-000000000009" x="395" y="40" width="140" height="16" fontSize="9.0" bold="true" hTextAlign="Left" vTextAlign="Middle">
				<expression><![CDATA["Código: FOR-CRE-SOL-01"]]></expression>
				<box leftPadding="5" rightPadding="5"/>
			</element>
			<element kind="textField" uuid="a3000001-0000-0000-0000-000000000010" x="0" y="66" width="535" height="12" forecolor="#C0392B" fontSize="9.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
				<expression><![CDATA[$F{ID_ESTADO} != null && $F{ID_ESTADO}.intValue() == 12 ? "*** PRÉSTAMO ANULADO ***" : ($F{ID_ESTADO} != null && $F{ID_ESTADO}.intValue() == 7 ? "*** PRÉSTAMO RECHAZADO ***" : "")]]></expression>
				<box leftPadding="3" rightPadding="3"/>
			</element>
			<element kind="staticText" uuid="a3000001-0000-0000-0000-000000000011" x="0" y="79" width="535" height="24" fontSize="8.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
				<text><![CDATA[Asociación del Fondo Complementario Previsional Cerrado ASOPREP-FCPC, de Jubilación y Cesantía, de las Empresas Públicas del Sector Hidrocarburífero]]></text>
				<box leftPadding="3" rightPadding="3"/>
			</element>
			<element kind="staticText" uuid="a3000001-0000-0000-0000-000000000012" x="0" y="104" width="535" height="11" fontSize="8.5" hTextAlign="Left" vTextAlign="Middle">
				<text><![CDATA[Señores]]></text>
				<box leftPadding="3" rightPadding="3"/>
			</element>
			<element kind="staticText" uuid="a3000001-0000-0000-0000-000000000013" x="0" y="115" width="535" height="11" fontSize="8.5" bold="true" hTextAlign="Left" vTextAlign="Middle">
				<text><![CDATA[ASOPREP - FCPC]]></text>
				<box leftPadding="3" rightPadding="3"/>
			</element>
			<element kind="textField" uuid="a3000001-0000-0000-0000-000000000014" x="0" y="128" width="535" height="46" fontSize="8.0" hTextAlign="Justified" vTextAlign="Top" textAdjust="StretchHeight">
				<expression><![CDATA["Yo, " + ($F{NOMBRES_APELLIDOS} != null && !$F{NOMBRES_APELLIDOS}.isEmpty() ? $F{NOMBRES_APELLIDOS} : "______________________") + ", con C.C. " + ($F{CEDULA} != null && !$F{CEDULA}.isEmpty() ? $F{CEDULA} : "____________") + ", en mi calidad de Partícipe de ASOPREP-FCPC, solicito se apruebe el siguiente préstamo contra mis haberes, sujetándome a la Política de Crédito, instructivos y reglamentos vigentes. Expresamente autorizo a " + ($F{EMPLEADOR} != null && !$F{EMPLEADOR}.isEmpty() ? $F{EMPLEADOR} : "______________________") + " que, de mi remuneración en el Rol de Pagos, se descuenten las cuotas de conformidad con la tabla de amortización respectiva, a favor de ASOPREP-FCPC."]]></expression>
				<box leftPadding="0" rightPadding="0"/>
			</element>
			<element kind="staticText" uuid="a3000001-0000-0000-0000-000000000015" x="0" y="177" width="535" height="13" mode="Opaque" backcolor="#1F3864" forecolor="#FFFFFF" fontSize="9.0" bold="true" hTextAlign="Left" vTextAlign="Middle">
				<text><![CDATA[1. DATOS DEL PARTÍCIPE]]></text>
				<box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#000000"/></box>
			</element>
			<element kind="staticText" uuid="a3000001-0000-0000-0000-000000000016" x="0" y="190" width="112" height="14" mode="Opaque" backcolor="#E6E6E6" fontSize="8.0" bold="true" hTextAlign="Left" vTextAlign="Middle">
				<text><![CDATA[Apellidos y nombres]]></text>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box>
			</element>
			<element kind="textField" uuid="a3000001-0000-0000-0000-000000000017" x="112" y="190" width="423" height="14" fontSize="8.0" hTextAlign="Left" vTextAlign="Middle">
				<expression><![CDATA[($F{NOMBRES_APELLIDOS} != null && !$F{NOMBRES_APELLIDOS}.isEmpty() ? $F{NOMBRES_APELLIDOS} : "____________")]]></expression>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box>
			</element>
			<element kind="staticText" uuid="a3000001-0000-0000-0000-000000000018" x="0" y="204" width="112" height="14" mode="Opaque" backcolor="#E6E6E6" fontSize="8.0" bold="true" hTextAlign="Left" vTextAlign="Middle">
				<text><![CDATA[Cédula]]></text>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box>
			</element>
			<element kind="textField" uuid="a3000001-0000-0000-0000-000000000019" x="112" y="204" width="150" height="14" fontSize="8.0" hTextAlign="Left" vTextAlign="Middle">
				<expression><![CDATA[($F{CEDULA} != null && !$F{CEDULA}.isEmpty() ? $F{CEDULA} : "____________")]]></expression>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#000000"/></box>
			</element>
			<element kind="staticText" uuid="a3000001-0000-0000-0000-000000000020" x="262" y="204" width="130" height="14" mode="Opaque" backcolor="#E6E6E6" fontSize="8.0" bold="true" hTextAlign="Left" vTextAlign="Middle">
				<text><![CDATA[Código partícipe]]></text>
