			</element>
			<element kind="staticText" uuid="a3000001-0000-0000-0000-000000000082" x="0" y="501" width="112" height="14" mode="Opaque" backcolor="#E6E6E6" fontSize="8.0" bold="true" hTextAlign="Left" vTextAlign="Middle">
