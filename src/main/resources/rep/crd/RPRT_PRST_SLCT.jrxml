			</element>
			<element kind="staticText" uuid="a3000001-0000-0000-0000-000000000004" x="130" y="6" width="265" height="24" fontSize="15.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
				<text><![CDATA[ASOPREP - FCPC]]></text>
				<box leftPadding="3" rightPadding="3"/>
			</element>
			<element kind="staticText" uuid="a3000001-0000-0000-0000-000000000005" x="130" y="31" width="265" height="24" fontSize="15.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
