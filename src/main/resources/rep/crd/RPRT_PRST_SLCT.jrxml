	<field name="FECHA_SOLICITUD" class="java.sql.Timestamp"/>
	<field name="FECHA_APROBACION" class="java.sql.Timestamp"/>
	<field name="FECHA_DESEMBOLSO" class="java.sql.Timestamp"/>
	<field name="ID_ESTADO" class="java.math.BigDecimal"/>
	<field name="CODIGO_PARTICIPE" class="java.math.BigDecimal"/>
	<field name="NOMBRES_APELLIDOS" class="java.lang.String"/>
	<field name="CEDULA" class="java.lang.String"/>
	<field name="FECHA_NACIMIENTO" class="java.lang.String"/>
	<field name="ESTADO_CIVIL" class="java.lang.String"/>
	<field name="EMPLEADOR" class="java.lang.String"/>
	<field name="CONDICION" class="java.lang.String"/>
	<field name="CARGO" class="java.lang.String"/>
	<field name="FECHA_INGRESO" class="java.sql.Timestamp"/>
	<field name="DIRECCION" class="java.lang.String"/>
	<field name="TELEFONO" class="java.lang.String"/>
	<field name="CELULAR" class="java.lang.String"/>
	<field name="EMAIL" class="java.lang.String"/>
	<field name="TIPO_PRESTAMO" class="java.lang.String"/>
	<field name="TASA" class="java.math.BigDecimal"/>
	<field name="MONTO" class="java.math.BigDecimal"/>
	<field name="NRO_CUOTAS" class="java.math.BigDecimal"/>
	<field name="CUOTA_ESTIMADA" class="java.math.BigDecimal"/>
	<field name="DESTINO_CREDITO" class="java.lang.String"/>
	<field name="ID_ORIGINAL" class="java.math.BigDecimal"/>
	<field name="ES_NOVACION" class="java.math.BigDecimal"/>
	<field name="REESTRUCTURADO" class="java.math.BigDecimal"/>
	<field name="NRO_OP_ANTERIOR" class="java.math.BigDecimal"/>
	<field name="SALDO_CTA_INDIVIDUAL" class="java.math.BigDecimal"/>
	<field name="INGRESO_MENSUAL" class="java.math.BigDecimal"/>
	<field name="CAPACIDAD_PAGO" class="java.math.BigDecimal"/>
	<field name="SALDO_CREDITOS_VIGENTES" class="java.math.BigDecimal"/>
	<field name="DESCUENTOS" class="java.math.BigDecimal"/>
	<field name="CUOTAS_VIGENTES" class="java.math.BigDecimal"/>
	<field name="VALOR_LIQUIDO" class="java.math.BigDecimal"/>
	<field name="BANCO" class="java.lang.String"/>
	<field name="TIPO_CUENTA" class="java.lang.String"/>
	<field name="NRO_CUENTA" class="java.lang.String"/>
	<field name="NIVEL_APROBACION" class="java.lang.String"/>
	<field name="REVISADO_POR" class="java.lang.String"/>
	<field name="USUARIO_ELABORA" class="java.lang.String"/>
	<field name="APROBADOR" class="java.lang.String"/>

	<background splitType="Stretch"/>

	<detail>
		<band height="586" splitType="Stretch">
			<element kind="rectangle" uuid="a3000001-0000-0000-0000-000000000001" x="0" y="0" width="130" height="62" mode="Transparent">
				<pen lineWidth="0.75" lineColor="#000000"/>
			</element>
			<element kind="image" uuid="a3000001-0000-0000-0000-000000000002" x="4" y="4" width="122" height="54" scaleImage="RetainShape" onErrorType="Blank" hImageAlign="Center" vImageAlign="Middle">
				<expression><![CDATA[$P{P_IMAGEN}]]></expression>
			</element>
			<element kind="rectangle" uuid="a3000001-0000-0000-0000-000000000003" x="130" y="0" width="265" height="62" mode="Transparent">
