			<expression><![CDATA["ASOPREP-FCPC · Sistema de Administración de Aportes (SAA) · Liquidación crédito " + ($P{P_NUMERO_PRESTAMO} != null ? $P{P_NUMERO_PRESTAMO} : "") + ($P{P_USUARIO} != null ? (" · Emitido por " + $P{P_USUARIO}) : "")]]></expression>
