<jasperReport name="RPRT_ESCT_APRT" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection" uuid="3f6c1a20-77b1-4d6e-9a11-0c5b8e2d4401">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Oracle"/>
	<property name="com.jaspersoft.studio.report.description" value="Estado de cuenta de aportes: saldo por tipo de aporte vigente de un participe"/>
	<parameter name="P_ENTDCDGO" class="java.lang.Long">
		<description><![CDATA[Codigo de la entidad (participe)]]></description>
	</parameter>
	<parameter name="P_FECHA_CORTE" class="java.lang.String">
		<description><![CDATA[Fecha de corte en formato dd/MM/yyyy. Si no se envia se usa la fecha actual.]]></description>
	</parameter>
	<parameter name="P_IMAGEN" class="java.awt.Image">
		<description><![CDATA[Logo de ASOPREP. Lo inyecta ReporteServiceImpl si el frontend no lo envia.]]></description>
	</parameter>
	<parameter name="P_USUARIO" class="java.lang.String">
		<description><![CDATA[Usuario que genera el reporte]]></description>
	</parameter>
	<query language="SQL"><![CDATA[SELECT
    TRIM(E.ENTDNMID)         AS IDENTIFICACION,
    TRIM(E.ENTDRZNS)         AS NOMBRE,
    T.TPAPCDGO               AS CODIGO_TIPO_APORTE,
    TRIM(T.TPAPNMBR)         AS TIPO_APORTE,
    SUM(A.APRTVLRR)          AS SALDO,
    TRUNC(MAX(A.APRTFCTR))   AS FECHA_ULTIMO_MOVIMIENTO,
    COUNT(A.APRTCDGO)        AS NUMERO_MOVIMIENTOS

FROM CRD.APRT A
     INNER JOIN CRD.TPAP T ON T.TPAPCDGO = A.TPAPCDGO
     INNER JOIN CRD.ENTD E ON E.ENTDCDGO = A.ENTDCDGO

WHERE A.ENTDCDGO = $P{P_ENTDCDGO}
  AND T.TPAPIDST = 1
  AND A.APRTFCTR < NVL(TO_DATE($P{P_FECHA_CORTE}, 'DD/MM/YYYY'), TRUNC(SYSDATE)) + 1

GROUP BY E.ENTDNMID, E.ENTDRZNS, T.TPAPCDGO, T.TPAPNMBR
HAVING SUM(A.APRTVLRR) > 0
ORDER BY TRIM(T.TPAPNMBR)]]></query>
