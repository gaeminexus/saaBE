			<expression><![CDATA["Quito, " + new java.text.SimpleDateFormat("d 'de' MMMM 'de' yyyy", new java.util.Locale("es", "EC")).format($F{FECHA_DEVOLUCION})]]></expression>
		</element>
		<element kind="staticText" uuid="d4000000-0000-0000-0000-000000000203" x="0" y="38" width="515" height="22" fontName="Tahoma" fontSize="13.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
			<text><![CDATA[INFORME DE NECESIDAD DE PAGO]]></text>
