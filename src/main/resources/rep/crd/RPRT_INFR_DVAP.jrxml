<!-- Informe de necesidad de pago (devolucion individual de aportes). Diseno: docs/logica-negocio/crd/ESPECIFICACION-INFORME-NECESIDAD-PAGO-DEVOLUCION.md. Textos fijos transcritos del Anexo A de ese documento (adaptados al singular, supuesto del arbitro pendiente de validar con el usuario). Contrato: docs/logica-negocio/crd/API-INFORME-NECESIDAD-PAGO.md. -->
<!-- Query: una sola, UNION ALL con discriminador SECCION (1=lo que se devuelve, 2=aportes aplicados a prestamos, 3=deuda vigente). Nunca SELECT *: columnas explicitas. No se proyecta TPAPCDGO de CRD.DDVA ni de CRD.TPAP (el join va por el ON; el codigo no se imprime), asi que no hay colision de nombre que resolver con alias; ver Anexo B de la especificacion. Seccion 3 decodifica PRSTIDST con un CASE literal contra com.saa.rubros.EstadoPrestamo (no se usa CRD.ESPS: esa es la FK al catalogo, no el estado operativo; CLAUDE.md, "que columna lleva realmente el estado"). -->
<jasperReport name="RPRT_INFR_DVAP" language="java" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="40" bottomMargin="40" whenNoDataType="AllSectionsNoDetail" uuid="d4000000-0000-0000-0000-000000000000">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Oracle"/>
	<property name="com.jaspersoft.studio.report.description" value="Informe de necesidad de pago por devolucion individual de aportes"/>
	<parameter name="P_ID_DEVOLUCION" class="java.lang.Long">
		<description><![CDATA[Codigo de la devolucion (CRD.DVAP.DVAPCDGO)]]></description>
	</parameter>
	<parameter name="P_NUMERO_INFORME" class="java.lang.String">
		<description><![CDATA[Numero de informe, lo digita el operador. Ej: FCPC-CRE-GR-137-2026]]></description>
	</parameter>
	<parameter name="P_OBSERVACIONES" class="java.lang.String">
		<description><![CDATA[Observaciones, lo digita el operador. Puede venir vacio: la seccion se colapsa sin dejar hueco.]]></description>
	</parameter>
	<parameter name="P_FECHA_DESDE" class="java.sql.Date">
		<description><![CDATA[Corte del bloque de aportes aplicados a prestamos. Se precarga con el 1 de enero del anio de la devolucion.]]></description>
	</parameter>
	<query language="SQL"><![CDATA[SELECT
    1 AS SECCION,
    ROW_NUMBER() OVER (ORDER BY d.DDVACDGO) AS ORDEN,
    t.TPAPNMBR AS CONCEPTO,
    CAST(NULL AS VARCHAR2(300)) AS DETALLE,
    d.DDVAVLRR AS VALOR,
    (SELECT e.ENTDNMID FROM CRD.ENTD e JOIN CRD.DVAP v ON v.ENTDCDGO = e.ENTDCDGO WHERE v.DVAPCDGO = $P{P_ID_DEVOLUCION}) AS CEDULA,
    (SELECT e.ENTDRZNS FROM CRD.ENTD e JOIN CRD.DVAP v ON v.ENTDCDGO = e.ENTDCDGO WHERE v.DVAPCDGO = $P{P_ID_DEVOLUCION}) AS NOMBRES,
    (SELECT v.DVAPFCHA FROM CRD.DVAP v WHERE v.DVAPCDGO = $P{P_ID_DEVOLUCION}) AS FECHA_DEVOLUCION,
    (SELECT NVL(v.DVAPFCPG, v.DVAPFCHA) FROM CRD.DVAP v WHERE v.DVAPCDGO = $P{P_ID_DEVOLUCION}) AS FECHA_COMPROMISO,
    (SELECT v.DVAPVLRR FROM CRD.DVAP v WHERE v.DVAPCDGO = $P{P_ID_DEVOLUCION}) AS TOTAL_DEVUELTO
FROM CRD.DDVA d
JOIN CRD.TPAP t ON t.TPAPCDGO = d.TPAPCDGO
WHERE d.DVAPCDGO = $P{P_ID_DEVOLUCION}

UNION ALL

SELECT
    2 AS SECCION,
    ROW_NUMBER() OVER (ORDER BY a.APRTFCTR) AS ORDEN,
    ta.TPAPNMBR AS CONCEPTO,
    TO_CHAR(a.APRTFCTR, 'DD/MM/YYYY') || ' - ' || a.APRTGLSA AS DETALLE,
    -- APRTVLRR viene negativo para APRTTPMV=4 (ProcesoPagoPrestamoServiceImpl.consumirAportes): consume saldo.
    -- El signo lo da el encabezado del bloque, no el numero.
    ABS(a.APRTVLRR) AS VALOR,
    (SELECT e.ENTDNMID FROM CRD.ENTD e JOIN CRD.DVAP v ON v.ENTDCDGO = e.ENTDCDGO WHERE v.DVAPCDGO = $P{P_ID_DEVOLUCION}) AS CEDULA,
    (SELECT e.ENTDRZNS FROM CRD.ENTD e JOIN CRD.DVAP v ON v.ENTDCDGO = e.ENTDCDGO WHERE v.DVAPCDGO = $P{P_ID_DEVOLUCION}) AS NOMBRES,
    (SELECT v.DVAPFCHA FROM CRD.DVAP v WHERE v.DVAPCDGO = $P{P_ID_DEVOLUCION}) AS FECHA_DEVOLUCION,
    (SELECT NVL(v.DVAPFCPG, v.DVAPFCHA) FROM CRD.DVAP v WHERE v.DVAPCDGO = $P{P_ID_DEVOLUCION}) AS FECHA_COMPROMISO,
    (SELECT v.DVAPVLRR FROM CRD.DVAP v WHERE v.DVAPCDGO = $P{P_ID_DEVOLUCION}) AS TOTAL_DEVUELTO
FROM CRD.APRT a
JOIN CRD.TPAP ta ON ta.TPAPCDGO = a.TPAPCDGO
WHERE a.ENTDCDGO = (SELECT v.ENTDCDGO FROM CRD.DVAP v WHERE v.DVAPCDGO = $P{P_ID_DEVOLUCION})
  AND a.APRTTPMV = 4
  AND a.APRTFCTR >= $P{P_FECHA_DESDE}
  AND a.APRTFCTR < (SELECT v.DVAPFCHA FROM CRD.DVAP v WHERE v.DVAPCDGO = $P{P_ID_DEVOLUCION}) + 1

UNION ALL

SELECT
    3 AS SECCION,
    ROW_NUMBER() OVER (ORDER BY p.PRSTCDGO) AS ORDEN,
    'Préstamo No. ' || TO_CHAR(p.PRSTCDGO) AS CONCEPTO,
    CASE p.PRSTIDST
        WHEN 1  THEN 'Generado'
        WHEN 2  THEN 'Vigente'
        WHEN 6  THEN 'Pendiente de aprobación'
        WHEN 7  THEN 'Rechazado'
        WHEN 8  THEN 'De plazo vencido'
        WHEN 9  THEN 'Cancelado por revisar'
        WHEN 10 THEN 'Vigente por revisar'
        WHEN 11 THEN 'En mora'
        ELSE 'Estado ' || NVL(TO_CHAR(p.PRSTIDST), 'no registrado')
    END AS DETALLE,
    NVL((SELECT SUM(dt.DTPRSLDO) FROM CRD.DTPR dt WHERE dt.PRSTCDGO = p.PRSTCDGO), 0) AS VALOR,
    (SELECT e.ENTDNMID FROM CRD.ENTD e JOIN CRD.DVAP v ON v.ENTDCDGO = e.ENTDCDGO WHERE v.DVAPCDGO = $P{P_ID_DEVOLUCION}) AS CEDULA,
    (SELECT e.ENTDRZNS FROM CRD.ENTD e JOIN CRD.DVAP v ON v.ENTDCDGO = e.ENTDCDGO WHERE v.DVAPCDGO = $P{P_ID_DEVOLUCION}) AS NOMBRES,
    (SELECT v.DVAPFCHA FROM CRD.DVAP v WHERE v.DVAPCDGO = $P{P_ID_DEVOLUCION}) AS FECHA_DEVOLUCION,
    (SELECT NVL(v.DVAPFCPG, v.DVAPFCHA) FROM CRD.DVAP v WHERE v.DVAPCDGO = $P{P_ID_DEVOLUCION}) AS FECHA_COMPROMISO,
    (SELECT v.DVAPVLRR FROM CRD.DVAP v WHERE v.DVAPCDGO = $P{P_ID_DEVOLUCION}) AS TOTAL_DEVUELTO
FROM CRD.PRST p
WHERE p.ENTDCDGO = (SELECT v.ENTDCDGO FROM CRD.DVAP v WHERE v.DVAPCDGO = $P{P_ID_DEVOLUCION})
  AND (p.PRSTIDST IS NULL OR p.PRSTIDST NOT IN (3,4,5))

ORDER BY 1, 2]]></query>
	<field name="SECCION" class="java.math.BigDecimal"/>
	<field name="ORDEN" class="java.math.BigDecimal"/>
	<field name="CONCEPTO" class="java.lang.String"/>
	<field name="DETALLE" class="java.lang.String"/>
	<field name="VALOR" class="java.math.BigDecimal"/>
	<field name="CEDULA" class="java.lang.String"/>
	<field name="NOMBRES" class="java.lang.String"/>
	<field name="FECHA_DEVOLUCION" class="java.sql.Date"/>
	<field name="FECHA_COMPROMISO" class="java.sql.Date"/>
	<field name="TOTAL_DEVUELTO" class="java.math.BigDecimal"/>
	<variable name="V_SUBTOTAL_SECCION" calculation="Sum" class="java.math.BigDecimal" resetType="Group" resetGroup="G_SECCION">
		<expression><![CDATA[$F{VALOR} != null ? $F{VALOR} : java.math.BigDecimal.ZERO]]></expression>
	</variable>
	<group name="G_SECCION">
		<expression><![CDATA[$F{SECCION}]]></expression>
		<groupHeader>
			<band height="34" splitType="Stretch">
				<element kind="textField" uuid="d4000000-0000-0000-0000-000000000102" mode="Opaque" x="0" y="0" width="515" height="14" backcolor="#D1D1D1" fontName="Tahoma" fontSize="8.5" bold="true" hTextAlign="Left" vTextAlign="Middle">
					<expression><![CDATA[$F{SECCION}.intValue() == 1
    ? "1. LO QUE SE DEVUELVE (por tipo de aporte)"
    : ($F{SECCION}.intValue() == 2
        ? "2. APORTES YA APLICADOS A PRÉSTAMOS (histórico de cruces desde " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{P_FECHA_DESDE}) + " — no es una deducción de esta devolución)"
        : "3. DEUDA VIGENTE A LA FECHA DE EMISIÓN")]]></expression>
					<box leftPadding="4"/>
				</element>
				<element kind="staticText" uuid="d4000000-0000-0000-0000-000000000103" mode="Opaque" x="0" y="16" width="230" height="16" backcolor="#EEEEEE" fontName="Tahoma" fontSize="7.5" bold="true" hTextAlign="Left" vTextAlign="Middle">
					<text><![CDATA[CONCEPTO]]></text>
					<box leftPadding="4"><pen lineWidth="0.25"/></box>
				</element>
				<element kind="staticText" uuid="d4000000-0000-0000-0000-000000000104" mode="Opaque" x="230" y="16" width="185" height="16" backcolor="#EEEEEE" fontName="Tahoma" fontSize="7.5" bold="true" hTextAlign="Left" vTextAlign="Middle">
					<text><![CDATA[DETALLE]]></text>
					<box leftPadding="4"><pen lineWidth="0.25"/></box>
				</element>
				<element kind="staticText" uuid="d4000000-0000-0000-0000-000000000105" mode="Opaque" x="415" y="16" width="100" height="16" backcolor="#EEEEEE" fontName="Tahoma" fontSize="7.5" bold="true" hTextAlign="Right" vTextAlign="Middle">
					<text><![CDATA[VALOR (USD)]]></text>
					<box rightPadding="6"><pen lineWidth="0.25"/></box>
				</element>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="30" splitType="Stretch">
				<element kind="staticText" uuid="d4000000-0000-0000-0000-000000000111" x="0" y="0" width="415" height="14" fontName="Tahoma" fontSize="7.5" bold="true" hTextAlign="Right" vTextAlign="Middle">
					<text><![CDATA[Subtotal de la sección]]></text>
					<box rightPadding="6"/>
				</element>
				<element kind="textField" uuid="d4000000-0000-0000-0000-000000000112" x="415" y="0" width="100" height="14" fontName="Tahoma" fontSize="7.5" bold="true" pattern="#,##0.00" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true">
					<expression><![CDATA[$V{V_SUBTOTAL_SECCION}]]></expression>
					<box rightPadding="6"/>
				</element>
				<element kind="staticText" uuid="d4000000-0000-0000-0000-000000000113" x="0" y="14" width="515" height="14" fontName="Tahoma" fontSize="7.0" italic="true" hTextAlign="Left" vTextAlign="Middle" printWhenExpression="$F{SECCION}.intValue() == 3">
					<text><![CDATA[Saldos referenciales a la fecha de emisión.]]></text>
				</element>
				<element kind="staticText" uuid="d4000000-0000-0000-0000-000000000114" x="0" y="14" width="515" height="14" fontName="Tahoma" fontSize="7.0" italic="true" hTextAlign="Left" vTextAlign="Middle" printWhenExpression="$F{SECCION}.intValue() == 2">
					<text><![CDATA[Incluye los cruces registrados en el período consultado. Un cruce posteriormente reversado se lista igual.]]></text>
				</element>
			</band>
		</groupFooter>
	</group>
