			<element kind="staticText" uuid="f1000001-0000-0000-0000-000000000362" positionType="Float" x="0" y="476" width="260" height="13" fontName="Tahoma" fontSize="8.5"><text><![CDATA[Dividendo mensual:]]></text></element>
			<element kind="textField" uuid="f1000001-0000-0000-0000-000000000363" positionType="Float" x="260" y="476" width="255" height="13" fontName="Tahoma" fontSize="8.5" hTextAlign="Right" pattern="#,##0.00"><expression><![CDATA[$P{P_DIVIDENDO_MENSUAL}]]></expression></element>

