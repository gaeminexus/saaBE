	</parameter>
	<parameter name="P_USUARIO" class="java.lang.String"/>
	<parameter name="P_TOTAL_GENERAL" class="java.lang.Double">
		<description><![CDATA[Informativo: el total que se muestra en el reporte es la SUMA de las filas del detalle, no este parametro — para que encabezado y pie sean el mismo numero por construccion.]]></description>
	</parameter>
	<parameter name="P_CANTIDAD_PRESTAMOS" class="java.lang.Integer">
		<description><![CDATA[Cantidad de prestamos incluidos — pasado por Java (datos.getLineas().size()), no evaluado en tiempo de reporte para no depender del orden de evaluacion de bandas.]]></description>
	</parameter>
	<parameter name="P_TOTAL_APORTES_FAVOR" class="java.lang.Double">
		<description><![CDATA[Informativo, igual criterio que P_TOTAL_GENERAL: el total que se muestra es la suma de las filas APORTE_FAVOR del detalle, no este parametro.]]></description>
	</parameter>
	<parameter name="P_TOTAL_APORTES_CONSUMIDOS" class="java.lang.Double">
		<description><![CDATA[Informativo, igual criterio que P_TOTAL_GENERAL: el total que se muestra es la suma de las filas APORTE_CONSUMIDO del detalle, no este parametro.]]></description>
	</parameter>
