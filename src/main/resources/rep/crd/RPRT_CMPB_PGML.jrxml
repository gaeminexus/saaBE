	<field name="interes" class="java.lang.Double"/>
	<field name="mora" class="java.lang.Double"/>
	<field name="desgravamen" class="java.lang.Double"/>
	<field name="seguroIncendio" class="java.lang.Double"/>
	<field name="total" class="java.lang.Double"/>
	<variable name="V_TOTAL_CAPITAL" class="java.lang.Double" calculation="Sum">
		<expression><![CDATA[$F{capital} != null ? $F{capital} : 0.0]]></expression>
	</variable>
	<variable name="V_TOTAL_INTERES" class="java.lang.Double" calculation="Sum">
		<expression><![CDATA[$F{interes} != null ? $F{interes} : 0.0]]></expression>
	</variable>
	<variable name="V_TOTAL_MORA" class="java.lang.Double" calculation="Sum">
