	</variable>
	<variable name="V_TOTAL_SEGURO" class="java.lang.Double" calculation="Sum">
		<expression><![CDATA[$F{seguroIncendio} != null ? $F{seguroIncendio} : 0.0]]></expression>
	</variable>
	<!-- Solo lineas PRESTAMO: nunca sumar con aportes (2026-08-30) — son otra direccion del
	     dinero, o directamente otra cosa (bajar deuda vs. registrar/consumir un aporte). -->
	<variable name="V_TOTAL_GENERAL" class="java.lang.Double" calculation="Sum">
		<expression><![CDATA["PRESTAMO".equals($F{tipoLinea}) && $F{total} != null ? $F{total} : 0.0]]></expression>
	</variable>
	<variable name="V_TOTAL_APORTES_FAVOR" class="java.lang.Double" calculation="Sum">
		<expression><![CDATA["APORTE_FAVOR".equals($F{tipoLinea}) && $F{total} != null ? $F{total} : 0.0]]></expression>
	</variable>
	<variable name="V_TOTAL_APORTES_CONSUMIDO" class="java.lang.Double" calculation="Sum">
		<expression><![CDATA["APORTE_CONSUMIDO".equals($F{tipoLinea}) && $F{total} != null ? $F{total} : 0.0]]></expression>
	</variable>
	<variable name="V_COUNT_PRESTAMO" class="java.lang.Integer" calculation="Sum">
		<expression><![CDATA["PRESTAMO".equals($F{tipoLinea}) ? 1 : 0]]></expression>
	</variable>
