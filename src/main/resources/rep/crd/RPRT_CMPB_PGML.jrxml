<!-- Comprobante de COBRO MÚLTIPLE (CRD): un solo documento para los N préstamos pagados en la
     misma operación. Sin <query>: el detalle viene por JRBeanCollectionDataSource sobre
     LineaComprobantePagoMultiple, ya reconstruida por ProcesoPagoPrestamoServiceImpl desde
     CRD.EVPR/CRD.PGPR (nunca datos que hubiera mandado el cliente). Compilar el .jasper con
     Jaspersoft Studio 7.0.3 y commitear ambos. -->
<jasperReport name="RPRT_CMPB_PGML" language="java" columnCount="1" printOrder="Horizontal" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c9d00000-0000-0000-0000-000000000001">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
	<property name="com.jaspersoft.studio.report.description" value="Comprobante de cobro multiple (N prestamos en una operacion). Detalle por JavaBean, sin query."/>
	<parameter name="P_IMAGEN" class="java.awt.Image">
		<description><![CDATA[Logo. Lo inyecta ReporteServiceImpl si el frontend no lo envia.]]></description>
	</parameter>
	<parameter name="P_NOMBRE_SOCIO" class="java.lang.String"/>
	<parameter name="P_IDENTIFICACION_SOCIO" class="java.lang.String"/>
