	<parameter name="P_GERENTE_NOMBRE" class="java.lang.String"><description><![CDATA[Firma de ASOPREP: nombre y cargo en UN solo lugar]]></description><defaultValueExpression><![CDATA["Eco. Leonardo Ramírez"]]></defaultValueExpression></parameter>
	<parameter name="P_GERENTE_CARGO" class="java.lang.String"><defaultValueExpression><![CDATA["GERENTE"]]></defaultValueExpression></parameter>
