			<element kind="textField" uuid="c0de0001-0000-0000-0000-000000000024" x="130" y="48" width="160" height="18" fontSize="10" hTextAlign="Center" vTextAlign="Middle"><box><pen lineWidth="0.5" lineColor="#000000"/></box><expression><![CDATA[$P{P_JUB_MINIMO}]]></expression></element>
			<element kind="textField" uuid="c0de0001-0000-0000-0000-000000000025" x="290" y="48" width="135" height="18" fontSize="10" hTextAlign="Center" vTextAlign="Middle"><box><pen lineWidth="0.5" lineColor="#000000"/></box><expression><![CDATA[$P{P_JUB_ADICIONAL}]]></expression></element>
		</band>
		<band height="76" splitType="Prevent"><printWhenExpression><![CDATA[$P{P_OPCION} != null && $P{P_OPCION}.intValue() == 2]]></printWhenExpression>
			<element kind="staticText" uuid="c0de0001-0000-0000-0000-000000000026" x="0" y="0" width="425" height="14" fontSize="10" hTextAlign="Justified"><text><![CDATA[Opción 2: Prestación de Cesantía]]></text></element>
			<element kind="staticText" uuid="c0de0001-0000-0000-0000-000000000027" x="0" y="18" width="130" height="30" fontSize="10" hTextAlign="Center" vTextAlign="Middle"><box><pen lineWidth="0.5" lineColor="#000000"/></box><text><![CDATA[PRESTACIÓN]]></text></element>
