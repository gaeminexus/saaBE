			<element kind="textField" uuid="c0de0001-0000-0000-0000-000000000031" x="130" y="48" width="160" height="18" fontSize="10" hTextAlign="Center" vTextAlign="Middle"><box><pen lineWidth="0.5" lineColor="#000000"/></box><expression><![CDATA[$P{P_CES_MINIMO}]]></expression></element>
