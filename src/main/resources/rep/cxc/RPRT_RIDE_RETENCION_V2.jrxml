<!-- Created with Jaspersoft Studio version 7.0.3.final using JasperReports Library version 7.0.3-41034ca841d452f3305ba55b9042260aaa1ab5dd  -->
<jasperReport name="RPRT_RIDE_RETENCION_V2" language="java" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" uuid="e3c4d5f6-a7b8-9012-cdef-345678901abc">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Oracle"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="P_ID_RETENCION_V2" class="java.lang.Long">
		<defaultValueExpression><![CDATA[0L]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[
		SELECT
		    r.CLAVE                                                              AS clave,
		    r.NUMERO                                                             AS numeroRetencion,
		    COALESCE(r.AUTORIZACION, r.CLAVE)                                   AS numeroAutorizacion,
		    TO_CHAR(r.FECHA,              'DD/MM/YYYY')                          AS fechaEmision,
		    TO_CHAR(r.FECHAAUTORIZACION,  'DD/MM/YYYY HH24:MI:SS')               AS fechaAutorizacion,
		    CASE WHEN r.AMBIENTE = 2 THEN 'PRODUCCIÓN' ELSE 'PRUEBAS' END       AS ambiente,
		    COALESCE(r.PERIODOFISCAL,  '')                                       AS periodoFiscal,
		    COALESCE(r.OBSERVACION,    '')                                       AS observacion,
		    COALESCE(fd.NUMDOC,                '')                               AS rucFacturador,
		    COALESCE(fd.RAZONSOCIAL,           '')                               AS razonSocial,
		    COALESCE(fd.NOMBRECOMERCIAL,       '')                               AS nombreComercial,
		    COALESCE(fd.DIRECCION,             '')                               AS direccionFcdr,
		    COALESCE(fd.TELEFONO,              '')                               AS telefonoFcdr,
		    COALESCE(fd.MAIL,                  '')                               AS emailFcdr,
		    CASE WHEN fd.CONTABILIDAD    = 1 THEN 'SI' ELSE 'NO' END            AS obligadoContabilidad,
		    COALESCE(fd.AGENTERETENCION,       '')                               AS agenteRetencion,
		    COALESCE(fd.CONTRIBUYENTEESPECIAL, '')                               AS contribuyenteEspecial,
		    CASE
		        WHEN fd.RIMPE        = 1 THEN 'CONTRIBUYENTE RÉGIMEN RIMPE'
		        WHEN fd.POPULARRIMPE = 1 THEN 'CONTRIBUYENTE NEGOCIO POPULAR - RÉGIMEN RIMPE'
		        WHEN fd.MICROEMPRESA = 1 THEN 'CONTRIBUYENTE RÉGIMEN MICROEMPRESAS'
		        ELSE ''
		    END                                                                  AS tipoEmpresa,
		    COALESCE(t.TTLRNMBR,  '')                                            AS nombreProveedor,
		     COALESCE(t.TTLRRZSC,  '')                                            AS razonSocialProveedor,
		    COALESCE(t.TTLRIDNT,  '')                                            AS identificacionProveedor,
		    COALESCE(t.TTLRMLLL,  '')                                            AS emailProveedor,
		    COALESCE(t.TTLRTLFN,  '')                                            AS telefonoProveedor,
		    COALESCE(t.TTLRDRCC,  '')                                            AS direccionProveedor,
		    COALESCE(e.DIRECCION,  '')                                           AS dirEstablecimiento,
		    COALESCE(d.TIPODOCRETEN,        '')                                  AS tipoDocReten,
		    COALESCE(d.NUMDOCRETEN,         '')                                  AS numDocReten,
		    TO_CHAR(d.FECHAEMIDOC,          'DD/MM/YYYY')                        AS fechaEmiDoc,
		    COALESCE(d.DOCRESTSINIMPUESTOS,  0)                                  AS totalSinImpuestos,
		    COALESCE(d.DOCRESTOTAL,          0)                                  AS importeTotal,
		    COALESCE(d.CODIMPUESTO,    '')                                       AS codImpuesto,
		    COALESCE(d.CODRETENCION,   '')                                       AS codRetencion,
		    COALESCE(d.BASEIMPONIBLE,   0)                                       AS baseImponible,
		    COALESCE(d.PORCENTAJERETEN, 0)                                       AS porcentajeReten,
		    COALESCE(d.VALORRETEN,      0)                                       AS valorReten
		FROM      CBR.RTV2  r
		JOIN      CBR.FCDR  fd ON fd.ID        = r.FACTURADOR
		LEFT JOIN TSR.TTLR  t  ON t.TTLRCDGO   = r.PROVEEDOR
		LEFT JOIN CBR.PTEM  pt ON pt.ID         = r.PTOEMISION
		LEFT JOIN CBR.ESTB  e  ON e.ID          = pt.ESTABLECIMIENTO
		LEFT JOIN CBR.DRV2  d  ON d.RETENCIONV2 = r.ID AND d.ESTADO = 1
		WHERE r.ID = $P{P_ID_RETENCION_V2}
		ORDER BY d.NUMDOCRETEN, d.ID
	]]></query>
