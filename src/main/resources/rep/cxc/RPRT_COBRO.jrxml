<?xml version="1.0" encoding="UTF-8"?>
<!-- Comprobante de UN cobro (CXC), para imprimir o mandar al cliente. Ver
     docs/logica-negocio/cxc/PLAN-SEGUIMIENTO-COBROS.md §1.3 y
     docs/logica-negocio/cxc/API-SEGUIMIENTO-COBROS.md §2.

     DISEÑO: sin <query>. Todo el contenido sale de parámetros que
     AplicacionPagoCxcServiceImpl.generarComprobante ya resuelve en Java (empresa,
     cliente, documento afectado, asiento) — el mismo criterio que el RIDE de
     factura (FacturaServiceImpl:2215): sin query no hay SELECT * ni COLUMN_n que
     se desalinee con un ALTER TABLE futuro (CLAUDE.md, caso RPRT_MVMN_APXT). Un
     reporte sin <query> se llena con exactamente UNA fila virtual (lo usa también
     VerificarFill.java con JREmptyDataSource()), así que todo el contenido va en
     el <title>, que imprime una sola vez.

     Sintaxis COMPACTA (<element kind="...">, sin xmlns) — la única que este repo
     puede recompilar (CLAUDE.md, "Reportes"). Estilos con nombre a nivel de
     reporte, nunca anónimos dentro de un <element> (el compilador no valida esa
     referencia; revienta recién al llenar — CLAUDE.md, incidente RPRT_CNCL_CNTA). -->
<jasperReport name="RPRT_COBRO" language="java" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" uuid="b3b64a6e-0760-debf-af46-d9a717648d14">

	<style name="Reversado" mode="Opaque" backcolor="#FFC7CE"/>
	<style name="EncabezadoSeccion" mode="Opaque" backcolor="#D1D1D1" fontName="Tahoma" fontSize="8.5" bold="true" hTextAlign="Left" vTextAlign="Middle"/>
	<style name="Etiqueta" fontName="Tahoma" fontSize="8.5" bold="true" vTextAlign="Middle"/>
	<style name="Valor" fontName="Tahoma" fontSize="8.5" vTextAlign="Middle"/>
	<!-- Color condicional del estado: JasperReports no admite una expresión dinámica en el
	     atributo forecolor de <element>, solo en un <conditionalStyle> con nombre a nivel de
	     reporte (misma regla del comentario de cabecera — nada de estilos anónimos). -->
	<style name="EstadoTexto" fontName="Tahoma" fontSize="8.5" bold="true" forecolor="#000000" vTextAlign="Middle">
		<conditionalStyle>
			<conditionExpression><![CDATA["REVERSADO".equals($P{P_ESTADO})]]></conditionExpression>
			<style forecolor="#C00000"/>
		</conditionalStyle>
	</style>

	<parameter name="P_EMPRESA" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="P_NUMERO_COBRO" class="java.lang.Long">
		<defaultValueExpression><![CDATA[0L]]></defaultValueExpression>
	</parameter>
	<parameter name="P_FECHA" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="P_CLIENTE_IDENT" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="P_CLIENTE_NOMBRE" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="P_FORMA_PAGO" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="P_VALOR" class="java.lang.Double">
		<defaultValueExpression><![CDATA[0.0]]></defaultValueExpression>
	</parameter>
	<parameter name="P_ESTADO" class="java.lang.String">
		<defaultValueExpression><![CDATA["ACTIVO"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_DOC_TIPO" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="P_DOC_NUMERO" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="P_OBSERVACION" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="P_ASIENTO_NUMERO" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="P_ASIENTO_FECHA" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>

	<background splitType="Stretch"/>

	<!-- ═══ TITLE — todo el comprobante: imprime una sola vez, no hay <query> ═══ -->
	<title height="312" splitType="Stretch">

		<element kind="textField" uuid="4f9c91ec-3f3a-2a42-0223-4d6074df40bf"
				x="0" y="0" width="535" height="18" fontName="Tahoma" fontSize="12.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
			<expression><![CDATA[$P{P_EMPRESA}]]></expression>
		</element>
		<element kind="staticText" uuid="36c8883a-a69f-6edb-e9b6-15dcd72f507e"
				x="0" y="18" width="535" height="20" fontName="Tahoma" fontSize="14.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
			<text><![CDATA[COMPROBANTE DE COBRO]]></text>
		</element>

		<element kind="textField" uuid="b243788a-6373-e23a-41de-a69ba4d95101"
				x="0" y="40" width="267" height="13" fontName="Tahoma" fontSize="9.0" bold="true" vTextAlign="Middle">
			<expression><![CDATA["Nº: " + $P{P_NUMERO_COBRO}]]></expression>
		</element>
		<element kind="textField" uuid="c800d926-9f3a-a365-1a92-eb2d9a28b038"
