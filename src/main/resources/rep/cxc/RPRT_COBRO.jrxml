				x="100" y="113" width="435" height="13" blankWhenNull="true">
			<expression><![CDATA[$P{P_CLIENTE_NOMBRE}]]></expression>
		</element>

		<!-- 2. EL COBRO -->
		<element kind="staticText" uuid="e8c18f92-e88d-8402-0fea-f445f5270840" style="EncabezadoSeccion"
