		<element kind="textField" uuid="e2ad18ee-c527-75ce-5b78-ffca446fe5f9" style="Valor"
				x="0" y="287" width="535" height="13" blankWhenNull="true">
			<expression><![CDATA[($P{P_ASIENTO_NUMERO} == null || $P{P_ASIENTO_NUMERO}.trim().isEmpty())
    ? "Sin contabilizar"
    : ("Nº " + $P{P_ASIENTO_NUMERO} + "   ·   Fecha: " + $P{P_ASIENTO_FECHA})]]></expression>
		</element>
