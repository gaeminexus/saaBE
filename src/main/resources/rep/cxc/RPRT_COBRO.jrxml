			<expression><![CDATA["Fecha: " + $P{P_FECHA}]]></expression>
		</element>

		<element kind="line" uuid="f25c1431-5344-2176-06b0-17de55faa053" x="0" y="56" width="535" height="1"/>

		<!-- Aviso de reversado (criterio §2.2.1: tiene que decirlo de forma visible) -->
		<element kind="staticText" uuid="a6a26d31-5704-4ab6-219a-3c65a95816c2" style="Reversado"
				x="0" y="62" width="535" height="16" forecolor="#C00000" fontName="Tahoma" fontSize="10.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
			<printWhenExpression><![CDATA["REVERSADO".equals($P{P_ESTADO})]]></printWhenExpression>
			<text><![CDATA[*** ESTE COBRO FUE REVERSADO / ANULADO ***]]></text>
