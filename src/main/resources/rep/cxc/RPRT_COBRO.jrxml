				x="0" y="214" width="535" height="13">
			<printWhenExpression><![CDATA[$P{P_OBSERVACION} != null && !$P{P_OBSERVACION}.trim().isEmpty()]]></printWhenExpression>
			<box leftPadding="5"/>
			<text><![CDATA[OBSERVACIONES]]></text>
		</element>
		<element kind="textField" uuid="267f20af-9930-4268-d7fd-60cb2161aff7" style="Valor"
				x="0" y="229" width="535" height="36" vTextAlign="Top">
			<printWhenExpression><![CDATA[$P{P_OBSERVACION} != null && !$P{P_OBSERVACION}.trim().isEmpty()]]></printWhenExpression>
			<expression><![CDATA[$P{P_OBSERVACION}]]></expression>
			<box leftPadding="2" topPadding="2"/>
		</element>

		<!-- 5. ASIENTO CONTABLE — sin asiento, dice "Sin contabilizar" (criterio §2.2.3) -->
		<element kind="staticText" uuid="a2fa4350-fe3a-47d0-1a57-f8031325d0d6" style="EncabezadoSeccion"
				x="0" y="272" width="535" height="13">
			<box leftPadding="5"/>
